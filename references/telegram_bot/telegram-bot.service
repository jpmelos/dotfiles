[Unit]
Description=Telegram bot for interactive tasks
Documentation=file:%h/devel/dotfiles/references/telegram_bot/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
# uv must be on PATH: the script runs through `uv run --script`.
# Adjust the first entry to your uv install location.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Holds TELEGRAM_BOT_TOKEN and optional overrides. Mode 600. A missing
# file fails the start, so a missing token is visible instead of looping.
EnvironmentFile=%h/.config/telegram-bot/env
# Only one process can poll one bot token. Point --tasks-dir at the
# directory with your <name>.py task files. An alternative line for the
# dotfiles checkout is commented below.
ExecStart=%h/bin/telegram_bot --tasks-dir=%h/telegram_tasks
# ExecStart=%h/bin/telegram_bot --tasks-dir=%h/devel/dotfiles/telegram_tasks
Restart=always
RestartSec=10
# SIGTERM stops the running task gracefully, including its shutdown hook.
TimeoutStopSec=125
UMask=0077
SyslogIdentifier=telegram-bot
# Hardening that stays out of the way of Chromium, which agent-browser
# drives. No syscall or namespace filters: the browser sandbox needs them.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
