[Unit]
Description=Telegram bot for interactive tasks
Documentation=file:/home/jpmelos/devel/dotfiles/references/telegram_bot/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jpmelos
# Paths are hardcoded: in a system unit %h expands to /root and ignores
# User=. Do not switch these back to %h.
WorkingDirectory=/home/jpmelos
# HOME is how `jc` finds ~/config.json. PATH holds ~/bin for `jc` and the
# uv location for `uv run --script`. All secrets come from `jc get`, so the
# unit holds none and reads no environment file.
Environment=HOME=/home/jpmelos
Environment=PATH=/home/jpmelos/bin:/home/jpmelos/.local/bin:/usr/local/bin:/usr/bin:/bin
# Only one process can poll one bot token. Point --tasks-dir at the
# directory with your <name>.py task files. An alternative line for the
# dotfiles checkout is commented below.
ExecStart=/home/jpmelos/bin/telegram_bot --tasks-dir=/home/jpmelos/devel/dotfiles/telegram_tasks
Restart=always
RestartSec=10
# SIGTERM stops the running task gracefully, including its shutdown hook.
TimeoutStopSec=125
UMask=0077
SyslogIdentifier=telegram-bot
# Hardening that stays out of the way of Chromium, which agent-browser
# drives. No syscall or namespace filters: the browser sandbox needs them.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
