{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/scripts/file-suggestions.sh"
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "300000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "0",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "CLAUDE_CODE_HIDE_ACCOUNT_INFO": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "3",
    "DISABLE_AUTOUPDATER": "1",
    "USE_BUILTIN_RIPGREP": "0"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "Write",
      "Edit",
      "Agent",
      "Skill",
      "WebSearch",
      "WebFetch",
      "Bash(./jpenv-bin/lint)",
      "Bash(./jpenv-bin/lint *)",
      "Bash(./jpenv-bin/tests)",
      "Bash(./jpenv-bin/tests *)",
      "Bash(agent-browser)",
      "Bash(agent-browser *)",
      "Bash(ai_git_commit *)",
      "Bash(ai_git_new_branch *)",
      "Bash(ai_git_restore)",
      "Bash(cat *)",
      "Bash(cd)",
      "Bash(cd *)",
      "Bash(cut *)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(echo)",
      "Bash(echo *)",
      "Bash(false)",
      "Bash(git add)",
      "Bash(git add *)",
      "Bash(git apply)",
      "Bash(git apply *)",
      "Bash(git branch)",
      "Bash(git branch --list)",
      "Bash(git branch --show-current)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git main-branch)",
      "Bash(git remote --verbose)",
      "Bash(git rev-list *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(review *)",
      "Bash(rg *)",
      "Bash(safe_rm *)",
      "Bash(safe_mv *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(true)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(whois *)"
    ],
    "deny": [
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/scripts/**)",
      "Edit(/jpenv-bin/**)",
      "EnterPlanMode",
      "Skill(/review)"
    ],
    "defaultMode": "dontAsk"
  },
  "disableBundledSkills": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "ready --no-chime"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "default"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "running"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); if [ -f \"jpenv-bin/post_tool_use\" ]; then echo \"$INPUT\" | ./jpenv-bin/post_tool_use; fi'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ready"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/auto-title.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ready"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Thinking"
    ]
  },
  "alwaysThinkingEnabled": true,
  "theme": "light",
  "terminalProgressBarEnabled": false,
  "disableBypassPermissionsMode": true
}
