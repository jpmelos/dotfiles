#!/usr/bin/env bash
set -euo pipefail
trap 'echo "Exit status $? at line $LINENO from: $BASH_COMMAND" >&2' ERR

# Print the name of the interface that carries the default route.
#
# Usage: default_if

if [ "$#" -ne 0 ]; then
    echo "usage: default_if" >&2
    exit 1
fi

if [ "$(uname -s)" = "Darwin" ]; then
    route -n get default | grep 'interface:' | awk '{print $2}'
else
    echo "Implement for Linux..."
fi
