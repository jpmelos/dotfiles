TASK_NAME_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*")
# Telegram refuses messages past 4096 characters. Chunks stay below that.
SEND_CHUNK_LIMIT = 4000
ERROR_PREVIEW_LIMIT = 500
# Update types that can carry a reply or a command.
MESSAGE_KEYS = ("message", "edited_message")
# Shutdown reasons passed to the shutdown hook.
REASONS = ("done", "error", "timeout", "cancelled", "shutdown")
# File name of the schedule state in the state directory.
SCHEDULE_STATE_FILENAME = "schedule_state.json"
# File name of the poll offset in the state directory.
POLL_STATE_FILENAME = "poll_state.json"
# File name of the export manifest inside the export zip.
EXPORT_MANIFEST_NAME = "telegram_bot_export.json"
# Version of the export format written by export and read by import.
EXPORT_VERSION = 1
# A bad SCHEDULE warns at most once per task per hour, so the log stays quiet.
SCHEDULE_WARN_INTERVAL = 3600.0
# Commands shown in the Telegram menu and autocomplete, via setMyCommands.
# Task commands come first in the menu, then these, both sorted
# alphabetically.
BOT_COMMANDS = (
    ("cancel", "stop the running task"),
    ("help", "show the commands"),
    ("status", "show the running task"),
)


# -----------------------------------------------------------------------------
# Entry point.
# -----------------------------------------------------------------------------


@click.group(
    invoke_without_command=True,
    context_settings={"help_option_names": ["-h", "--help"]},
)
@click.option(
    "--tasks-dir",
    type=click.Path(file_okay=False),
    default=None,
    metavar="DIR",
    help=(
        "Directory with <name>.py task files. Defaults to TELEGRAM_TASKS_DIR, "
        "else ./telegram_tasks."
    ),
)
@click.option(
    "--state-dir",
    type=click.Path(file_okay=False),
    default=None,
    metavar="DIR",
    help=(
        "Directory for task state. Defaults to XDG_STATE_HOME/telegram_bot, "
        "else ~/.local/state/telegram_bot."
    ),
)
@click.option(
    "--token",
    default=None,
    metavar="TOKEN",
    help=(
        "Bot token. Defaults to TELEGRAM_BOT_TOKEN, else the "
        "telegram_bot.bot_token key in ~/config.json."
    ),
)
@click.option(
    "--chat-id",
    "chat_ids",
    multiple=True,
    metavar="ID",
    help=(
        "Allow one chat. Repeat for more chats, or pass a comma separated "
        "list. Defaults to TELEGRAM_CHAT_ID, else the telegram_bot.chat_id "
        "key in ~/config.json."
    ),
)
@click.option(
    "--poll-timeout",
    type=click.FloatRange(1.0, 50.0),
    default=30.0,
    show_default=True,
    metavar="S",
    help="Long-poll wait of one getUpdates call, in seconds.",
)
@click.option(
    "--ask-timeout",
    type=click.FloatRange(1.0, 86400.0),
    default=300.0,
    show_default=True,
    metavar="S",
    help="Default wait for one ask reply, in seconds.",
)
@click.option(
    "--run-timeout",
    type=click.FloatRange(1.0, 604800.0),
    default=3600.0,
    show_default=True,
    metavar="S",
    help="Default budget for one task run, in seconds.",
)
@click.option(
    "--shutdown-timeout",
    type=click.FloatRange(1.0, 900.0),
    default=60.0,
    show_default=True,
    metavar="S",
    help="Grace for the shutdown hook when the bot stops, in seconds.",
)
@click.option(
    "--heartbeat-url",
    default=None,
    metavar="URL",
    help=(
        "Dead-man-switch URL to ping. Defaults to TELEGRAM_HEARTBEAT_URL, "
        "else no ping."
    ),
)
@click.option(
    "--heartbeat-interval",
    type=click.FloatRange(10.0, 86400.0),
    default=300.0,
    show_default=True,
    metavar="S",
    help="Seconds between heartbeat pings.",
)
@click.option(
    "--recent-window",
    type=click.FloatRange(0.0, 3600.0),
    default=30.0,
    show_default=True,
    metavar="S",
    help=(
        "On start, process backlog younger than this, in seconds. Older "
        "backlog is discarded. Zero discards all backlog."
    ),
)
@click.option(
    "--schedule-interval",
    type=click.FloatRange(1.0, 3600.0),
    default=5.0,
    show_default=True,
    metavar="S",
    help="Seconds between schedule checks for periodic tasks.",
)
@click.pass_context
def main(
    ctx,
    tasks_dir,
    state_dir,
    token,
    chat_ids,
    poll_timeout,
    ask_timeout,
    run_timeout,
    shutdown_timeout,
    heartbeat_url,
    heartbeat_interval,
    recent_window,
    schedule_interval,
):
    """Run a Telegram bot that starts tasks and relays their questions to you.

    \b
    Run with no subcommand to start the bot:
      telegram_bot [--tasks-dir DIR] [--state-dir DIR] ...
    Move the bot to another machine with:
      telegram_bot export [--state-dir DIR] [--force] FILE
      telegram_bot import [--state-dir DIR] FILE

    \b
    Chat commands:
      /<task> [...] - start a task; only one task runs at a time.
      Hyphens in task names become underscores in the Telegram menu
      (budget-sync runs as /budget_sync there), while the chat accepts
      the original name, the menu name, and any shorthand (/b, /br).
      /status - show uptime, the running task, and the last result
      /cancel - stop the running task; its shutdown hook still runs
      /help - show the commands
    Any other text goes to the running task while it waits for a reply.
    Text that starts with / is always a command, never a reply.

    \b
    Task files:
      A task is a Python file at TASKS_DIR/<name>.py, where <name> holds
      letters, digits, _ and -. Files that start with _ or . are ignored.
      The bot loads the file fresh on every run, so edits apply to the
      next run without a restart. The file name is the task name in /<task>,
      /status, and the state directory. A task module may define
      DESCRIPTION, TIMEOUT, SCHEDULE, SCHEDULE_ARGS, SHORTHAND, SHORTHANDS,
      run and shutdown. SHORTHAND holds one shorthand string such as "bs",
      and SHORTHANDS holds a tuple or list of them; a shorthand works
      everywhere the task name works, including as /<shorthand>, while
      messages that list tasks show
      the task name with its shorthands in parentheses and all other
      messages show just the task name.
      run is required as run(ctx)
      or run(ctx, args) and may be async. shutdown is optional as
      shutdown(ctx) or shutdown(ctx, reason) and runs once after every
      outcome: done, error, timeout, cancelled or shutdown.

    \b
    Task context:
      ctx.say(text) sends a message. ctx.ask(prompt, pattern, timeout)
      sends a prompt and waits for a reply that fully matches the regex.
      A mismatch asks again within the same wait. A timeout stops the task
      and runs shutdown with reason timeout. ctx.load_state, ctx.save_state,
      ctx.state_path, ctx.delete_state and ctx.list_states manage files at
      STATE_DIR/tasks/<task>/<id>. ctx.load_state and ctx.list_states take
      an optional task_name to read another task's state; a shorthand works
      there too; tasks can read
      each other's states but only write their own. ctx.check raises when
      the task must stop. ctx.log writes to the bot log.

    \b
    Task dependencies:
      A task file may set DEPENDENCIES to a tuple of requirement strings,
      such as ("ynab>=4.4.0,<5",). The bot installs them with `uv` into a
      venv per task on every run, and the task imports them normally. The
      bot itself holds no task dependency. `uv` must be on PATH when a
      task declares any.

    \b
    Scheduling:
      A task file may set SCHEDULE to a crontab string with five fields,
      such as "0 9 * * *" for 09:00 every day (minute, hour, day of
      month, month, day of week, local time). The bot checks every
      --schedule-interval seconds and auto-starts each due task with
      SCHEDULE_ARGS as its args. Only one task runs at a time, so a due
      task waits for the running one to finish. Missed executions never
      burst: a task runs at most once per check no matter how many ticks
      it skipped. A manual run counts as an execution. Only failures
      reach the chat: scheduled runs report failures to the first
      allowlisted chat, while successful runs stay silent.

    \b
    Polling:
      The bot uses long polling, so no inbound port is needed. The poll
      offset is saved after every batch, so a restart replays nothing
      already processed. Backlog younger than --recent-window is still
      processed on start, while older backlog is discarded. Only one
      process can poll one bot token at a time.

    \b
    Security:
      Only the allowlisted chats can talk to the bot. A one-time code lives
      only in memory and is never logged. Never send passwords or account
      data through the chat.

    \b
    State transfer:
      export writes everything the bot needs to resume into a zip file at
      FILE: the poll offset, the schedule state, and every file under
      STATE_DIR/tasks. Task venvs under STATE_DIR/venvs are left out, since
      the next run rebuilds them from DEPENDENCIES. Temporary files whose
      name starts with . are left out as well. The zip itself gets mode
      0600, since task state can hold sessions and tokens. import restores
      such a zip into STATE_DIR, replacing the poll offset, the schedule
      state, and the tasks tree, while it leaves venvs alone. Stop the bot
      before import, and do not run two bots from one state directory.
    """
    ctx.obj = {
        "tasks_dir": tasks_dir,
        "state_dir": state_dir,
        "token": token,
        "chat_ids": chat_ids,
        "poll_timeout": poll_timeout,
        "ask_timeout": ask_timeout,
        "run_timeout": run_timeout,
        "shutdown_timeout": shutdown_timeout,
        "heartbeat_url": heartbeat_url,
        "heartbeat_interval": heartbeat_interval,
        "recent_window": recent_window,
        "schedule_interval": schedule_interval,
    }
    if ctx.invoked_subcommand is not None:
        return
    try:
        bot = Bot(
            token=resolve_token(token),
            allowed_chats=resolve_allowed_chats(chat_ids),
            tasks_dir=resolve_tasks_dir(tasks_dir),
            state_base=resolve_state_base(state_dir),
            poll_timeout=poll_timeout,
            default_ask_timeout=ask_timeout,
            default_run_timeout=run_timeout,
            shutdown_timeout=shutdown_timeout,
            heartbeat_url=heartbeat_url,
            heartbeat_interval=heartbeat_interval,
            recent_window=recent_window,
            schedule_interval=schedule_interval,
        )
        exit_status = bot.serve()
    except KeyboardInterrupt:
        # Ctrl-C during startup. The shell convention for SIGINT is 128 + 2.
        sys.exit(130)
    sys.exit(exit_status)


@main.command("export")
@click.argument("path", type=click.Path(dir_okay=False))
@click.option(
    "--state-dir",
    type=click.Path(file_okay=False),
    default=None,
    metavar="DIR",
    help=(
        "Directory for task state. Defaults to the --state-dir given before "
        "export, else TELEGRAM_STATE_DIR, else XDG_STATE_HOME/telegram_bot, "
        "else ~/.local/state/telegram_bot."
    ),
)
@click.option(
    "--force",
    is_flag=True,
    default=False,
    help="Replace FILE when it already exists.",
)
@click.pass_context
def export_state(ctx, path, state_dir, force):
    """Export all bot and task state into the zip file at PATH."""
    base = resolve_state_base(state_dir or (ctx.obj or {}).get("state_dir"))
    try:
        count = export_state_dir(base, path, overwrite=force)
    except BotError as error:
        die(str(error))
    log(f"Exported {count} file(s) from {base} to {path}.")


@main.command("import")
@click.argument("path", type=click.Path(exists=True, dir_okay=False))
@click.option(
    "--state-dir",
    type=click.Path(file_okay=False),
    default=None,
    metavar="DIR",
    help=(
        "Directory for task state. Defaults to the --state-dir given before "
        "import, else TELEGRAM_STATE_DIR, else XDG_STATE_HOME/telegram_bot, "
        "else ~/.local/state/telegram_bot."
    ),
)
@click.pass_context
def import_state(ctx, path, state_dir):
    """Import bot and task state from the zip file at PATH."""
    base = resolve_state_base(state_dir or (ctx.obj or {}).get("state_dir"))
    try:
        count = import_state_dir(base, path)
    except BotError as error:
        die(str(error))
    log(f"Imported {count} file(s) from {path} to {base}.")


# -----------------------------------------------------------------------------
# Poll state.
# -----------------------------------------------------------------------------


def read_poll_offset(path):
    # Returns the last processed update identifier in path, or None when the
    # file is missing or broken. A broken file only warns, so the bot still
    # starts and falls back to the recency filter.
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as error:
        log(
            f"Warning: cannot read {path}: {error}. "
            "Starting without a saved offset."
        )
        return None
    if isinstance(data, dict):
        value = data.get("last_update_id")
        if (
            isinstance(value, int)
            and not isinstance(value, bool)
            and value > 0
        ):
            return value
    return None


def write_poll_offset(path, update_id):
    # Atomically stores the last processed update identifier. Raises OSError
    # on failure. The caller logs and goes on, so persistence never stops
    # the bot.
    raw = (json.dumps({"last_update_id": update_id}, indent=2) + "\n").encode(
        "utf-8"
    )
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    descriptor, temp_path = tempfile.mkstemp(
        dir=os.path.dirname(path), prefix=".poll-"
    )
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
            os.fchmod(handle.fileno(), 0o600)
        os.replace(temp_path, path)
    except BaseException:
        try:
            os.remove(temp_path)
        except OSError:
            pass
        raise


def message_time(update):
    # Returns the Unix time of the message in update, or None when the update
    # holds no dated message. An edit counts at its edit time.
    if not isinstance(update, dict):
        return None
    for key in MESSAGE_KEYS:
        message = update.get(key)
        if not isinstance(message, dict):
            continue
        if key == "edited_message":
            stamp = message.get("edit_date", message.get("date"))
        else:
            stamp = message.get("date")
        if isinstance(stamp, bool):
            return None
        if isinstance(stamp, (int, float)):
            return float(stamp)
        return None
    return None


# -----------------------------------------------------------------------------
# Configuration.
# -----------------------------------------------------------------------------


def resolve_token(token):
    if token and token.strip():
        return token.strip()
    value = os.environ.get("TELEGRAM_BOT_TOKEN", "").strip()
    if value:
        return value
    found = read_jc_string("telegram_bot.bot_token")
    if found:
        return found
    die(
        "No bot token. Pass --token, set TELEGRAM_BOT_TOKEN, or store the "
        "token as telegram_bot.bot_token in ~/config.json"
    )


def resolve_allowed_chats(chat_ids):
    raw_values = list(chat_ids)
    env_value = os.environ.get("TELEGRAM_CHAT_ID", "").strip()
    if env_value:
        raw_values.append(env_value)
    if not raw_values:
        found = read_jc_value("telegram_bot.chat_id")
        if isinstance(found, bool):
            die(
                "telegram_bot.chat_id in ~/config.json "
                "is not a chat identifier"
            )
        if isinstance(found, int):
            return [found]
        if isinstance(found, float) and found.is_integer():
            return [int(found)]
        if isinstance(found, str) and found.strip():
            raw_values.append(found)
    if not raw_values:
        die(
            "No allowed chat. Pass --chat-id, set TELEGRAM_CHAT_ID, or store "
            "the chat identifier as telegram_bot.chat_id in ~/config.json"
        )
    chats = []
    for raw in raw_values:
        for part in str(raw).split(","):
            part = part.strip()
            if not part:
                continue
            try:
                chat_id = int(part)
            except ValueError:
                die(f"Invalid chat identifier {part!r}, expected an integer")
            if chat_id == 0:
                die("Invalid chat identifier 0")
            if chat_id not in chats:
                chats.append(chat_id)
    if not chats:
        die("No allowed chat. The chat list is empty")
    return chats


def resolve_tasks_dir(tasks_dir):
    value = (tasks_dir or "").strip() or os.environ.get(
        "TELEGRAM_TASKS_DIR", ""
    ).strip()
    if not value:
        value = os.path.join(os.getcwd(), "telegram_tasks")
    return os.path.abspath(value)


def resolve_state_base(state_dir):
    value = (state_dir or "").strip() or os.environ.get(
        "TELEGRAM_STATE_DIR", ""
    ).strip()
    if value:
        return os.path.abspath(value)
    home_base = os.environ.get("XDG_STATE_HOME", "").strip()
    if not home_base:
        home_base = os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(home_base, "telegram_bot")


def read_jc_string(path):
    value = read_jc_value(path)
    if value is None:
        return None
    if not isinstance(value, str) or not value.strip():
        die(f"{path} in ~/config.json is not text")
    return value.strip()


def read_jc_value(path):
    # Returns the parsed value at path in ~/config.json, or None when jc is
    # missing, the file is missing, or the value is null. Dies on other jc
    # failures so a broken setup never starts half configured.
    try:
        result = subprocess.run(
            ["jc", "get", path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            encoding="utf-8",
            errors="replace",
            timeout=15,
        )
    except FileNotFoundError:
        return None
    except (OSError, subprocess.SubprocessError) as error:
        die(f"cannot run jc: {error}")
    if result.returncode == 2:
        return None
    if result.returncode != 0:
        detail = (result.stderr or "").strip() or "no error message from jc"
        die(f"cannot read ~/config.json: {detail}")
    try:
        return json.loads(result.stdout)
    except ValueError as error:
        die(f"jc returned invalid JSON: {error}")


def ensure_dir(path, mode=0o700):
    try:
        os.makedirs(path, mode=mode, exist_ok=True)
        os.chmod(path, mode)
    except OSError as error:
        die(f"cannot prepare {path}: {error}")


# -----------------------------------------------------------------------------
# Errors.
# -----------------------------------------------------------------------------


class BotError(Exception):
    pass


class ApiError(BotError):
    def __init__(self, code, description, retry_after=None):
        super().__init__(f"Telegram API error {code}: {description}")
        self.code = code
        self.description = description
        self.retry_after = retry_after


class NetworkError(BotError):
    pass


class TaskTimeout(TimeoutError):
    pass


class TaskCancelled(Exception):
    pass


class TaskKilled(Exception):
    pass


class TaskLoadError(BotError):
    pass


# -----------------------------------------------------------------------------
# Telegram API.
# -----------------------------------------------------------------------------


class TelegramApi:
    def __init__(self, token, http_timeout=45.0):
        self.base_url = f"https://api.telegram.org/bot{token}/"
        self.http_timeout = http_timeout

    def call(self, method, params=None, http_timeout=None):
        body = json.dumps(params or {}).encode("utf-8")
        request = urllib.request.Request(
            self.base_url + method,
            data=body,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        timeout = self.http_timeout if http_timeout is None else http_timeout
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                payload = json.loads(response.read().decode("utf-8"))
        except urllib.error.HTTPError as error:
            raise self.http_error(method, error) from error
        except (
            urllib.error.URLError,
            TimeoutError,
            OSError,
            ValueError,
        ) as error:
            raise NetworkError(f"{method} failed: {error}") from error
        if not isinstance(payload, dict) or not payload.get("ok"):
            description = "unknown error"
            if isinstance(payload, dict):
                description = str(payload.get("description", description))
            raise ApiError(0, f"{method} failed: {description}")
        return payload.get("result")

    def http_error(self, method, error):
        try:
            payload = json.loads(
                error.read().decode("utf-8", errors="replace")
            )
        except (OSError, ValueError):
            payload = None
        if isinstance(payload, dict):
            description = str(payload.get("description", error.reason))
            code = payload.get("error_code", error.code)
            retry_after = None
            parameters = payload.get("parameters")
            if isinstance(parameters, dict):
                retry_after = parameters.get("retry_after")
            return ApiError(
                code, f"{method} failed: {description}", retry_after
            )
        return ApiError(error.code, f"{method} failed: {error.reason}")


def split_text(text, limit=SEND_CHUNK_LIMIT):
    # Splits text into chunks below the Telegram length limit. Splits at line
    # boundaries when one is near, else cuts at the limit.
    chunks = []
    rest = text
    while len(rest) > limit:
        cut = rest.rfind("\n", 0, limit)
        if cut < limit // 2:
            cut = limit
        chunks.append(rest[:cut])
        rest = rest[cut:].lstrip("\n")
    chunks.append(rest)
    return chunks


def truncate(text, limit):
    if len(text) <= limit:
        return text
    return text[:limit] + " [truncated]"


# -----------------------------------------------------------------------------
# State store.
# -----------------------------------------------------------------------------


class StateStore:
    def __init__(self, base_dir):
        self.base_dir = os.path.abspath(base_dir)
        ensure_dir(self.base_dir)

    def task_dir(self, task_name):
        # Task names come from file names that match TASK_NAME_PATTERN, so
        # the join cannot escape the base directory. resolve() guards anyway.
        path = os.path.join(self.base_dir, "tasks", task_name)
        ensure_dir(path)
        return path

    def resolve(self, task_name, identifier):
        if (
            not isinstance(identifier, str)
            or not identifier
            or len(identifier) > 200
        ):
            raise ValueError(f"invalid state identifier {identifier!r}")
        if "\0" in identifier or identifier.startswith("/"):
            raise ValueError(f"invalid state identifier {identifier!r}")
        parts = identifier.split("/")
        if any(part in ("", ".", "..") for part in parts):
            raise ValueError(f"invalid state identifier {identifier!r}")
        full = os.path.realpath(os.path.join(self.task_dir(task_name), *parts))
        root = os.path.realpath(
            os.path.join(self.base_dir, "tasks", task_name)
        )
        if full != root and not full.startswith(root + os.sep):
            raise ValueError(f"invalid state identifier {identifier!r}")
        return full

    def load(self, task_name, identifier, default=None):
        try:
            path = self.resolve(task_name, identifier)
        except ValueError:
            raise
        try:
            with open(path, "rb") as handle:
                return handle.read()
        except FileNotFoundError:
            return default
        except OSError as error:
            raise BotError(
                f"cannot read state {identifier!r}: {error}"
            ) from error

    def save(self, task_name, identifier, data):
        if isinstance(data, str):
            raw = data.encode("utf-8")
        elif isinstance(data, (bytes, bytearray)):
            raw = bytes(data)
        elif isinstance(data, (dict, list)):
            raw = (
                json.dumps(data, indent=2, ensure_ascii=False) + "\n"
            ).encode("utf-8")
        else:
            raise TypeError("state data must be str, bytes, or a JSON value")
        path = self.resolve(task_name, identifier)
        ensure_dir(os.path.dirname(path))
        descriptor, temp_path = tempfile.mkstemp(
            dir=os.path.dirname(path), prefix=".state-"
        )
        replaced = False
        try:
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(raw)
                handle.flush()
                os.fsync(handle.fileno())
                os.fchmod(handle.fileno(), 0o600)
            os.replace(temp_path, path)
            replaced = True
        except OSError as error:
            raise BotError(
                f"cannot write state {identifier!r}: {error}"
            ) from error
        finally:
            if not replaced:
                try:
                    os.remove(temp_path)
                except OSError:
                    pass
        try:
            os.chmod(path, 0o600)
        except OSError as error:
            raise BotError(
                f"cannot set the mode of {identifier!r}: {error}"
            ) from error

    def delete(self, task_name, identifier):
        path = self.resolve(task_name, identifier)
        try:
            os.remove(path)
        except FileNotFoundError:
            return False
        except OSError as error:
            raise BotError(
                f"cannot delete state {identifier!r}: {error}"
            ) from error
        return True

    def list(self, task_name):
        root = self.task_dir(task_name)
        found = []
        for current, _directories, files in os.walk(root):
            for name in files:
                if name.startswith(".state-"):
                    continue
                full = os.path.join(current, name)
                found.append(os.path.relpath(full, root))
        return sorted(found)


# -----------------------------------------------------------------------------
# Tasks.
# -----------------------------------------------------------------------------


@dataclass
class TaskSpec:
    name: str
    path: str
    description: str
    shorthands: tuple = ()


def discover_tasks(tasks_dir):
    # Lists the tasks without executing their code. DESCRIPTION, SHORTHAND and
    # SHORTHANDS come from a syntax tree scan, so listing never runs task code.
    specs = {}
    if not os.path.isdir(tasks_dir):
        return specs
    try:
        entries = sorted(os.listdir(tasks_dir))
    except OSError:
        return specs
    for entry in entries:
        if not entry.endswith(".py"):
            continue
        stem = entry[:-3]
        if not TASK_NAME_PATTERN.fullmatch(stem):
            continue
        if stem.startswith("_"):
            continue
        path = os.path.join(tasks_dir, entry)
        if not os.path.isfile(path):
            continue
        shorthands = tuple(
            item for item in read_task_shorthands(path) if item != stem
        )
        specs[stem] = TaskSpec(
            name=stem,
            path=path,
            description=read_task_description(path),
            shorthands=shorthands,
        )
    return specs


def resolve_task_spec(specs, name):
    # Returns the task for a full name or a shorthand. A full name always
    # wins over a shorthand, so a shorthand never hides a task. A shorthand
    # shared by several tasks goes to the first task in sorted order, so the
    # choice stays deterministic. Returns None when nothing matches.
    spec = specs.get(name)
    if spec is not None:
        return spec
    for canonical in sorted(specs):
        candidate = specs[canonical]
        if name in candidate.shorthands:
            return candidate
    return None


def display_task_name(spec):
    # Returns the name shown in messages that list tasks: the task name
    # followed by its shorthands in parentheses, or just the task name when
    # it defines none. All other messages show just the task name.
    if spec.shorthands:
        return f"{spec.name} ({', '.join(spec.shorthands)})"
    return spec.name


def menu_command_for_task(name):
    # Returns the Telegram menu command for a task or shorthand name.
    # Telegram BotCommand allows only 1-32 lowercase English letters,
    # digits, and underscores, while task names also allow uppercase and
    # hyphens. Lowercase and turn hyphens into underscores; any other
    # unexpected character becomes an underscore as well. Truncate to the
    # Telegram limit; an empty result means the name has no valid menu
    # command.
    command = name.lower().replace("-", "_")
    command = re.sub(r"[^a-z0-9_]", "_", command)
    return command[:32]


def build_task_command_map(specs):
    # Maps every accepted chat command to its task spec. Accepts the
    # original task name (for example budget-sync), the Telegram menu
    # name (for example budget_sync), and every shorthand (for example b).
    # Keys are lowercased because incoming commands arrive lowercased.
    # The first task in sorted order wins when several names share one
    # command, so the choice stays deterministic.
    mapping = {}
    for task_name in sorted(specs):
        spec = specs[task_name]
        candidates = {task_name.lower(), menu_command_for_task(task_name)}
        for shorthand in spec.shorthands:
            candidates.add(shorthand.lower())
            candidates.add(menu_command_for_task(shorthand))
        for candidate in candidates:
            if not candidate:
                continue
            if candidate not in mapping:
                mapping[candidate] = spec
    return mapping


def read_task_description(path):
    # Returns the DESCRIPTION string of the task file, or an empty string
    # when the file defines none. Read from the syntax tree, so no task
    # code runs.
    try:
        with open(path, encoding="utf-8") as handle:
            source = handle.read()
        tree = ast.parse(source, filename=path)
    except (OSError, SyntaxError, ValueError):
        return ""
    for node in tree.body:
        if not isinstance(node, ast.Assign) or len(node.targets) != 1:
            continue
        target = node.targets[0]
        if not isinstance(target, ast.Name) or target.id != "DESCRIPTION":
            continue
        if isinstance(node.value, ast.Constant) and isinstance(
            node.value.value, str
        ):
            return node.value.value.strip()
    return ""


def read_task_shorthands(path):
    # Returns the shorthand tuple of the task file, or an empty tuple when
    # the file defines none. SHORTHAND holds one shorthand string, and
    # SHORTHANDS holds a tuple or list of them. A plain string also counts
    # for SHORTHANDS. Only values that match TASK_NAME_PATTERN count, so an
    # invalid entry never becomes a shorthand. Read from the syntax tree, so
    # no task code runs. Never raises, so listing stays quiet on bad values.
    try:
        with open(path, encoding="utf-8") as handle:
            tree = ast.parse(handle.read(), filename=path)
    except (OSError, SyntaxError, ValueError):
        return ()
    found = []
    for node in tree.body:
        if not (
            isinstance(node, ast.Assign)
            and len(node.targets) == 1
            and isinstance(node.targets[0], ast.Name)
            and node.targets[0].id in ("SHORTHAND", "SHORTHANDS")
        ):
            continue
        value = node.value
        if isinstance(value, ast.Constant) and isinstance(value.value, str):
            candidates = [value.value]
        elif isinstance(value, (ast.List, ast.Tuple)):
            candidates = []
            valid = True
            for element in value.elts:
                if not isinstance(element, ast.Constant) or not isinstance(
                    element.value, str
                ):
                    valid = False
                    break
                candidates.append(element.value)
            if not valid:
                continue
        else:
            continue
        for candidate in candidates:
            text = candidate.strip()
            if not text:
                continue
            if not TASK_NAME_PATTERN.fullmatch(text):
                continue
            found.append(text)
    seen = set()
    result = []
    for item in found:
        if item not in seen:
            seen.add(item)
            result.append(item)
    return tuple(result)


def read_task_timeout(path, default):
    # Returns the TIMEOUT number of the task file, or `default` when the
    # file defines none. Read from the syntax tree, so no task code runs.
    try:
        with open(path, encoding="utf-8") as handle:
            tree = ast.parse(handle.read(), filename=path)
    except (OSError, SyntaxError, ValueError):
        return default
    for node in tree.body:
        if (
            isinstance(node, ast.Assign)
            and len(node.targets) == 1
            and isinstance(node.targets[0], ast.Name)
            and node.targets[0].id == "TIMEOUT"
            and isinstance(node.value, ast.Constant)
            and isinstance(node.value.value, (int, float))
            and not isinstance(node.value.value, bool)
            and node.value.value > 0
        ):
            return float(node.value.value)
    return default


def read_task_dependencies(path):
    # Returns the DEPENDENCIES strings of the task file, or an empty list.
    # Only a plain tuple or list of strings counts. Read from the syntax
    # tree, so no task code runs.
    try:
        with open(path, encoding="utf-8") as handle:
            tree = ast.parse(handle.read(), filename=path)
    except (OSError, SyntaxError, ValueError) as error:
        raise TaskLoadError(f"cannot read {path}: {error}") from error
    for node in tree.body:
        if not (
            isinstance(node, ast.Assign)
            and len(node.targets) == 1
            and isinstance(node.targets[0], ast.Name)
            and node.targets[0].id == "DEPENDENCIES"
        ):
            continue
        if not isinstance(node.value, (ast.List, ast.Tuple)):
            raise TaskLoadError(f"task file {path} has bad DEPENDENCIES")
        entries = []
        for element in node.value.elts:
            if not isinstance(element, ast.Constant) or not isinstance(
                element.value, str
            ):
                raise TaskLoadError(f"task file {path} has bad DEPENDENCIES")
            if element.value.strip():
                entries.append(element.value.strip())
        return entries
    return []


def read_task_schedule(path):
    # Returns the (SCHEDULE, SCHEDULE_ARGS) pair of the task file. SCHEDULE
    # is a crontab string such as "0 9 * * *", or None when the file defines
    # none. SCHEDULE_ARGS holds the words passed to run on scheduled runs.
    # Read from the syntax tree, so no task code runs. Raises TaskLoadError
    # on a malformed value.
    try:
        with open(path, encoding="utf-8") as handle:
            tree = ast.parse(handle.read(), filename=path)
    except (OSError, SyntaxError, ValueError) as error:
        raise TaskLoadError(f"cannot read {path}: {error}") from error
    expr = None
    args = []
    for node in tree.body:
        if not (
            isinstance(node, ast.Assign)
            and len(node.targets) == 1
            and isinstance(node.targets[0], ast.Name)
            and node.targets[0].id in ("SCHEDULE", "SCHEDULE_ARGS")
        ):
            continue
        if node.targets[0].id == "SCHEDULE":
            if isinstance(node.value, ast.Constant) and isinstance(
                node.value.value, str
            ):
                expr = node.value.value.strip() or None
            else:
                raise TaskLoadError(f"task file {path} has bad SCHEDULE")
        else:
            if not isinstance(node.value, (ast.List, ast.Tuple)):
                raise TaskLoadError(f"task file {path} has bad SCHEDULE_ARGS")
            entries = []
            for element in node.value.elts:
                if not isinstance(element, ast.Constant) or not isinstance(
                    element.value, str
                ):
                    raise TaskLoadError(
                        f"task file {path} has bad SCHEDULE_ARGS"
                    )
                entries.append(element.value)
            args = entries
    return expr, args


def read_schedule_state(path):
    # Returns the {task name: last dispatch epoch} map in path, or an empty
    # map when the file is missing or broken. A broken file only warns, so
    # the bot still starts and re-baselines every schedule.
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as error:
        log(
            f"Warning: cannot read {path}: {error}. "
            "Starting with no schedule state."
        )
        return {}
    if not isinstance(data, dict):
        return {}
    state = {}
    for name, value in data.items():
        if not isinstance(name, str) or not TASK_NAME_PATTERN.fullmatch(name):
            continue
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            continue
        if value > 0:
            state[name] = float(value)
    return state


def write_schedule_state(path, state):
    # Atomically stores the schedule state. Raises OSError on failure. The
    # caller logs and goes on, so persistence never stops the bot.
    raw = (json.dumps(state, indent=2, sort_keys=True) + "\n").encode("utf-8")
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    descriptor, temp_path = tempfile.mkstemp(
        dir=os.path.dirname(path), prefix=".schedule-"
    )
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
            os.fchmod(handle.fileno(), 0o600)
        os.replace(temp_path, path)
    except BaseException:
        try:
            os.remove(temp_path)
        except OSError:
            pass
        raise


def cron_next_after(expr, after_epoch):
    # Returns the epoch of the first crontab time of expr strictly after
    # after_epoch. Times follow the local timezone. Raises on a bad expr.
    tz = datetime.datetime.now().astimezone().tzinfo
    base = datetime.datetime.fromtimestamp(after_epoch, tz=tz)
    return croniter(expr, base).get_next(datetime.datetime).timestamp()


# Seconds for the `uv` calls that build the task venv. Installing happens in
# the worker thread, so a slow index never blocks command handling.
UV_VENV_TIMEOUT = 120.0
UV_INSTALL_TIMEOUT = 600.0


def ensure_task_env(state_base, task_name, dependencies):
    # Installs `dependencies` with `uv` into the venv of the task, on every
    # run, and returns its site-packages directory. Returns None when the
    # task declares none, so plain tasks never need `uv`.
    if not dependencies:
        return None
    uv = shutil.which("uv")
    if uv is None:
        raise TaskLoadError("task needs dependencies but `uv` is not on PATH")
    venv_dir = os.path.join(state_base, "venvs", task_name)
    venv_python = os.path.join(venv_dir, "bin", "python")
    if not os.path.isfile(venv_python):
        run_uv(uv, ["venv", venv_dir], UV_VENV_TIMEOUT, "create the task venv")
    # `--upgrade` refreshes the dependencies on every run.
    run_uv(
        uv,
        [
            "pip",
            "install",
            "--python",
            venv_python,
            "--upgrade",
            "--quiet",
            *dependencies,
        ],
        UV_INSTALL_TIMEOUT,
        "install the task dependencies",
    )
    site_packages = venv_site_packages(venv_dir)
    if site_packages is None:
        raise TaskLoadError("task venv has no site-packages directory")
    return site_packages


def run_uv(uv, args, timeout, action):
    # Runs one `uv` call. Raises TaskLoadError with the tail of the uv error
    # when the call fails. Dependency names are safe to report.
    try:
        result = subprocess.run(
            [uv, *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            encoding="utf-8",
            errors="replace",
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise TaskLoadError(f"timed out to {action}") from None
    except OSError as error:
        raise TaskLoadError(f"cannot run uv: {error}") from error
    if result.returncode != 0:
        tail = (result.stderr or "").strip().splitlines()[-5:]
        detail = "\n".join(tail) or "no error message from uv"
        raise TaskLoadError(f"failed to {action}: {detail}")


def venv_site_packages(venv_dir):
    # Returns the site-packages directory of the venv, or None.
    try:
        entries = sorted(os.listdir(os.path.join(venv_dir, "lib")))
    except OSError:
        return None
    for entry in entries:
        candidate = os.path.join(venv_dir, "lib", entry, "site-packages")
        if os.path.isdir(candidate):
            return candidate
    return None


_task_module_counter = 0
_task_module_lock = threading.Lock()


def load_task_module(spec):
    global _task_module_counter
    with _task_module_lock:
        _task_module_counter += 1
        suffix = _task_module_counter
    module_name = f"telegram_task_{spec.name}_{suffix}"
    try:
        loader = importlib.util.spec_from_file_location(module_name, spec.path)
        if loader is None or loader.loader is None:
            raise TaskLoadError(f"cannot load {spec.path}")
        module = importlib.util.module_from_spec(loader)
        loader.loader.exec_module(module)
    except TaskLoadError:
        raise
    except Exception as error:
        raise TaskLoadError(
            f"cannot load task {spec.name}: {type(error).__name__}: {error}"
        ) from error
    run_fn = getattr(module, "run", None)
    if not callable(run_fn):
        raise TaskLoadError(f"task {spec.name} defines no callable run")
    shutdown_fn = getattr(module, "shutdown", None)
    if shutdown_fn is not None and not callable(shutdown_fn):
        raise TaskLoadError(
            f"task {spec.name} defines a shutdown that is not callable"
        )
    timeout = getattr(module, "TIMEOUT", None)
    if timeout is not None:
        if isinstance(timeout, bool) or not isinstance(timeout, (int, float)):
            raise TaskLoadError(
                f"task {spec.name} defines a TIMEOUT that is not a number"
            )
        if not timeout > 0:
            raise TaskLoadError(
                f"task {spec.name} defines a TIMEOUT that is not positive"
            )
        timeout = float(timeout)
    return module, shutdown_fn, timeout


def build_call(fn, ctx, extra):
    # Calls fn with (ctx,) or (ctx, extra). A function that takes another
    # positional argument gets the extra one, else it gets the context only.
    try:
        parameters = inspect.signature(fn).parameters.values()
    except (TypeError, ValueError):
        return (ctx, extra)
    positionals = 0
    has_var_positional = False
    for parameter in parameters:
        if parameter.kind == inspect.Parameter.VAR_POSITIONAL:
            has_var_positional = True
        elif parameter.kind in (
            inspect.Parameter.POSITIONAL_ONLY,
            inspect.Parameter.POSITIONAL_OR_KEYWORD,
        ):
            positionals += 1
    if has_var_positional or positionals >= 2:
        return (ctx, extra)
    return (ctx,)


def call_task_function(fn, ctx, extra):
    arguments = build_call(fn, ctx, extra)
    if inspect.iscoroutinefunction(fn):
        return asyncio.run(fn(*arguments))
    return fn(*arguments)


# -----------------------------------------------------------------------------
# Task context.
# -----------------------------------------------------------------------------


class RunRecord:
    def __init__(self, name, args, chat_id, run_timeout):
        self.name = name
        self.args = args
        self.chat_id = chat_id
        self.run_timeout = run_timeout
        self.start_mono = time.monotonic()
        self.overall_deadline = self.start_mono + run_timeout
        self.thread = None
        # Abort reason, one of None, cancelled, timeout, shutdown.
        # First set wins.
        self.abort = None
        self.pending = None
        self.phase = "starting"
        self.pending_serial = 0


class TaskContext:
    Timeout = TaskTimeout
    Cancelled = TaskCancelled
    Killed = TaskKilled

    def __init__(self, bot, record, in_shutdown=False):
        self._bot = bot
        self._record = record
        self._in_shutdown = in_shutdown

    @property
    def task_name(self):
        return self._record.name

    @property
    def args(self):
        return list(self._record.args)

    @property
    def chat_id(self):
        return self._record.chat_id

    def elapsed(self):
        return time.monotonic() - self._record.start_mono

    def log(self, text):
        log(f"task {self._record.name}: {text}")

    def check(self):
        self._check()

    def say(self, text):
        if not isinstance(text, str):
            text = str(text)
        self._check()
        return self._bot.send_text(self._record.chat_id, text)

    def ask(self, prompt, pattern=None, timeout=None):
        if not isinstance(prompt, str):
            prompt = str(prompt)
        if pattern is not None and not isinstance(pattern, str):
            raise TypeError("pattern must be a regex string or None")
        compiled = None
        if pattern is not None:
            try:
                compiled = re.compile(pattern)
            except re.error as error:
                raise ValueError(
                    f"invalid pattern {pattern!r}: {error}"
                ) from error
        if timeout is None:
            timeout = self._bot.default_ask_timeout
        try:
            timeout = float(timeout)
        except (TypeError, ValueError) as error:
            raise TypeError("timeout must be a number of seconds") from error
        if not timeout > 0:
            raise ValueError("timeout must be positive")
        if self._in_shutdown:
            raise TaskKilled("the task is shutting down, ask is not allowed")
        self._check()
        bot = self._bot
        record = self._record
        deadline = min(time.monotonic() + timeout, record.overall_deadline)
        with bot.lock:
            record.pending_serial += 1
            serial = record.pending_serial
            record.pending = {
                "serial": serial,
                "compiled": compiled,
                "deadline": deadline,
                "reply": None,
            }
        try:
            bot.send_text(record.chat_id, prompt)
        except Exception:
            with bot.lock:
                if (
                    record.pending is not None
                    and record.pending["serial"] == serial
                ):
                    record.pending = None
                    bot.cond.notify_all()
            raise
        try:
            while True:
                with bot.lock:
                    if (
                        record.pending is None
                        or record.pending["serial"] != serial
                    ):
                        raise TaskKilled("the wait was superseded")
                    abort = record.abort
                    if abort == "cancelled":
                        record.pending = None
                        raise TaskCancelled("the task was cancelled")
                    if abort == "shutdown" or bot.stopping.is_set():
                        record.pending = None
                        raise TaskKilled("the bot is stopping")
                    if abort == "timeout":
                        record.pending = None
                        raise TaskTimeout("the task timed out")
                    reply = record.pending["reply"]
                    if reply is not None:
                        record.pending["reply"] = None
                        if (
                            compiled is not None
                            and compiled.fullmatch(reply) is None
                        ):
                            need_retry = True
                        else:
                            record.pending = None
                            return reply
                    else:
                        need_retry = False
                        now = time.monotonic()
                        if now >= record.overall_deadline:
                            bot.set_abort_locked(record, "timeout")
                            record.pending = None
                            raise TaskTimeout("the run budget is exhausted")
                        if now >= record.pending["deadline"]:
                            bot.set_abort_locked(record, "timeout")
                            record.pending = None
                            raise TaskTimeout(
                                f"no matching reply within {timeout:g} seconds"
                            )
                        wait_for = record.pending["deadline"] - now
                        left_overall = record.overall_deadline - now
                        wait_for = min(wait_for, left_overall)
                        bot.cond.wait(timeout=wait_for)
                        continue
                if need_retry:
                    # Sent outside the lock so a slow network never blocks
                    # command handling. A failure only warns, the wait goes on.
                    try:
                        bot.send_text(
                            record.chat_id,
                            "That reply does not match the expected format. "
                            "Try again.",
                        )
                    except BotError as error:
                        log(
                            f"task {record.name}: retry notice failed: {error}"
                        )
        finally:
            with bot.lock:
                # No exit path may leave a stale prompt behind. Every normal
                # path clears pending already, so this only covers abrupt
                # exits such as interpreter shutdown.
                if (
                    record.pending is not None
                    and record.pending["serial"] == serial
                ):
                    record.pending = None
                    bot.cond.notify_all()

    def load_state(self, identifier, default=None, task_name=None):
        target = self._resolve_state_task(task_name)
        raw = self._bot.store.load(target, identifier, default=None)
        return default if raw is None else raw

    def save_state(self, identifier, data):
        self._bot.store.save(self._record.name, identifier, data)

    def state_path(self, identifier):
        return self._bot.store.resolve(self._record.name, identifier)

    def delete_state(self, identifier):
        return self._bot.store.delete(self._record.name, identifier)

    def list_states(self, task_name=None):
        return self._bot.store.list(self._resolve_state_task(task_name))

    def _resolve_state_task(self, task_name):
        # Returns the task whose state a read targets: the running task when
        # task_name is None, else the named task. A shorthand counts as its
        # task name. Writes always target the running task, so a task can
        # read another task's state but never write it.
        if task_name is None:
            return self._record.name
        if not isinstance(task_name, str) or not TASK_NAME_PATTERN.fullmatch(
            task_name
        ):
            raise ValueError(f"invalid task name {task_name!r}")
        try:
            specs = discover_tasks(self._bot.tasks_dir)
        except Exception:
            return task_name
        spec = resolve_task_spec(specs, task_name)
        if spec is not None:
            return spec.name
        return task_name

    def _check(self):
        if self._in_shutdown:
            if self._bot.stopping.is_set():
                raise TaskKilled("the bot is stopping")
            return
        record = self._record
        with self._bot.lock:
            abort = record.abort
            if abort == "cancelled":
                raise TaskCancelled("the task was cancelled")
            if abort == "timeout":
                raise TaskTimeout("the task timed out")
            if abort == "shutdown" or self._bot.stopping.is_set():
                raise TaskKilled("the bot is stopping")
            if time.monotonic() >= record.overall_deadline:
                self._bot.set_abort_locked(record, "timeout")
                raise TaskTimeout("the run budget is exhausted")


# -----------------------------------------------------------------------------
# Bot.
# -----------------------------------------------------------------------------


class Bot:
    def __init__(
        self,
        token,
        allowed_chats,
        tasks_dir,
        state_base,
        poll_timeout=30.0,
        default_ask_timeout=300.0,
        default_run_timeout=3600.0,
        shutdown_timeout=60.0,
        heartbeat_url=None,
        heartbeat_interval=300.0,
        recent_window=30.0,
        schedule_interval=5.0,
    ):
        self.api = TelegramApi(token)
        self.allowed_chats = list(allowed_chats)
        self.tasks_dir = tasks_dir
        self.store = StateStore(state_base)
        self.poll_timeout = poll_timeout
        self.default_ask_timeout = default_ask_timeout
        self.default_run_timeout = default_run_timeout
        self.shutdown_timeout = shutdown_timeout
        self.heartbeat_url = heartbeat_url
        self.heartbeat_interval = heartbeat_interval
        self.recent_window = recent_window
        self.schedule_interval = schedule_interval
        self.schedule_state_path = os.path.join(
            self.store.base_dir, SCHEDULE_STATE_FILENAME
        )
        # Last dispatch epoch per task, for manual and scheduled runs alike.
        self.schedule_last = {}
        # Monotonic time of the last bad-schedule warning per task.
        self.schedule_warned_at = {}
        self.poll_state_path = os.path.join(
            self.store.base_dir, POLL_STATE_FILENAME
        )
        # Last saved offset, the first update identifier still wanted at the
        # time of the save. None when nothing was saved yet.
        self.saved_offset = None
        self.lock = threading.Lock()
        self.cond = threading.Condition(self.lock)
        self.stopping = threading.Event()
        self.current = None
        self.last_summary = None
        self.last_time = None
        self.start_mono = time.monotonic()
        # Wall time of the start. Backlog older than the recent window
        # relative to this moment is discarded wherever it is met.
        self.started_at = time.time()

    # -- serving ----------------------------------------------------------

    def serve(self):
        try:
            signal.signal(signal.SIGTERM, self.handle_signal)
        except (OSError, ValueError):
            pass
        try:
            offset = self.drain_pending(self.load_saved_offset())
        except BotError as error:
            log(f"Error: cannot reach Telegram: {error}")
            return 1
        specs = discover_tasks(self.tasks_dir)
        if not os.path.isdir(self.tasks_dir):
            log(
                f"Warning: tasks directory {self.tasks_dir} does not exist. "
                "Create it and add <name>.py files."
            )
        else:
            log(f"Loaded {len(specs)} task(s) from {self.tasks_dir}")
        log(
            f"Allowing {len(self.allowed_chats)} chat(s). "
            "Polling Telegram for updates."
        )
        self.load_schedule_state()
        self.register_commands()
        self.start_heartbeat()
        self.start_scheduler()
        self.send_heartbeat()
        backoff = 0
        try:
            while not self.stopping.is_set():
                try:
                    params = {
                        "timeout": int(self.poll_timeout),
                        "allowed_updates": list(MESSAGE_KEYS),
                    }
                    if offset is not None:
                        params["offset"] = offset
                    updates = self.api.call(
                        "getUpdates",
                        params,
                        http_timeout=self.poll_timeout + 15.0,
                    )
                except ApiError as error:
                    if error.code == 401:
                        log(
                            "Error: Telegram rejected "
                            "the token (401). Stopping."
                        )
                        self.stopping.set()
                        return 1
                    if error.code == 409:
                        log(
                            "Warning: another process polls this bot (409). "
                            "Waiting 15 seconds."
                        )
                        if self.stopping.wait(15.0):
                            break
                        continue
                    if error.code == 429:
                        wait_for = error.retry_after or 30.0
                        log(
                            "Warning: rate limited. "
                            f"Waiting {wait_for} seconds."
                        )
                        if self.stopping.wait(float(wait_for)):
                            break
                        continue
                    log(f"Warning: {error}. Waiting 5 seconds.")
                    if self.stopping.wait(5.0):
                        break
                    continue
                except NetworkError as error:
                    backoff = min(backoff + 1, 5)
                    wait_for = min(2.0**backoff, 30.0)
                    log(f"Warning: {error}. Waiting {wait_for:g} seconds.")
                    if self.stopping.wait(wait_for):
                        break
                    continue
                backoff = 0
                if not isinstance(updates, list):
                    continue
                stale = 0
                for update in updates:
                    if not isinstance(update, dict):
                        continue
                    try:
                        update_id = int(update.get("update_id", 0))
                    except (TypeError, ValueError):
                        continue
                    if offset is None or update_id + 1 > offset:
                        offset = update_id + 1
                    if self.is_stale(update):
                        # Backlog from before the start that the drain never
                        # met, such as after a failed drain call. The offset
                        # still advances past it.
                        stale += 1
                        continue
                    try:
                        self.handle_update(update)
                    except Exception:
                        # One bad update never stops the loop.
                        log("Warning: update handler failed:")
                        traceback.print_exc()
                if stale:
                    log(
                        f"Discarded {stale} stale update(s) "
                        "from before the start."
                    )
                self.save_offset(offset)
                self.check_overall_deadline()
        except KeyboardInterrupt:
            log("Interrupted. Stopping.")
            self.stopping.set()
            self.stop_task("shutdown")
            return 130
        self.stop_task("shutdown")
        return 0

    def handle_signal(self, signum, frame):
        log("Received stop signal. Stopping.")
        self.stopping.set()

    def load_saved_offset(self):
        # Returns the first update identifier still wanted, from the offset
        # saved by the previous run, or None on the first run. Telegram then
        # only returns updates past everything already processed.
        value = read_poll_offset(self.poll_state_path)
        if value is None:
            return None
        self.saved_offset = value + 1
        return self.saved_offset

    def save_offset(self, offset):
        # Persists the first update identifier still wanted, so the next
        # start replays nothing already processed. A failure only warns.
        if offset is None or offset == self.saved_offset:
            return
        try:
            write_poll_offset(self.poll_state_path, offset - 1)
        except OSError as error:
            log(f"Warning: cannot save poll state: {error}")
            return
        self.saved_offset = offset

    def is_stale(self, update):
        # Whether update is backlog from before the start and outside the
        # recent window. Such updates are discarded everywhere they are met,
        # even when never processed, so a restart never replays a stale
        # command or a stale reply. Messages without a date count as stale.
        # Live traffic always passes, since its time is past the start.
        stamp = message_time(update)
        if stamp is None:
            return True
        return stamp < self.started_at - self.recent_window

    def drain_pending(self, start_offset):
        # Handles the backlog that arrived while the bot was away. Updates
        # already processed by the previous run never return, because the
        # call starts past the saved offset. Of the rest, recent messages go
        # through normal handling and older ones are discarded, so a restart
        # never replays a stale command or a stale reply. Returns the offset to
        # poll from. A message that arrives between two polls needs no such
        # filter: Telegram holds unacknowledged updates, and the next poll
        # returns them through the offset.
        offset = start_offset
        processed = 0
        discarded = 0
        while True:
            params = {"timeout": 0}
            if offset is not None:
                params["offset"] = offset
            try:
                updates = self.api.call(
                    "getUpdates", params, http_timeout=15.0
                )
            except ApiError as error:
                if error.code == 401:
                    raise
                log(f"Warning: cannot drain pending updates: {error}")
                self.save_offset(offset)
                return offset
            except NetworkError as error:
                log(f"Warning: cannot drain pending updates: {error}")
                self.save_offset(offset)
                return offset
            if not isinstance(updates, list) or not updates:
                break
            for update in updates:
                if not isinstance(update, dict):
                    continue
                try:
                    update_id = int(update.get("update_id", 0))
                except (TypeError, ValueError):
                    continue
                offset = update_id + 1
                if not self.is_stale(update):
                    processed += 1
                    try:
                        self.handle_update(update)
                    except Exception:
                        log("Warning: update handler failed:")
                        traceback.print_exc()
                else:
                    discarded += 1
            if len(updates) < 100:
                break
        if processed or discarded:
            log(
                f"Startup backlog: processed {processed} recent update(s), "
                f"discarded {discarded} stale one(s)."
            )
        self.save_offset(offset)
        return offset

    # -- sending ----------------------------------------------------------

    def register_commands(self):
        # Publishes the command menu via setMyCommands, so clients show
        # the commands in the menu and autocomplete. Task commands come
        # first, sorted alphabetically, then the other commands, also
        # sorted alphabetically. A failure only warns, so polling still
        # starts without a menu. Telegram menu commands allow only
        # lowercase letters, digits, and underscores, so hyphens in task
        # names become underscores here (budget-sync runs as /budget_sync
        # in the menu, while the chat still accepts /budget-sync too).
        specs = discover_tasks(self.tasks_dir)
        seen = {}
        for name in sorted(specs):
            menu_command = menu_command_for_task(name)
            if not menu_command:
                log(
                    f"Warning: task {name!r} has no valid Telegram "
                    "menu command, skipping it in the menu."
                )
                continue
            if menu_command in seen:
                log(
                    f"Warning: tasks {seen[menu_command]!r} and {name!r} "
                    f"share the menu command /{menu_command}, keeping "
                    "the first in sorted order."
                )
                continue
            seen[menu_command] = name
        builtin_names = {name for name, _description in BOT_COMMANDS}
        task_commands = []
        for menu_command in sorted(seen):
            if menu_command in builtin_names:
                log(
                    f"Warning: task {seen[menu_command]!r} shares its menu "
                    f"command /{menu_command} with a built-in command, "
                    "skipping it in the menu."
                )
                continue
            task_name = seen[menu_command]
            description = specs[task_name].description or f"run {task_name}"
            task_commands.append(
                {"command": menu_command, "description": description[:256]}
            )
        other_commands = [
            {"command": name, "description": description}
            for name, description in sorted(BOT_COMMANDS)
        ]
        commands = task_commands + other_commands
        try:
            self.api.call("setMyCommands", {"commands": commands})
        except BotError as error:
            log(f"Warning: cannot set bot commands: {error}")
        else:
            log(f"Registered {len(commands)} bot command(s) with Telegram.")

    def send_text(self, chat_id, text):
        if not isinstance(text, str):
            text = str(text)
        if not text:
            text = "(empty message)"
        last_id = None
        for chunk in split_text(text):
            result = self.api.call(
                "sendMessage", {"chat_id": chat_id, "text": chunk}
            )
            if isinstance(result, dict) and isinstance(
                result.get("message_id"), int
            ):
                last_id = result["message_id"]
        return last_id

    def try_send(self, chat_id, text):
        try:
            self.send_text(chat_id, text)
        except BotError as error:
            log(f"Warning: cannot send message: {error}")

    # -- updates ----------------------------------------------------------

    def handle_update(self, update):
        message = None
        for key in MESSAGE_KEYS:
            candidate = update.get(key)
            if isinstance(candidate, dict):
                message = candidate
                break
        if message is None:
            return
        chat = message.get("chat")
        chat_id = chat.get("id") if isinstance(chat, dict) else None
        if not isinstance(chat_id, int) or chat_id not in self.allowed_chats:
            log("Ignoring update from an unauthorized chat.")
            return
        text = message.get("text")
        if text is None:
            text = message.get("caption")
        if not isinstance(text, str):
            self.handle_non_text(chat_id)
            return
        text = text.strip()
        if not text:
            return
        if text.startswith("/"):
            self.handle_command(chat_id, text)
            return
        if self.deliver_to_task(chat_id, text):
            return
        with self.lock:
            running = (
                self.current if self.is_alive_locked(self.current) else None
            )
            waiting = running is not None and running.pending is not None
        if running is not None:
            if waiting:
                return
            self.try_send(
                chat_id,
                f"Task {running.name} is running. It waits for no "
                "input right now.",
            )
            return
        self.try_send(chat_id, "Send /help to see commands.")

    def handle_non_text(self, chat_id):
        with self.lock:
            running = (
                self.current if self.is_alive_locked(self.current) else None
            )
            waiting = running is not None and running.pending is not None
        if waiting:
            self.try_send(chat_id, "The task waits for a text reply.")

    def handle_command(self, chat_id, text):
        try:
            parts = shlex.split(text)
        except ValueError:
            parts = text.split()
        if not parts:
            return
        command = parts[0][1:].split("@", 1)[0].lower()
        arguments = parts[1:]
        if command == "help":
            self.try_send(chat_id, self.help_text())
        elif command == "status":
            self.try_send(chat_id, self.status_text())
        elif command == "cancel":
            self.handle_cancel(chat_id)
        else:
            specs = discover_tasks(self.tasks_dir)
            spec = build_task_command_map(specs).get(command)
            if spec is None:
                self.try_send(
                    chat_id, f"Unknown command /{command}. Try /help."
                )
                return
            self.launch_task(chat_id, spec, arguments)

    def help_text(self):
        specs = discover_tasks(self.tasks_dir)
        lines = ["Commands:"]
        seen = {}
        for name in sorted(specs):
            menu_command = menu_command_for_task(name)
            if not menu_command:
                continue
            if menu_command not in seen:
                seen[menu_command] = name
        builtin_names = {name for name, _description in BOT_COMMANDS}
        for menu_command in sorted(seen):
            if menu_command in builtin_names:
                continue
            name = seen[menu_command]
            spec = specs[name]
            alias_names = []
            if name.lower() != menu_command:
                alias_names.append(name.lower())
            for shorthand in sorted(spec.shorthands):
                for alias in (
                    shorthand.lower(),
                    menu_command_for_task(shorthand),
                ):
                    if (
                        alias
                        and alias != menu_command
                        and alias not in alias_names
                    ):
                        alias_names.append(alias)
            if alias_names:
                joined = ", ".join(
                    f"/{alias}" for alias in alias_names
                )
                prefix = f"/{menu_command}, {joined}"
            else:
                prefix = f"/{menu_command}"
            if spec.description:
                lines.append(f"{prefix} - {spec.description}")
            else:
                lines.append(prefix)
        for name, description in sorted(BOT_COMMANDS):
            lines.append(f"/{name} - {description}")
        return "\n".join(lines)

    def status_text(self):
        uptime = format_duration(time.monotonic() - self.start_mono)
        with self.lock:
            running = (
                self.current if self.is_alive_locked(self.current) else None
            )
            if running is not None:
                elapsed = format_duration(
                    time.monotonic() - running.start_mono
                )
                phase = (
                    "waiting for a reply"
                    if running.pending is not None
                    else running.phase
                )
                running_line = f"Running: {running.name} ({elapsed}, {phase})"
            else:
                running_line = "Running: none"
            last_summary = self.last_summary
            last_time = self.last_time
        lines = [f"Uptime: {uptime}", running_line]
        specs = discover_tasks(self.tasks_dir)
        lines.append(f"Tasks: {len(specs)} available")
        lines.extend(self.scheduled_lines())
        if last_summary is not None and last_time is not None:
            age = format_duration(time.time() - last_time)
            lines.append(f"Last: {last_summary} ({age} ago)")
        return "\n".join(lines)

    def scheduled_lines(self):
        # One line per scheduled task with its next run, soonest first.
        now = time.time()
        specs = discover_tasks(self.tasks_dir)
        with self.lock:
            last_map = dict(self.schedule_last)
        entries = []
        for name in sorted(specs):
            spec = specs[name]
            shown = display_task_name(spec)
            try:
                expr, _args = read_task_schedule(spec.path)
            except TaskLoadError:
                entries.append((None, f"Scheduled: {shown}: bad schedule"))
                continue
            if expr is None:
                continue
            last = last_map.get(name)
            if last is None:
                entries.append(
                    (
                        None,
                        f"Scheduled: {shown}: waits "
                        f"for the first tick ({expr})",
                    )
                )
                continue
            try:
                next_at = cron_next_after(expr, last)
            except Exception:
                entries.append(
                    (None, f"Scheduled: {shown}: bad schedule ({expr})")
                )
                continue
            if next_at <= now:
                entries.append((0.0, f"Scheduled: {shown}: due now ({expr})"))
            else:
                entries.append(
                    (
                        next_at - now,
                        f"Scheduled: {shown}: in "
                        f"{format_duration(next_at - now)} ({expr})",
                    )
                )
        entries.sort(key=lambda item: (item[0] is None, item[0] or 0.0))
        return [line for _key, line in entries]

    # -- running tasks ----------------------------------------------------

    def launch_task(self, chat_id, spec, task_args):
        # Starts one manual run. Returns True when the run started. Sends
        # the busy notice and returns False when another task won the race.
        run_timeout = read_task_timeout(spec.path, self.default_run_timeout)
        record = RunRecord(
            name=spec.name,
            args=list(task_args),
            chat_id=chat_id,
            run_timeout=run_timeout,
        )
        thread = threading.Thread(
            target=self.worker,
            args=(record, spec),
            daemon=True,
            name=f"telegram-task-{spec.name}",
        )
        with self.lock:
            if self.is_alive_locked(self.current):
                if self.current is not None:
                    self.try_send_locked(
                        chat_id,
                        f"Task {self.current.name} already runs. Wait "
                        "for it or send /cancel.",
                    )
                else:
                    self.try_send_locked(
                        chat_id, "Another task started first. Try again."
                    )
                return False
            record.thread = thread
            self.current = record
            # A manual run counts as an execution, so a schedule never fires
            # right after a manual run of the same task.
            self.schedule_last[record.name] = time.time()
        self.save_schedule_state()
        log(f"task {spec.name}: started by chat, budget {run_timeout:g}s")
        thread.start()
        return True

    def handle_cancel(self, chat_id):
        with self.lock:
            if not self.is_alive_locked(self.current):
                self.try_send_locked(chat_id, "No task is running.")
                return
            name = self.current.name
            self.set_abort_locked(self.current, "cancelled")
            self.cond.notify_all()
        log(f"task {name}: cancel requested")
        self.try_send(chat_id, f"Cancelling task {name}.")

    def deliver_to_task(self, chat_id, text):
        # Routes a reply to the waiting ask. Returns True when consumed. The
        # reply content is never logged.
        with self.lock:
            record = self.current
            if record is None or not self.is_alive_locked(record):
                return False
            if record.chat_id != chat_id:
                return False
            if record.pending is None:
                return False
            if record.pending["reply"] is not None:
                return True
            record.pending["reply"] = text.strip()
            self.cond.notify_all()
            return True

    def check_overall_deadline(self):
        expired = None
        with self.lock:
            record = self.current
            if (
                record is not None
                and record.abort is None
                and self.is_alive_locked(record)
                and time.monotonic() >= record.overall_deadline
            ):
                record.abort = "timeout"
                self.cond.notify_all()
                expired = record
        if expired is not None:
            # The failure report goes out when the worker finishes. The
            # chat stays quiet until then.
            log(f"task {expired.name}: run budget exhausted")

    def set_abort_locked(self, record, reason):
        if record.abort is None:
            record.abort = reason

    def set_abort(self, record, reason):
        with self.lock:
            self.set_abort_locked(record, reason)
            self.cond.notify_all()

    def is_alive_locked(self, record):
        return (
            record is not None
            and record.thread is not None
            and record.thread.is_alive()
        )

    def try_send_locked(self, chat_id, text):
        # Called with the lock held. Sending can block on the network, so
        # release the lock around the call.
        self.lock.release()
        try:
            self.try_send(chat_id, text)
        finally:
            self.lock.acquire()

    def stop_task(self, reason):
        with self.lock:
            record = self.current
            if not self.is_alive_locked(record):
                return
            self.set_abort_locked(
                record, "shutdown" if reason == "shutdown" else reason
            )
            self.cond.notify_all()
            thread = record.thread
        grace = self.shutdown_timeout + 15.0
        thread.join(timeout=grace)
        if thread.is_alive():
            log("Warning: task thread did not stop within the grace period.")

    def worker(self, record, spec):
        # Loading and dependency installation happen here, in the worker
        # thread, so a slow index never blocks command handling.
        added_path = None
        try:
            added_path = self.prepare_task_env(record, spec)
            module, shutdown_fn, _timeout = load_task_module(spec)
        except TaskLoadError as error:
            log(f"task {record.name}: {error}")
            self.report(record, "error", str(error))
            with self.lock:
                if self.current is record:
                    self.current = None
                self.last_summary = f"{record.name} error"
                self.last_time = time.time()
            if added_path is not None:
                try:
                    sys.path.remove(added_path)
                except ValueError:
                    pass
            return
        record.phase = "running"
        ctx = TaskContext(self, record)
        outcome = "done"
        error_text = None
        try:
            call_task_function(module.run, ctx, record.args)
            with self.lock:
                outcome = record.abort if record.abort is not None else "done"
        except TaskTimeout:
            self.set_abort(record, "timeout")
            with self.lock:
                outcome = record.abort or "timeout"
        except TaskCancelled:
            with self.lock:
                outcome = record.abort or "cancelled"
                if outcome not in REASONS:
                    outcome = "cancelled"
        except TaskKilled:
            with self.lock:
                outcome = record.abort or "shutdown"
        except Exception as error:
            outcome = "error"
            error_text = f"{type(error).__name__}: {error}"
            log(f"task {record.name}: run failed:")
            traceback.print_exc()
        record.phase = "finishing"
        if callable(shutdown_fn):
            shutdown_ctx = TaskContext(self, record, in_shutdown=True)
            try:
                call_task_function(shutdown_fn, shutdown_ctx, outcome)
            except (TaskKilled, TaskCancelled, TaskTimeout) as error:
                log(f"task {record.name}: shutdown hook interrupted: {error}")
            except Exception as error:
                log(f"task {record.name}: shutdown hook failed: {error}")
                traceback.print_exc()
        self.report(record, outcome, error_text)
        with self.lock:
            if self.current is record:
                self.current = None
            elapsed = time.monotonic() - record.start_mono
            self.last_summary = (
                f"{record.name} {outcome} in {format_duration(elapsed)}"
            )
            self.last_time = time.time()
        if added_path is not None:
            try:
                sys.path.remove(added_path)
            except ValueError:
                pass

    def prepare_task_env(self, record, spec):
        # Reads the PEP 723 dependencies of the task and installs them into
        # the venv of the task. Returns the site-packages directory put on
        # sys.path, or None when the task declares none.
        dependencies = read_task_dependencies(spec.path)
        if dependencies:
            log(
                f"task {record.name}: ensuring "
                f"{len(dependencies)} dependencies"
            )
        site_packages = ensure_task_env(
            self.store.base_dir, record.name, dependencies
        )
        if site_packages is None or site_packages in sys.path:
            return None
        sys.path.insert(0, site_packages)
        return site_packages

    def report(self, record, outcome, error_text):
        # Only failures reach the chat: an error or a timeout always sends
        # a message, while done, cancelled and shutdown stay silent. The
        # log records every outcome, and /status still shows the last one.
        if outcome == "error":
            detail = (error_text or "unknown error").splitlines()
            first_line = detail[0] if detail else "unknown error"
            text = f"Task {record.name} failed: " + truncate(
                first_line, ERROR_PREVIEW_LIMIT
            )
        elif outcome == "timeout":
            text = (
                f"Task {record.name} timed out after "
                f"{format_duration(record.run_timeout)}. It was stopped."
            )
        else:
            text = None
        log(f"task {record.name}: {outcome}")
        if text is None:
            return
        try:
            self.send_text(record.chat_id, text)
        except BotError as error:
            log(f"Warning: cannot report task {record.name}: {error}")

    # -- scheduled tasks --------------------------------------------------

    def load_schedule_state(self):
        with self.lock:
            self.schedule_last = read_schedule_state(self.schedule_state_path)

    def save_schedule_state(self):
        with self.lock:
            snapshot = dict(self.schedule_last)
        try:
            write_schedule_state(self.schedule_state_path, snapshot)
        except OSError as error:
            log(f"Warning: cannot save schedule state: {error}")

    def warn_schedule(self, name, message):
        # Warns about a bad SCHEDULE at most once per hour per task, so one
        # broken file cannot fill the log every few seconds.
        now_mono = time.monotonic()
        with self.lock:
            last = self.schedule_warned_at.get(name)
            if last is not None and now_mono - last < SCHEDULE_WARN_INTERVAL:
                return
            self.schedule_warned_at[name] = now_mono
        log(f"Warning: {message}")

    def start_scheduler(self):
        thread = threading.Thread(
            target=self.scheduler_loop, daemon=True, name="telegram-scheduler"
        )
        thread.start()

    def scheduler_loop(self):
        while not self.stopping.is_set():
            if self.stopping.wait(self.schedule_interval):
                break
            try:
                self.check_schedules()
            except Exception:
                # One bad check never stops the scheduler.
                log("Warning: schedule check failed:")
                traceback.print_exc()

    def check_schedules(self, now=None):
        # Starts the most overdue scheduled task when idle. A dispatch stamps
        # last with now, so skipped executions coalesce instead of bursting:
        # a task runs at most once per check. A busy bot leaves due tasks
        # for the next check.
        if now is None:
            now = time.time()
        specs = discover_tasks(self.tasks_dir)
        due = []
        baselined = False
        for name in sorted(specs):
            spec = specs[name]
            try:
                expr, args = read_task_schedule(spec.path)
            except TaskLoadError as error:
                self.warn_schedule(
                    name, f"task {name} has a bad schedule: {error}"
                )
                continue
            if expr is None:
                continue
            with self.lock:
                last = self.schedule_last.get(name)
            if last is None:
                # A new schedule waits for its next tick instead of running
                # at once.
                with self.lock:
                    if self.schedule_last.get(name) is None:
                        self.schedule_last[name] = now
                        baselined = True
                continue
            try:
                next_at = cron_next_after(expr, last)
            except Exception as error:
                self.warn_schedule(
                    name, f"task {name} has bad SCHEDULE {expr!r}: {error}"
                )
                continue
            if next_at <= now:
                due.append((now - next_at, name, spec, args))
        if baselined:
            self.save_schedule_state()
        if not due:
            return
        due.sort(key=lambda item: (-item[0], item[1]))
        for _overdue, _name, spec, args in due:
            if self.start_scheduled_task(spec, args, now):
                break

    def start_scheduled_task(self, spec, args, now):
        # Starts one scheduled run when no task runs. Returns True when the
        # run started. Stamps last at dispatch, even when loading later
        # fails, so a broken task cannot error every few seconds.
        run_timeout = read_task_timeout(spec.path, self.default_run_timeout)
        with self.lock:
            if self.is_alive_locked(self.current):
                return False
            if not self.allowed_chats:
                return False
            chat_id = self.allowed_chats[0]
            record = RunRecord(
                name=spec.name,
                args=list(args),
                chat_id=chat_id,
                run_timeout=run_timeout,
            )
            thread = threading.Thread(
                target=self.worker,
                args=(record, spec),
                daemon=True,
                name=f"telegram-task-{spec.name}",
            )
            record.thread = thread
            self.current = record
            self.schedule_last[spec.name] = now
        self.save_schedule_state()
        log(f"task {spec.name}: scheduled start, budget {run_timeout:g}s")
        thread.start()
        return True

    # -- heartbeat --------------------------------------------------------

    def start_heartbeat(self):
        if not self.heartbeat_url:
            return
        thread = threading.Thread(
            target=self.heartbeat_loop, daemon=True, name="telegram-heartbeat"
        )
        thread.start()

    def send_heartbeat(self):
        if not self.heartbeat_url:
            return
        try:
            request = urllib.request.Request(self.heartbeat_url, method="GET")
            with urllib.request.urlopen(request, timeout=10.0) as response:
                response.read(1024)
        except Exception as error:
            log(f"Warning: heartbeat ping failed: {error}")

    def heartbeat_loop(self):
        while not self.stopping.is_set():
            if self.stopping.wait(self.heartbeat_interval):
                break
            self.send_heartbeat()


# -----------------------------------------------------------------------------
# State transfer.
# -----------------------------------------------------------------------------


def collect_export_files(base_dir):
    # Returns the sorted relative paths to store in an export: the poll
    # offset, the schedule state, and every task state file. Venvs are left
    # out, since the next run rebuilds them from DEPENDENCIES. Dotfiles are
    # left out, since they are temporary files of atomic writes. Symlinks are
    # left out, since tasks store plain files. Missing files are skipped, so
    # a fresh state directory still exports.
    found = []
    for name in (POLL_STATE_FILENAME, SCHEDULE_STATE_FILENAME):
        full = os.path.join(base_dir, name)
        try:
            if os.path.isfile(full) and not os.path.islink(full):
                found.append(name)
        except OSError:
            continue
    tasks_root = os.path.join(base_dir, "tasks")
    try:
        walker = os.walk(tasks_root)
    except OSError:
        walker = None
    if walker is not None:
        for current, directories, files in walker:
            directories[:] = sorted(
                name
                for name in directories
                if not name.startswith(".") and name not in ("__pycache__")
            )
            for name in sorted(files):
                if name.startswith("."):
                    continue
                full = os.path.join(current, name)
                try:
                    if os.path.islink(full) or not os.path.isfile(full):
                        continue
                except OSError:
                    continue
                found.append(os.path.relpath(full, base_dir))
    return sorted(found)


def export_state_dir(base_dir, dest_path, overwrite=False):
    # Writes every export file under base_dir into the zip at dest_path, and
    # returns how many state files were stored, not counting the manifest.
    # Raises BotError on failure. The write is atomic: the zip goes to a
    # temporary file in the destination directory first.
    base_dir = os.path.abspath(base_dir)
    dest_path = os.path.abspath(dest_path)
    if os.path.isdir(dest_path):
        raise BotError(f"cannot export to {dest_path}: it is a directory")
    if os.path.exists(dest_path) and not overwrite:
        raise BotError(
            f"{dest_path} already exists, pass --force to replace it"
        )
    parent = os.path.dirname(dest_path)
    if parent:
        try:
            os.makedirs(parent, exist_ok=True)
        except OSError as error:
            raise BotError(f"cannot prepare {parent}: {error}") from error
    names = collect_export_files(base_dir)
    manifest = {
        "version": EXPORT_VERSION,
        "tool": "telegram_bot",
        "created_at": datetime.datetime.now(datetime.UTC).isoformat(),
        "files": names,
    }
    try:
        descriptor, temp_path = tempfile.mkstemp(
            dir=parent or ".", prefix=".telegram-bot-export-", suffix=".zip"
        )
    except OSError as error:
        raise BotError(f"cannot export to {dest_path}: {error}") from error
    try:
        os.close(descriptor)
    except OSError:
        pass
    try:
        try:
            with zipfile.ZipFile(
                temp_path, "w", zipfile.ZIP_DEFLATED
            ) as archive:
                info = zipfile.ZipInfo(EXPORT_MANIFEST_NAME)
                info.external_attr = (0o600 & 0xFFFF) << 16
                archive.writestr(
                    info,
                    (
                        json.dumps(manifest, indent=2, sort_keys=True) + "\n"
                    ).encode("utf-8"),
                )
                for name in names:
                    archive.write(os.path.join(base_dir, name), name)
        except (OSError, ValueError) as error:
            raise BotError(f"cannot export to {dest_path}: {error}") from error
        try:
            os.chmod(temp_path, 0o600)
            os.replace(temp_path, dest_path)
        except OSError as error:
            raise BotError(f"cannot export to {dest_path}: {error}") from error
    finally:
        try:
            os.remove(temp_path)
        except OSError:
            pass
    try:
        os.chmod(dest_path, 0o600)
    except OSError:
        pass
    return len(names)


def check_export_entry(name):
    # Returns the relative path for the zip entry name, or raises BotError
    # when the entry would escape the state directory. Zip names always use
    # forward slashes, so a backslash stays a plain filename character.
    if not name or "\0" in name or name.startswith("/"):
        raise BotError(f"bad entry {name!r} in the export")
    parts = name.split("/")
    if any(part in ("", ".", "..") for part in parts):
        raise BotError(f"bad entry {name!r} in the export")
    return name


def import_state_dir(base_dir, src_path):
    # Restores the export zip at src_path into base_dir, and returns how many
    # state files were restored, not counting the manifest. Replaces the poll
    # offset, the schedule state, and the tasks tree, while it leaves venvs
    # alone. Raises BotError on failure. The caller must stop the bot first.
    base_dir = os.path.abspath(base_dir)
    try:
        archive = zipfile.ZipFile(src_path)
    except FileNotFoundError:
        raise BotError(f"{src_path} does not exist") from None
    except (OSError, zipfile.BadZipFile) as error:
        raise BotError(f"cannot read {src_path}: {error}") from error
    with archive:
        try:
            infos = archive.infolist()
        except (OSError, ValueError) as error:
            raise BotError(f"cannot read {src_path}: {error}") from error
        manifest = None
        for info in infos:
            if info.filename == EXPORT_MANIFEST_NAME:
                try:
                    manifest = json.loads(
                        archive.read(info.filename).decode("utf-8")
                    )
                except (OSError, ValueError, UnicodeDecodeError) as error:
                    raise BotError(
                        f"cannot read {src_path}: bad export manifest: {error}"
                    ) from error
                break
        if (
            not isinstance(manifest, dict)
            or manifest.get("version") != EXPORT_VERSION
        ):
            raise BotError(f"{src_path} is not a telegram_bot export")
        planned = []
        for info in infos:
            name = info.filename
            if name == EXPORT_MANIFEST_NAME:
                continue
            if name.endswith("/"):
                name = name.rstrip("/")
                if not name:
                    continue
            cleaned = check_export_entry(name)
            is_dir = info.is_dir()
            if cleaned == "tasks":
                if not is_dir:
                    log(f"Warning: skipping {cleaned!r}, it is not bot state.")
                    continue
            elif cleaned.startswith("tasks/"):
                pass
            elif cleaned in (POLL_STATE_FILENAME, SCHEDULE_STATE_FILENAME):
                if is_dir:
                    log(f"Warning: skipping {cleaned!r}, it is not bot state.")
                    continue
            else:
                log(f"Warning: skipping {cleaned!r}, it is not bot state.")
                continue
            if (info.external_attr >> 16) & 0o170000 == 0o120000:
                raise BotError(
                    f"bad entry {name!r} in the export: it is a symlink"
                )
            planned.append((info, cleaned))
        try:
            ensure_dir(base_dir)
        except SystemExit as error:
            raise BotError(f"cannot prepare {base_dir}") from error
        tasks_root = os.path.join(base_dir, "tasks")
        try:
            if os.path.isdir(tasks_root) and not os.path.islink(tasks_root):
                shutil.rmtree(tasks_root)
            for name in (POLL_STATE_FILENAME, SCHEDULE_STATE_FILENAME):
                try:
                    if os.path.islink(os.path.join(base_dir, name)):
                        os.remove(os.path.join(base_dir, name))
                    else:
                        try:
                            os.remove(os.path.join(base_dir, name))
                        except FileNotFoundError:
                            pass
                except OSError as error:
                    raise BotError(
                        f"cannot clear {os.path.join(base_dir, name)}: {error}"
                    ) from error
        except BotError:
            raise
        except OSError as error:
            raise BotError(f"cannot clear {base_dir}: {error}") from error
        count = 0
        for info, cleaned in planned:
            target = os.path.realpath(os.path.join(base_dir, cleaned))
            root = os.path.realpath(base_dir)
            if target != root and not target.startswith(root + os.sep):
                raise BotError(f"bad entry {cleaned!r} in the export")
            try:
                if info.is_dir():
                    os.makedirs(target, mode=0o700, exist_ok=True)
                    os.chmod(target, 0o700)
                    continue
                os.makedirs(
                    os.path.dirname(target) or base_dir,
                    mode=0o700,
                    exist_ok=True,
                )
                with (
                    archive.open(info) as source,
                    open(target, "wb") as handle,
                ):
                    shutil.copyfileobj(source, handle, length=1024 * 64)
                os.chmod(target, 0o600)
                count += 1
            except (OSError, ValueError) as error:
                raise BotError(
                    f"cannot restore {cleaned!r} from {src_path}: {error}"
                ) from error
        return count


# -----------------------------------------------------------------------------
# Generic helpers.
# -----------------------------------------------------------------------------


def log(message):
    print(f"telegram_bot: {message}", file=sys.stderr, flush=True)


def die(message):
    log(f"Error: {message}")
    sys.exit(1)


def format_duration(seconds):
    total = max(0, int(seconds))
    hours, rest = divmod(total, 3600)
    minutes, seconds = divmod(rest, 60)
    if hours:
        return f"{hours}h{minutes}m{seconds}s"
    if minutes:
        return f"{minutes}m{seconds}s"
    return f"{seconds}s"


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        # Ctrl-C during startup. The shell convention for SIGINT is 128 + 2.
        sys.exit(130)
    except BrokenPipeError:
        null_descriptor = os.open(os.devnull, os.O_WRONLY)
        os.dup2(null_descriptor, sys.stdout.fileno())
        sys.exit(141)
