#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["click>=8.1,<9"]
# ///

# vim: ft=python

# Help comes from `pending_devel --help`. The main command below holds the
# text.

import concurrent.futures
import os
import subprocess
import sys

import click

BAR_WIDTH = 40
MAX_STATUS_LINES = 10


def list_project_dirs(devel_dir):
    # Returns the sorted relative paths of projects under `devel_dir`.
    # A project holds `.git` and lacks `.list_project_dirs_ignore`.
    # The scan skips a link that lacks both markers.
    # The scan enters other directories to find nested projects.
    projects = []

    def walk(current_dir):
        try:
            names = os.listdir(current_dir)
        except OSError:
            return
        for name in names:
            full_path = os.path.join(current_dir, name)
            try:
                if not os.path.isdir(full_path):
                    continue
            except OSError:
                continue
            git_marker = os.path.join(full_path, ".git")
            ignore_marker = os.path.join(
                full_path, ".list_project_dirs_ignore"
            )
            if os.path.exists(git_marker) and not os.path.exists(
                ignore_marker
            ):
                projects.append(os.path.relpath(full_path, devel_dir))
            elif os.path.islink(full_path):
                continue
            else:
                walk(full_path)

    walk(devel_dir)
    projects.sort()
    return projects


def git_text(arguments, repo_full_path):
    # Runs `git` with `arguments` in `repo_full_path`.
    # Returns stdout stripped.
    # Returns an empty string when `git` fails or cannot start.
    try:
        result = subprocess.run(
            ["git", *arguments],
            cwd=repo_full_path,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            encoding="utf-8",
            errors="replace",
        )
    except OSError:
        return ""
    if result.returncode != 0:
        return ""
    return result.stdout.strip()


def git_count(arguments, repo_full_path):
    # Runs `git rev-list --count` with `arguments` in `repo_full_path`.
    # Returns the count, or 0 when `git` fails or the output is not a number.
    text = git_text(arguments, repo_full_path)
    try:
        return int(text.strip())
    except ValueError:
        return 0


def is_linked_worktree(repo_full_path):
    # Returns true when `repo_full_path` is a linked worktree.
    # A linked worktree has a git directory distinct from the common directory.
    try:
        result = subprocess.run(
            [
                "git",
                "rev-parse",
                "--path-format=absolute",
                "--git-dir",
                "--git-common-dir",
            ],
            cwd=repo_full_path,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            encoding="utf-8",
            errors="replace",
        )
    except OSError:
        return False
    if result.returncode != 0:
        return False
    git_dirs = result.stdout.splitlines()
    return len(git_dirs) == 2 and git_dirs[0] != git_dirs[1]


def read_main_branch(repo_full_path):
    # Returns the main branch name of `repo_full_path`, or an empty string.
    # The name is the last non-empty line of `git main-branch`.
    text = git_text(["main-branch"], repo_full_path)
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    if not lines:
        return text.strip()
    return lines[-1]


def read_status_lines(repo_full_path):
    # Returns the porcelain status lines of `repo_full_path`.
    # Returns an empty list when the tree is clean or `git` fails.
    text = git_text(["status", "--porcelain"], repo_full_path)
    if not text:
        return []
    return text.splitlines()


def indent_lines(lines):
    # Prefixes each line in `lines` with four spaces and joins them.
    return "\n".join(f"    {line}" for line in lines)


def run_pull(repo_full_path):
    # Runs `git pull --quiet` in `repo_full_path`.
    # Returns success and combined output with no final newline.
    try:
        result = subprocess.run(
            ["git", "pull", "--quiet"],
            cwd=repo_full_path,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            encoding="utf-8",
            errors="replace",
        )
    except OSError as error:
        return False, str(error)
    return result.returncode == 0, result.stdout.strip("\n")


def check_project(repo_relative_path, resolved_devel_dir):
    # Checks one project and returns its findings as a list.
    # Returns an empty list when the project has no open work.
    repo_findings = []
    repo_full_path = os.path.join(resolved_devel_dir, repo_relative_path)
    if not os.path.isdir(repo_full_path):
        return repo_findings
    if is_linked_worktree(repo_full_path):
        return repo_findings

    styled_repo = click.style(repo_relative_path, bold=True)
    main_branch = read_main_branch(repo_full_path)
    status_lines = read_status_lines(repo_full_path)
    if status_lines:
        repo_findings.append(
            f"* {styled_repo}\n\n"
            f"{indent_lines(status_lines[:MAX_STATUS_LINES])}"
        )
        return repo_findings

    should_pull = True
    current_branch = git_text(
        ["rev-parse", "--abbrev-ref", "HEAD"], repo_full_path
    )
    upstream = git_text(
        [
            "rev-parse",
            "--abbrev-ref",
            "--symbolic-full-name",
            "@{upstream}",
        ],
        repo_full_path,
    )
    if upstream:
        ahead = git_count(
            ["rev-list", "--count", "@{upstream}..HEAD"],
            repo_full_path,
        )
        if ahead > 0:
            should_pull = False
            styled_branch = click.style(current_branch, italic=True)
            needs_push = click.style("needs to be pushed", fg="yellow")
            repo_findings.append(
                f"* {styled_repo}\n"
                f"    {styled_branch} {needs_push}, "
                f"{ahead} commit(s) ahead"
            )

    if current_branch != main_branch and main_branch:
        main_upstream = git_text(
            [
                "for-each-ref",
                "--format=%(upstream:short)",
                f"refs/heads/{main_branch}",
            ],
            repo_full_path,
        )
        if main_upstream:
            main_ahead = git_count(
                [
                    "rev-list",
                    "--count",
                    f"{main_upstream}..{main_branch}",
                ],
                repo_full_path,
            )
            if main_ahead > 0:
                styled_main = click.style(main_branch, italic=True)
                needs_push = click.style(
                    "needs to be pushed", fg="yellow"
                )
                repo_findings.append(
                    f"* {styled_repo}\n"
                    f"    {styled_main} {needs_push}, "
                    f"{main_ahead} commit(s) ahead"
                )

    if should_pull:
        pull_ok, pull_output = run_pull(repo_full_path)
        if not pull_ok:
            failed_label = click.style(
                "git pull failed:", fg="red", bold=True
            )
            repo_findings.append(
                f"* {styled_repo}\n"
                f"    {failed_label}\n"
                f"{indent_lines(pull_output.splitlines())}"
            )
        elif current_branch != main_branch:
            if not main_branch:
                pulled_detail = (
                    f"pulled {current_branch} "
                    "(checked-out branch, main branch unknown)"
                )
            else:
                pulled_detail = (
                    f"pulled {current_branch} "
                    f"(checked-out branch, "
                    f"main branch is {main_branch})"
                )
            repo_findings.append(
                f"* {styled_repo}\n    "
                f"{click.style(pulled_detail, fg='green')}"
            )

    return repo_findings


@click.command(context_settings={"help_option_names": ["-h", "--help"]})
def main():
    """Check each project under `~/devel` for work that is not pushed, and pull
    the rest. Report repositories with uncommitted changes, with commits that
    need a push, and with a failed pull. Skip linked worktrees. The main
    repository holds the same state, so a worktree adds nothing to the report.
    """
    home = os.environ.get("HOME")
    if not home:
        raise click.ClickException("HOME is not set")
    devel_dir = os.path.join(home, "devel")
    resolved_devel_dir = os.path.realpath(devel_dir)
    if not os.path.isdir(resolved_devel_dir):
        raise click.ClickException(f"{devel_dir} does not exist.")

    projects = list_project_dirs(resolved_devel_dir)
    total = len(projects)
    styled_devel = click.style("~/devel", bold=True)
    if total == 0:
        click.echo(f"No projects found in {styled_devel}.")
        return

    label = (
        f"Checking for uncommitted changes in {styled_devel} "
        f"repositories ({total} projects)..."
    )
    # One thread per project, at most four threads per core.
    worker_count = (os.cpu_count() or 1) * 4
    findings_by_repo = {}
    with click.progressbar(
        length=total,
        label=label,
        fill_char="=",
        empty_char=" ",
        width=BAR_WIDTH,
        show_eta=False,
        show_percent=False,
        show_pos=True,
        bar_template="%(label)s [%(bar)s] %(info)s",
    ) as bar:
        with concurrent.futures.ThreadPoolExecutor(
            max_workers=worker_count
        ) as pool:
            future_to_repo = {
                pool.submit(
                    check_project,
                    repo_relative_path,
                    resolved_devel_dir,
                ): repo_relative_path
                for repo_relative_path in projects
            }
            for future in concurrent.futures.as_completed(
                future_to_repo
            ):
                done_repo = future_to_repo[future]
                findings_by_repo[done_repo] = future.result()
                bar.update(1)

    findings = [
        finding
        for repo_relative_path in projects
        for finding in findings_by_repo.get(repo_relative_path, [])
    ]

    for finding in findings:
        click.echo()
        click.echo(finding)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        # Ctrl-C at a prompt or during a command. The shell convention for a
        # death by SIGINT is 128 + 2.
        sys.exit(130)
    except BrokenPipeError:
        null_descriptor = os.open(os.devnull, os.O_WRONLY)
        os.dup2(null_descriptor, sys.stdout.fileno())
        sys.exit(141)
