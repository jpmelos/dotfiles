#!/usr/bin/env bash
set -euo pipefail
trap 'echo "Exit status $? at line $LINENO from: $BASH_COMMAND" >&2' ERR

# This continues a Git rebase without a signature.
#
# Run it like `ai_git_rebase_continue`.

if [ $# -ne 0 ]; then
    echo "Error: This command takes no arguments" >&2
    exit 1
fi

# `git rebase --continue` reuses the `gpg_sign_opt` file saved when the rebase
# started, so `-c commit.gpgsign=false` alone does not stop signing.
# Remove the saved option first, then continue with signing disabled.
for state in rebase-merge rebase-apply; do
    if opt_file=$(git rev-parse --git-path \
        "${state}/gpg_sign_opt" 2>/dev/null); then
        rm -f "${opt_file}"
    fi
done

exec git -c commit.gpgsign=false rebase --continue
