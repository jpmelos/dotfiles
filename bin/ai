#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

# vim: ft=python

# / Run Claude Code inside a Docker container.
# /
# / Usage: ai [options] [-- harness-args...]
# / Options:
# /   --profile <name>  Profile to run as. Selects the `~/.claude-<name>`
# /                     directory, with its own login, history, and
# /                     credentials, and the `api_key`, `model`, and
# /                     `mcp_servers` of that profile in `~/config.json`
# /                     (default: the organization directory of the project,
# /                     such as `orgname` for `~/devel/orgname/project`, or
# /                     the user name for a project directly under `~/devel`)
# /   --channel <name>  Claude Code release channel or version to install in
# /                     the image (default: `latest`). Accepts `latest`,
# /                     `stable`, or a version such as `2.1.0`. The channel is
# /                     part of the image tag, so each channel gets its own
# /                     image, and a switch to another channel builds that
# /                     image. The image of a channel is rebuilt once a day.
# /                     The image of a version is not, because a version
# /                     names one release.
# /   --process-output  Capture and process output (requires `--print` and
# /                     `--output-format json` in harness args)
# /   --force-rebuild   Rebuild the Docker image even if it is up to date. The
# /                     build runs without cache, as with `--no-build-cache`,
# /                     because a cached build would install the same release
# /                     again
# /   --no-build-cache  Build from scratch without using cache
# /   --no-rebuild      Skip rebuilding image even if outdated
# /   --allow-stale     If build fails, use existing image (fatal if none
# /                     exists)
# /   --no-docker-socket
# /                     Do not mount the host Docker socket into the container
# /   --verbose         Print the Docker command before running it
# /   --help, -h        Show this help
# /
# / Arguments after `--` are passed directly to Claude Code. The launcher puts
# / `--setting-sources=user` and one `--add-dir` per visible project before
# / them. A `--setting-sources` that you pass wins. An `--add-dir` that you
# / pass adds to the list.
# /
# / A project is a directory that `list_project_dirs` reports. The current
# / directory can be the project root or any directory below it. Both cases
# / behave the same: the profile comes from the root, and the container starts
# / in the root. If run outside of every project, defaults to ~/devel/dotfiles
# / as the project.
# /
# / Security:
# /   The container runs read-only, with an explicit list of mounts. This
# /   limits mistakes. It is not a security boundary.
# /
# /   By default the host Docker socket is mounted and the container joins
# /   group 0 and the group of the socket file. Any process in the container
# /   can then start a privileged container and take control of the host. Use
# /   `--no-docker-socket` for repositories that you do not trust. Docker is
# /   then unavailable inside the container.
# /
# /   The dotfiles repository holds the scripts that the agent calls and the
# /   `.claude-origin` directory that every run copies into the profile. When
# /   the project is not the dotfiles repository, the container sees that
# /   repository read-only, so the agent cannot change the origin. The
# /   launcher warns when `~/.claude-origin` does not resolve into that
# /   repository, because the read-only mount then does not cover it. The copy
# /   overwrites the files that the origin holds, and it mirrors the
# /   directories that the origin holds, so a file that the agent adds to
# /   `~/.claude/commands` does not survive the next run. The rest of the
# /   profile directory is not touched. The `/learn` command writes to the
# /   origin, so it works only from the dotfiles project.
# /
# /   The host directory `/tmp/<user>/<profile>` is mounted at the same path in
# /   every container of the profile, so these containers share it. It carries
# /   state between the container and the host, and it holds the cache
# /   directories of the tools in the image. Any local user can read the state
# /   directories. That is on purpose. Nothing secret goes there. The cache
# /   directories are private. The `AGENT_SHARED_DIR` variable names the
# /   directory where the status line and hook scripts write.
# /
# / tmux:
# /   The container always gets `/tmp/tmux-pane-states`, the directory where
# /   the `pane-state` and `chime` scripts write. Every profile uses that one
# /   directory, so a pane has one state file. When the launcher runs inside
# /   tmux, the container also gets the `TMUX_PANE` variable. The `running`,
# /   `pending`, `ready`, and `default` scripts then mark the pane that runs
# /   the agent, and `pending` and `ready` request the notification chime. The
# /   `pane-state-sync` script on the host picks both up. Outside tmux the
# /   variable is absent, and these scripts do nothing.
# /
# / Configuration:
# /   Reads an optional configuration file at `~/config.json` with API keys
# /   and other configuration. The file must be a regular file, not a link,
# /   owned by you, with no group or other permissions, as with `chmod 600`.
# /
# /   Configuration format:
# /   ```
# /   {
# /     "claude_code": {
# /       "profiles": {
# /         "username": {
# /           "api_key": "sk-...",
# /           "model": "opus",
# /           "mcp_servers": {
# /             "server-name": {"command": "...", "args": ["..."]}
# /           }
# /         },
# /         "orgname": {
# /           "api_key": "sk-..."
# /         }
# /       }
# /     }
# /   }
# /   ```
# /
# /   Every key is optional. A profile without an entry in `profiles` is a
# /   supported configuration. A detected profile without one only warns. An
# /   explicit `--profile` without one is an error when the file has a
# /   `profiles` object, or when the `~/.claude-<name>` directory does not
# /   exist yet, because that is almost always a typo. To start a new profile
# /   without an entry, create the directory first.
# /
# /   Without `api_key`, Claude Code falls back to OAuth credentials or asks
# /   the user to log in. Without `model`, the profile uses the model from
# /   `~/.claude-origin/settings.json`, which every run copies into the
# /   profile. Without `mcp_servers`, the profile keeps the `mcpServers` key
# /   that is already in its `.claude.json`.
# /
# /   The `mcp_servers` object of a profile replaces the `mcpServers` key in
# /   that profile's `.claude.json`.
# /
# /   An `ANTHROPIC_API_KEY` variable in the environment takes precedence over
# /   the `api_key` of the profile. The launcher warns when both are present,
# /   because the account of the environment key pays for the session.

import contextlib
import datetime
import errno
import fcntl
import filecmp
import hashlib
import json
import os
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from decimal import ROUND_CEILING, ROUND_DOWN, Decimal

_MISSING = object()

DOCKERFILE_DIGEST_LABEL = "dockerfile_sha256"
BUILD_DATE_LABEL = "build_date"
DEFAULT_CLAUDE_CODE_CHANNEL = "latest"
# The host directory where the `pane-state` and `chime` scripts write, and
# where `pane-state-sync` reads. The scripts hard-code the same path, so the
# container must see it at the same path. One directory serves every profile,
# so a pane has one state file no matter which profile runs in it.
TMUX_DIR = "/tmp/tmux-pane-states"
# Options of this script that take a value, mapped to the `Options` field that
# holds it. The help scan uses the keys to tell a value from a flag.
VALUE_OPTIONS = {
    "--profile": "profile",
    "--channel": "channel",
}
# Options of this script that take no value, mapped to the `Options` field that
# they turn on.
FLAG_OPTIONS = {
    "--process-output": "process_output",
    "--force-rebuild": "force_rebuild",
    "--no-build-cache": "no_build_cache",
    "--no-rebuild": "no_rebuild",
    "--allow-stale": "allow_stale",
    "--no-docker-socket": "no_docker_socket",
    "--verbose": "verbose",
}
# Variables that the launcher or the image sets for the container. A relay of
# one of these from `AGENTS_ADDITIONAL_ENV_VARS` would replace the value that
# the container needs with the value of the host.
