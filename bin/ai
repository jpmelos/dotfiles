#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

# vim: ft=python

# / Run Claude Code inside a Docker container.
# /
# / Usage: ai [options] [-- harness-args...]
# / Options:
# /   --profile <name>  Specify profile for API key lookup (default: auto-detect
# /                     from path, first component after `~/devel`)
# /   --channel <name>  Claude Code release channel to install in the image
# /                     (default: `latest`). The channel is part of the image
# /                     tag, so each channel gets its own image, and a switch
# /                     to another channel builds that image.
# /   --process-output  Capture and process output (requires `--print` and
# /                     `--output-format json` in harness args)
# /   --force-rebuild   Force rebuild of Docker image
# /   --no-build-cache  Build from scratch without using cache
# /   --no-rebuild      Skip rebuilding image even if outdated
# /   --allow-stale     If build fails, use existing image (fatal if none
# /                     exists)
# /   --no-docker-socket
# /                     Do not mount the host Docker socket into the container
# /   --verbose         Print the Docker command before running it
# /   --help            Show this help
# /
# / Arguments after `--` are passed directly to Claude Code.
# /
# / If run outside of ~/devel or from ~/devel itself (not in a project),
# / defaults to ~/devel/dotfiles as the working directory.
# /
# / Security:
# /   The container runs read-only, with an explicit list of mounts. This
# /   limits mistakes. It is not a security boundary.
# /
# /   By default the host Docker socket is mounted and the container joins
# /   group 0. Any process in the container can then start a privileged
# /   container and take control of the host. Use `--no-docker-socket` for
# /   repositories that you do not trust. Docker is then unavailable inside
# /   the container.
# /
# /   Host directories under `/tmp` carry state between the container and the
# /   host. Any local user can read them. That is on purpose. Nothing secret
# /   goes there.
# /
# / tmux:
# /   When the launcher runs inside tmux, the container gets the `TMUX_PANE`
# /   variable and a mount of `/tmp/jpmelos/tmux`. The `running`, `pending`,
# /   `ready`, and `default` scripts then mark the pane that runs the agent,
# /   and `pending` and `ready` request the notification chime. The
# /   `pane-state-sync` script on the host picks both up. Outside tmux the
# /   container gets none of this, and these scripts do nothing.
# /
# / Configuration:
# /   Expects a configuration file at `~/config.json` (requires `chmod 600`)
# /   with API keys and other configuration.
# /
# /   Configuration format:
# /   ```
# /   {
# /     "claude_code": {
# /       "profiles": {
# /         "username": {
# /           "api_key": "sk-...",
# /           "model": "opus",
# /           "mcp_servers": {
# /             "server-name": {"command": "...", "args": ["..."]}
# /           }
# /         },
# /         "orgname": {
# /           "api_key": "sk-..."
# /         }
# /       }
# /     }
# /   }
# /   ```
# /
# /   Every key is optional. Without `api_key`, Claude Code falls back to OAuth
# /   credentials or asks the user to log in. Without `model`, the profile keeps
# /   the model from its own `settings.json`. Without `mcp_servers`, the profile
# /   keeps the `mcpServers` key that is already in its `.claude.json`.
# /
# /   The `mcp_servers` object of a profile replaces the `mcpServers` key in
# /   that profile's `.claude.json`.

import json
import os
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from datetime import datetime
from decimal import ROUND_CEILING, ROUND_DOWN, Decimal

_MISSING = object()

# The channel to install when the user names none. It is part of the image tag,
# so it must be a concrete value and not an empty string.
DEFAULT_CHANNEL = "latest"

# ============================================================================
# Small utilities
# ============================================================================


def echo_err(message):
    """Print a message to standard error."""
    print(message, file=sys.stderr, flush=True)


def die(message, *, code=1):
    """Print a message to standard error and exit."""
    echo_err(message)
    sys.exit(code)


def strip_leading_path(path, prefix):
    """Remove `prefix/` from the start of `path` if it is there."""
    if path.startswith(prefix + "/"):
        return path[len(prefix) + 1 :]
    return path


def read_text(path):
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def write_text_atomically(path, content):
    """Write text through a temporary file in the same directory.

    A write in place follows a symlink at `path` and changes the file that the
    link points to. The rename replaces the link instead.

    `tempfile.mkstemp` creates the temporary file with mode `0600`, so the
    result carries that mode. Every caller here writes a file that only the
    user must read.
    """
    directory = os.path.dirname(path) or "."
    descriptor, temp_path = tempfile.mkstemp(dir=directory)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
        os.replace(temp_path, path)
    except BaseException:
        remove_file(temp_path)
        raise


def read_json_file(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def write_json_file(path, data):
    """Write JSON the way `jq` does, through a temporary file."""
    write_text_atomically(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n")


def remove_file(path):
    """Remove a file or a symlink. Do nothing if it does not exist."""
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def remove_path(path):
    """Remove a file, a symlink, or a directory tree."""
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    else:
        os.unlink(path)


def profile_setting(config, profile, key):
    """Read `.claude_code.profiles[profile][key]` from the configuration.

    Return `_MISSING` when any step of the path is absent.
    """
    node = config
    for step in ("claude_code", "profiles", profile):
        node = node.get(step)
        if not isinstance(node, dict):
            return _MISSING
    return node.get(key, _MISSING)


def is_number(value):
    """Check whether a JSON value is a number."""
    return isinstance(value, (int, float)) and not isinstance(value, bool)


# ============================================================================
# Initial checks and configuration
# ============================================================================


def check_requirements():
    if shutil.which("docker") is None:
        die("Error: Docker is not installed")

    # `docker version` reaches the daemon and returns much faster than
    # `docker info`, which collects the full system report.
    docker_probe = subprocess.run(
        ["docker", "version", "--format", "{{.Server.Version}}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if docker_probe.returncode != 0:
        die("Error: Docker daemon is not running")


@dataclass
class Options:
    profile: str = ""
    channel: str = ""
    process_output: bool = False
    force_rebuild: bool = False
    no_build_cache: bool = False
    no_rebuild: bool = False
    allow_stale: bool = False
    no_docker_socket: bool = False
    verbose: bool = False
    show_help: bool = False
    harness_print_mode: bool = False
    harness_json_output: bool = False
    harness_args: list = field(default_factory=list)


def parse_options(argv):
    options = Options()

    flags = {
        "--process-output": "process_output",
        "--force-rebuild": "force_rebuild",
        "--no-build-cache": "no_build_cache",
        "--no-rebuild": "no_rebuild",
        "--allow-stale": "allow_stale",
        "--no-docker-socket": "no_docker_socket",
        "--verbose": "verbose",
        "--help": "show_help",
    }

    value_options = {
        "--profile": "profile",
        "--channel": "channel",
    }

    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument in value_options:
            index += 1
            if index >= len(argv):
                die(f"Error: {argument} requires an argument")
            setattr(options, value_options[argument], argv[index])
            index += 1
        elif argument in flags:
            setattr(options, flags[argument], True)
            index += 1
        elif argument == "--":
            options.harness_args = argv[index + 1 :]
            break
        else:
            die(f"Error: Unknown option '{argument}'")

    # Detect print mode and JSON output format in harness args.
    previous_argument = ""
    for argument in options.harness_args:
        if argument in ("--print", "-p"):
            options.harness_print_mode = True
        if argument == "--output-format=json":
            options.harness_json_output = True
        elif previous_argument == "--output-format" and argument == "json":
            options.harness_json_output = True
        previous_argument = argument

    # Validate that `--process-output` is only used with
    # `--print --output-format json`.
    if options.process_output:
        if not options.harness_print_mode or not options.harness_json_output:
            die(
                "Error: `--process-output` requires `--print` and "
                "`--output-format json` in harness args"
            )

    # The channel name reaches a shell during the image build, so keep it to a
    # plain token. It is also the tag of the image, which Docker requires to
    # start with an alphanumeric character and to hold at most 128 characters.
    if options.channel and not re.fullmatch(
        r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", options.channel
    ):
        die(f"Error: Invalid channel name '{options.channel}'")

    return options


def show_help():
    for line in read_text(__file__).splitlines():
        # A bare `# /` marks a blank line in the help text.
        if line == "# /":
            print("")
        elif line.startswith("# / "):
            print(line[4:])


# ============================================================================
# Helper functions
# ============================================================================


def get_date(timestamp):
    """Get formatted date in local time."""
    return datetime.fromtimestamp(int(timestamp)).strftime("%Y-%m-%d")


def today_date():
    return datetime.now().strftime("%Y-%m-%d")


def copy_tree_contents(source, destination):
    """Copy the contents of `source` into `destination`, like `cp -a`.

    Symlinks are copied as symlinks. Entries already in `destination` are
    replaced when their type does not match the source.

    The copy adds and overwrites, and it never deletes. An entry that the
    source dropped stays in `destination`. This is intended. Claude Code writes
    its own state into the same tree, and nothing here can tell that state
    apart from the leftovers of an earlier copy. Remove a stale command or
    skill from each profile by hand.

    A symlink in `destination` is always removed before the copy. Both
    `shutil.copyfile` and `shutil.copystat` follow symlinks, so a leftover link
    into the dotfiles repository would receive the write.
    """
    os.makedirs(destination, exist_ok=True)
    for entry in os.scandir(source):
        target = os.path.join(destination, entry.name)
        if entry.is_symlink():
            if os.path.lexists(target):
                remove_path(target)
            os.symlink(os.readlink(entry.path), target)
        elif entry.is_dir():
            if os.path.islink(target) or (
                os.path.lexists(target) and not os.path.isdir(target)
            ):
                remove_path(target)
            copy_tree_contents(entry.path, target)
            shutil.copystat(entry.path, target)
        else:
            if os.path.lexists(target):
                remove_path(target)
            shutil.copyfile(entry.path, target)
            shutil.copystat(entry.path, target)


def round_up_cents(value):
    """Round cost up to the next cent for display."""
    cents = (Decimal(str(value)) * 100).to_integral_value(rounding=ROUND_CEILING)
    return f"{cents / 100:.2f}"


def format_duration(total_seconds):
    """Format duration as XhYmZ.WWWs.

    The value is truncated to milliseconds first. Without that step the final
    `.3f` can round the seconds up to `60.000s`.
    """
    total = Decimal(str(total_seconds)).quantize(Decimal("0.001"), rounding=ROUND_DOWN)

    # Handle zero input.
    if total == 0:
        return "0.000s"

    hours = int(total / 3600)
    remainder = total - hours * 3600
    minutes = int(remainder / 60)
    seconds = remainder - minutes * 60

    result = ""
    if hours > 0:
        result = f"{hours}h"
    if minutes > 0 or hours > 0:
        result = f"{result}{minutes}m"
    return f"{result}{seconds:.3f}s"


def process_print_output(output):
    """Process Claude Code output from print mode."""

    def die_with_output(message):
        """Relay the captured output, then exit. Otherwise the output is lost."""
        echo_err(output)
        die(message)

    try:
        data = json.loads(output)
    except json.JSONDecodeError as error:
        die_with_output(f"Error: harness output is not valid JSON: {error}")
    if not isinstance(data, dict):
        die_with_output("Error: harness output is not a JSON object")

    result = data.get("result")
    if not isinstance(result, str):
        die_with_output(f"Error: harness output has no text `result`: {result!r}")

    cost = data.get("total_cost_usd")
    if not is_number(cost):
        die_with_output(
            f"Error: harness output has no numeric `total_cost_usd`: {cost!r}"
        )

    duration_ms = data.get("duration_ms")
    if not is_number(duration_ms):
        die_with_output(
            f"Error: harness output has no numeric `duration_ms`: {duration_ms!r}"
        )

    duration = Decimal(str(duration_ms)) / 1000

    print(result)
    print("")
    print(f"Cost: ${round_up_cents(cost)}")
    print(f"Duration: {format_duration(duration)}")


def build_image(use_cache, docker_image_name, dockerfile_path, home, channel):
    echo_err("Building Docker image...")

    build_args = [
        "--build-arg",
        f"UID={os.getuid()}",
        "--build-arg",
        f"GID={os.getgid()}",
        "--build-arg",
        f"HOME={home}",
        "--build-arg",
        f"BUILD_DATE={today_date()}",
    ]

    echo_err(f"Installing Claude Code from channel '{channel}'...")
    build_args += ["--build-arg", f"CLAUDE_CODE_CHANNEL={channel}"]

    if not use_cache:
        echo_err("Building from scratch without cache...")
        build_args.append("--no-cache")

    build_args += ["--tag", docker_image_name]

    try:
        dockerfile = open(dockerfile_path, "rb")
    except OSError as error:
        echo_err(f"Error: cannot read {dockerfile_path}: {error}")
        return False

    # Pipe the Dockerfile via stdin (`-`) so no build context is sent.
    with dockerfile:
        sys.stderr.flush()
        result = subprocess.run(
            ["docker", "build", *build_args, "-"],
            stdin=dockerfile,
            stdout=sys.stderr,
        )
    return result.returncode == 0


def generate_container_name(current_dir):
    """Build a container name. The PID keeps it unique among live processes."""
    basename = os.path.basename(current_dir)
    dir_basename = re.sub(r"[^a-zA-Z0-9_.-]", "", basename)
    return f"claude_code_{dir_basename[:44]}_{os.getpid()}"


def build_image_name(username, channel):
    """Build the Docker image name for the current user and channel.

    Docker rejects a repository name that is not lowercase, and it requires the
    first character to be alphanumeric.

    The channel is the tag. Each channel therefore gets its own image, and a
    switch to another channel names an image that does not exist yet. The
    freshness check then builds it, instead of running the channel that the
    last build happened to install.
    """
    sanitized = re.sub(r"[^a-z0-9._-]", "", username.lower()).lstrip("._-")[:64]
    if not sanitized:
        die(f"Error: cannot build an image name from user name '{username}'")
    return f"{sanitized}-claude:{channel}"


def get_timezone():
    """Read the local timezone name, so sessions get the right timestamps."""
    timezone = os.environ.get("TZ", "")
    if timezone:
        return timezone
    try:
        link = os.readlink("/etc/localtime")
    except OSError:
        return ""
    # A link that does not go through a `zoneinfo` directory carries no zone
    # name. Return nothing, so the caller leaves `TZ` unset.
    match = re.search(r"/zoneinfo/(.+)$", link)
    if not match:
        return ""
    return match.group(1)


def in_tmux():
    return bool(os.environ.get("TMUX_PANE"))


@dataclass
class RunConfig:
    home: str
    devel_dir: str
    current_dir: str
    profile: str
    project_name: str
    api_key: str
    aoe_instance_id: str
    aoe_session_name: str
    docker_image_name: str
    process_output: bool
    harness_print_mode: bool
    no_docker_socket: bool


def build_container_env(api_key):
    """Build the environment for the `docker run` process.

    The API key goes only to this process. It stays out of the environment of
    the script and out of every other child process. It stays out of the
    command line too, so it does not show up in `ps` or in verbose output.
    """
    env = dict(os.environ)
    if api_key:
        env["ANTHROPIC_API_KEY"] = api_key
    else:
        env.pop("ANTHROPIC_API_KEY", None)
    return env


# Host directories that the container writes to. Docker creates a missing
# mount source as a directory owned by `root`. The container user cannot then
# write to it, and nothing reports the failure.
SHARED_HOST_DIRS = ("/tmp/claude-code-shared", "/tmp/aoe-hooks")

# The directory that the `pane-state` and `chime` scripts write to, in their
# own subdirectories. The container gets it only when the launcher runs inside
# tmux.
TMUX_SHARED_DIR = "/tmp/jpmelos/tmux"

# Scripts from `~/devel/dotfiles/bin` that the agent calls by name.
AGENT_BINARIES = (
    "safe_mv",
    "safe_rm",
    "ai_git_add",
    "ai_git_restore",
    "ai_git_commit",
    "review",
    "review_diff",
    "pane-state",
    "chime",
    "running",
    "pending",
    "ready",
    "default",
)


def prepare_shared_dirs():
    """Create the host directories that the container writes to."""
    shared_dirs = list(SHARED_HOST_DIRS)
    if in_tmux():
        shared_dirs.append(TMUX_SHARED_DIR)
    for shared_dir in shared_dirs:
        try:
            os.makedirs(shared_dir, exist_ok=True)
        except OSError as error:
            echo_err(f"Warning: cannot create {shared_dir}: {error}")
            continue
        if not os.access(shared_dir, os.W_OK | os.X_OK):
            echo_err(f"Warning: {shared_dir} is not writable")


def build_run_command(harness_args, config):
    """Build the `docker run` command and the environment to run it with.

    Return the pair. The caller decides whether to capture the output or to
    replace the current process.
    """
    home = config.home
    devel_dir = config.devel_dir

    cmd = [
        "docker",
        "run",
        # Delete the container when it exits.
        "--rm",
        # Run an init process that will properly manage signals and other OS
        # facilities.
        "--init",
        # Configure user.
        "--user",
        f"{os.getuid()}:{os.getgid()}",
        # Container name.
        "--name",
        generate_container_name(config.current_dir),
        # So that the agent can reach services running on the host via
        # `host.docker.internal`.
        "--add-host",
        "host.docker.internal:host-gateway",
        # Make the entire filesystem read-only.
        "--read-only",
        "--tmpfs",
        "/tmp",
        "--env",
        "XDG_RUNTIME_DIR=/tmp",
        # Path used to coordinate things that use Claude Code.
        "--volume",
        "/tmp/claude-code-shared:/tmp/claude-code-shared",
        # Mount the entire `~/devel` directory and set the current directory as
        # the working directory.
        "--volume",
        f"{devel_dir}:{devel_dir}",
        "--workdir",
        config.current_dir,
        # Claude Code files.
        "--env",
        f"CLAUDE_CONFIG_DIR={home}/.claude",
        "--volume",
        f"{home}/.claude-{config.profile}:{home}/.claude",
        # Anthropic's API key if available. The name alone keeps the value out
        # of the command line. If not defined, Claude Code will check for OAuth
        # credentials. If not there too, it will ask the user how they want to
        # login.
        "--env",
        "ANTHROPIC_API_KEY",
        # This is used to show the active profile and project in the status
        # line.
        "--env",
        f"AGENT_PROFILE={config.profile}",
        "--env",
        f"PROJECT_NAME={config.project_name}",
        # Agent of Empires environment variables and mounts.
        "--env",
        f"AOE_INSTANCE_ID={config.aoe_instance_id}",
        "--env",
        f"AOE_SESSION_NAME={config.aoe_session_name}",
        "--volume",
        "/tmp/aoe-hooks:/tmp/aoe-hooks",
        # Claude Code uses this to know search for file suggestions on `@`.
        "--env",
        "RIPGREP_CONFIG_PATH",
        # Terminal configuration.
        "--env",
        "TERM",
        "--env",
        "COLORTERM",
        "--env",
        "FORCE_COLOR",
        "--env",
        "NO_COLOR",
    ]

    # Mount the scripts that the agent calls by name. Skip one when it is
    # absent, so Docker does not create it on the host as a directory owned by
    # `root`, inside the dotfiles working tree.
    for binary in AGENT_BINARIES:
        binary_path = f"{devel_dir}/dotfiles/bin/{binary}"
        if not os.path.isfile(binary_path):
            echo_err(f"Warning: {binary_path} does not exist, not mounting it")
            continue
        cmd += ["--volume", f"{binary_path}:/usr/local/bin/{binary}:ro"]

    # This enables sessions to show up with the right timestamps. An empty
    # value would mean UTC, so leave the variable unset instead and let the
    # image decide.
    timezone = get_timezone()
    if timezone:
        cmd += ["--env", f"TZ={timezone}"]

    # Let the `pane-state` script mark the pane that runs the agent, and let
    # the `chime` script ring on the host. `TMUX_PANE` names the pane that runs
    # the launcher. The directory carries the state files and the chime
    # requests to the host, where tmux picks them up. `TMUX` stays out.
    # Programs in the container would take it as a sign that they can talk to
    # tmux.
    if in_tmux():
        cmd += [
            "--volume",
            f"{TMUX_SHARED_DIR}:{TMUX_SHARED_DIR}",
            "--env",
            "TMUX_PANE",
        ]

    # Mount git configuration so my aliases and other preferences are in
    # effect. Skip it when it is absent, so Docker does not create it on the
    # host as a directory owned by `root`.
    git_config_dir = f"{home}/.config/git"
    if os.path.isdir(git_config_dir):
        cmd += ["--volume", f"{git_config_dir}:{git_config_dir}:ro"]
    else:
        echo_err(
            f"Warning: {git_config_dir} does not exist, Git configuration will "
            "not be available inside the container"
        )

    # Keep stdin attached in every case. Without `--interactive` the container
    # reads end of file at once, and a prompt that arrives through a pipe never
    # reaches the harness.
    cmd.append("--interactive")

    # A TTY belongs to an interactive session only. In print mode it mixes
    # terminal control codes into the output that the caller captures.
    if not config.process_output and not config.harness_print_mode and stdin_is_tty():
        cmd.append("--tty")

    # Relay additional environment variables from
    # `AGENTS_ADDITIONAL_ENV_VARS`.
    additional_env_vars = os.environ.get("AGENTS_ADDITIONAL_ENV_VARS", "")
    if additional_env_vars:
        for additional_env_var in additional_env_vars.split(":"):
            # Trim whitespace.
            additional_env_var = additional_env_var.strip()
            if not additional_env_var:
                continue
            if not re.fullmatch(r"[a-zA-Z_][a-zA-Z0-9_]*", additional_env_var):
                echo_err(
                    f"Warning: Skipping invalid env var name: {additional_env_var}"
                )
                continue
            echo_err(f"Additional environment variable: {additional_env_var}")
            cmd += ["--env", additional_env_var]

    # Set up Docker access from inside the container. The socket gives the
    # container control of the host, so `--no-docker-socket` turns it off.
    if config.no_docker_socket:
        echo_err("Docker socket not mounted (--no-docker-socket)")
    else:
        docker_socket = ""
        candidates = (f"{home}/.docker/run/docker.sock", "/var/run/docker.sock")
        for candidate in candidates:
            if is_socket(candidate):
                docker_socket = candidate
                break
        if not docker_socket:
            echo_err(
                "Warning: Docker socket not found, Docker will not be "
                "available inside the container"
            )
        else:
            cmd += [
                # Group 0 is what grants access to the socket. Without the
                # socket, the container has no reason to hold the privilege.
                "--group-add",
                "0",
                "--volume",
                f"{docker_socket}:/var/run/docker.sock",
                "--env",
                "DOCKER_HOST=unix:///var/run/docker.sock",
            ]

    cmd += [
        # The image we just built.
        config.docker_image_name,
        # Whatever arguments we want to pass to the harness.
        *harness_args,
    ]

    return cmd, build_container_env(config.api_key)


def is_socket(path):
    try:
        return stat.S_ISSOCK(os.stat(path).st_mode)
    except OSError:
        return False


def stdin_is_tty():
    try:
        return sys.stdin is not None and sys.stdin.isatty()
    except ValueError:
        return False


# ============================================================================
# Profile directory preparation
# ============================================================================


def list_project_dirs(devel_dir):
    """List the project directories relative to `~/devel`."""
    try:
        result = subprocess.run(
            [os.path.join(devel_dir, "dotfiles", "bin", "list_project_dirs")],
            stdout=subprocess.PIPE,
            encoding="utf-8",
        )
    except OSError as error:
        die(f"Error: cannot run list_project_dirs: {error}")
    if result.returncode != 0:
        die("Error: list_project_dirs failed")
    return result.stdout.splitlines()


def load_user_config(config_path):
    """Read the configuration file. Return `None` when the file is absent."""
    if not os.path.isfile(config_path):
        return None

    # Verify the file is not readable by group or others.
    file_perms = os.stat(config_path).st_mode & 0o7777
    if file_perms & 0o077:
        die(
            f"Error: {config_path} has permissions {file_perms:o}, expected "
            "no group or other access"
        )
    try:
        config = read_json_file(config_path)
    except json.JSONDecodeError as error:
        die(f"Error: {config_path} is not valid JSON: {error}")
    except OSError as error:
        die(f"Error: cannot read {config_path}: {error}")
    if not isinstance(config, dict):
        die(f"Error: {config_path} is not a JSON object")

    return config


def apply_preferred_model(config, profile, home):
    """Apply the preferred model for the profile from the configuration."""
    if config is None:
        return

    preferred_model = profile_setting(config, profile, "model")
    if preferred_model is _MISSING or preferred_model is None:
        return
    if not isinstance(preferred_model, str):
        echo_err(
            f"Warning: the `model` of profile '{profile}' is not text, model not set"
        )
        return

    profile_settings = f"{home}/.claude-{profile}/settings.json"
    try:
        settings = read_json_file(profile_settings)
        if not isinstance(settings, dict):
            echo_err(f"Warning: {profile_settings} is not a JSON object, model not set")
            return
        settings["model"] = preferred_model
        write_json_file(profile_settings, settings)
    except (OSError, json.JSONDecodeError) as error:
        echo_err(f"Warning: cannot set the model in {profile_settings}: {error}")
        return
    echo_err(f"Model set to '{preferred_model}' for profile '{profile}'")


def apply_dependencies_list(claude_md_path, project_dirs):
    """Replace the project list marker in CLAUDE.md with the project list."""
    marker = "<!-- DEPENDENCIES_LIST -->"

    try:
        claude_md = read_text(claude_md_path)
    except OSError:
        return
    except UnicodeDecodeError as error:
        echo_err(f"Warning: cannot read {claude_md_path}: {error}")
        return
    if marker not in claude_md:
        return

    if not project_dirs:
        echo_err(f"Warning: no projects found, {marker} stays in CLAUDE.md")
        return

    lines = []
    for line in claude_md.splitlines():
        if marker in line:
            # Extract the indentation from the marker line.
            indent = line.split(marker, 1)[0]
            lines += [f"{indent}- {project_dir}" for project_dir in project_dirs]
        else:
            lines.append(line)
    # The profile's CLAUDE.md can be a symlink into the dotfiles repository. An
    # atomic write replaces the link instead of the file behind it.
    write_text_atomically(claude_md_path, "".join(f"{line}\n" for line in lines))


def create_profile_json(profile_json_path):
    """Create the profile's `.claude.json` if it is not there yet.

    The file keeps the tail of the API key and the account metadata, so tighten
    the mode of a file that an earlier run or another tool left with wider
    access. A new file gets `0600` from `write_text_atomically`.
    """
    if not os.path.isfile(profile_json_path):
        write_text_atomically(profile_json_path, "{}\n")
    try:
        os.chmod(profile_json_path, 0o600)
    except OSError as error:
        echo_err(f"Warning: cannot set the mode of {profile_json_path}: {error}")


def approve_api_key(profile_json_path, api_key):
    """Pre-approve the API key in the profile's `.claude.json`.

    Claude Code records the tail of a key that the user approved. Without the
    entry it asks on every launch. A key of at most `tail_length` characters
    gets no entry, because the tail would be the whole secret.
    """
    if not api_key:
        return

    tail_length = 20
    if len(api_key) <= tail_length:
        echo_err(
            "Warning: the API key is too short to pre-approve, "
            "Claude Code will ask about it"
        )
        return
    approved_tail = api_key[-tail_length:]

    try:
        profile_json = read_json_file(profile_json_path)
        if not isinstance(profile_json, dict):
            echo_err(
                f"Warning: {profile_json_path} is not a JSON object, "
                "the API key is not pre-approved"
            )
            return
        responses = profile_json.get("customApiKeyResponses")
        if not isinstance(responses, dict):
            responses = {}
            profile_json["customApiKeyResponses"] = responses
        approved = responses.get("approved")
        if not isinstance(approved, list):
            approved = []
            responses["approved"] = approved
        if approved_tail in approved:
            return
        approved.append(approved_tail)
        write_json_file(profile_json_path, profile_json)
    except (OSError, json.JSONDecodeError) as error:
        echo_err(
            f"Warning: cannot pre-approve the API key in {profile_json_path}: {error}"
        )


def apply_mcp_servers(config, profile_json_path, profile):
    """Apply the MCP servers for the profile from the configuration.

    This replaces any `mcpServers` key that is already in the profile's
    `.claude.json`.
    """
    if config is None:
        return

    mcp_servers = profile_setting(config, profile, "mcp_servers")
    if mcp_servers is _MISSING or mcp_servers is None:
        return

    try:
        profile_json = read_json_file(profile_json_path)
        if not isinstance(profile_json, dict):
            echo_err(
                f"Warning: {profile_json_path} is not a JSON object, "
                "MCP servers not set"
            )
            return
        profile_json["mcpServers"] = mcp_servers
        write_json_file(profile_json_path, profile_json)
    except (OSError, json.JSONDecodeError) as error:
        echo_err(f"Warning: cannot set MCP servers in {profile_json_path}: {error}")
        return
    echo_err(f"MCP servers set for profile '{profile}'")


# ============================================================================
# Image freshness
# ============================================================================


def inspect_last_build(docker_image_name):
    """Get the image's tag timestamp and the error output of the inspection."""
    result = subprocess.run(
        [
            "docker",
            "image",
            "inspect",
            docker_image_name,
            "--format",
            "{{.Metadata.LastTagTime.Unix}}",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        encoding="utf-8",
    )
    return result.stdout.rstrip("\n"), result.stderr.rstrip("\n")


def get_last_build(docker_image_name):
    """Get the image's tag timestamp, with a retry for a Docker bug."""
    last_build_timestamp, inspect_stderr = inspect_last_build(docker_image_name)

    # TODO: Remove this once it's not needed anymore. There is some bug in
    # Docker in which sometimes `docker image inspect` can't find an image, but
    # then you run `docker image ls` and then `docker image inspect` again, and
    # it works... This is an attempt to automatically overcome it.
    if "No such image" in inspect_stderr:
        echo_err("WARNING: image not found, trying to fix it")
        subprocess.run(
            ["docker", "image", "ls", docker_image_name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        last_build_timestamp, inspect_stderr = inspect_last_build(docker_image_name)
        if "No such image" not in inspect_stderr:
            echo_err("WARNING: 'docker image ls' fixed it")

    return last_build_timestamp, inspect_stderr


def get_rebuild_reason(
    options, last_build_date, last_build_timestamp, dockerfile_mtime, today
):
    """Return the reason for a rebuild, or `None` if the image needs none.

    The reason is a pair of a stable code and a message for the user. The caller
    matches on the code, so a change to the message breaks nothing.
    """
    if options.no_build_cache:
        return ("no-build-cache", "--no-build-cache specified")
    if options.force_rebuild:
        return ("force-rebuild", "--force-rebuild specified")
    if not last_build_date:
        return ("missing-image", "image does not exist")
    if last_build_date != today:
        return ("stale-date", f"image is from {last_build_date}, today is {today}")
    if last_build_timestamp and dockerfile_mtime > int(last_build_timestamp):
        return ("stale-dockerfile", "Dockerfile modified after last build")
    return None


def ensure_image(options, docker_image_name, dockerfile_path, home, channel):
    today = today_date()

    last_build_timestamp, inspect_stderr = get_last_build(docker_image_name)

    # Derive the last build date in local time from the timestamp.
    last_build_date = ""
    if last_build_timestamp:
        try:
            last_build_date = get_date(last_build_timestamp)
        except (ValueError, OSError, OverflowError):
            die(
                "Error: cannot read the build date of image "
                f"'{docker_image_name}' from '{last_build_timestamp}'"
            )

    # Get the Dockerfile's modification time (seconds since epoch).
    try:
        dockerfile_mtime = int(os.stat(dockerfile_path).st_mtime)
    except OSError:
        dockerfile_mtime = 0

    rebuild_reason = get_rebuild_reason(
        options, last_build_date, last_build_timestamp, dockerfile_mtime, today
    )
    reason_code, reason_message = rebuild_reason or ("", "")
    if reason_code == "missing-image" and inspect_stderr:
        echo_err(f"docker image inspect: {inspect_stderr}")

    if options.no_rebuild:
        # Skip rebuild entirely - verify image exists.
        if not last_build_date:
            die(
                f"Error: Docker image '{docker_image_name}' does not exist and "
                "--no-rebuild was specified"
            )
        if rebuild_reason:
            echo_err(
                f"--no-rebuild specified, skipping rebuild despite: {reason_message}"
            )
        else:
            echo_err("Skipping rebuild (--no-rebuild specified, image is up to date)")
    elif rebuild_reason:
        echo_err(f"Rebuilding image: {reason_message}")
        use_cache = not options.no_build_cache
        if not build_image(
            use_cache, docker_image_name, dockerfile_path, home, channel
        ):
            if not options.allow_stale:
                die("Error: Docker build failed")
            if not last_build_date:
                die(
                    "Error: Docker build failed and no existing image "
                    f"'{docker_image_name}' found"
                )
            echo_err("Build failed, using existing image (--allow-stale)")
    else:
        echo_err("Image is up to date, skipping rebuild.")


# ============================================================================
# Main Execution
# ============================================================================


def detect_profile(current_dir):
    try:
        result = subprocess.run(
            ["project_profile_name"],
            cwd=current_dir,
            stdout=subprocess.PIPE,
            encoding="utf-8",
        )
    except OSError:
        die("Error: project_profile_name not found", code=127)
    if result.returncode != 0:
        sys.exit(result.returncode)
    return result.stdout.rstrip("\n")


def detect_aoe_session():
    """Get AoE session info if available."""
    if shutil.which("aoe") is None:
        return "", ""
    result = subprocess.run(
        ["aoe", "session", "current", "--json"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        encoding="utf-8",
    )
    if result.returncode != 0:
        return "", ""
    try:
        session = json.loads(result.stdout)
    except json.JSONDecodeError:
        echo_err(
            "Warning: `aoe session current --json` did not return valid JSON, "
            "running without session info"
        )
        return "", ""
    if not isinstance(session, dict):
        echo_err(
            "Warning: `aoe session current --json` did not return a JSON object, "
            "running without session info"
        )
        return "", ""
    instance_id = session.get("id")
    session_name = session.get("session")
    if not isinstance(instance_id, str) or not isinstance(session_name, str):
        echo_err(
            "Warning: `aoe session current --json` did not return text `id` and "
            f"`session`: {instance_id!r}, {session_name!r}"
        )
        return "", ""
    return instance_id, session_name


def resolve_api_key(config, profile):
    """Get the API key for the profile from the configuration.

    An API key that is already in the environment wins. Return an empty string
    when there is no key. Claude Code then falls back to OAuth, or it prompts
    the user.
    """
    from_environment = os.environ.get("ANTHROPIC_API_KEY", "")
    if from_environment:
        return from_environment

    api_key = _MISSING
    if config is not None:
        api_key = profile_setting(config, profile, "api_key")
    if api_key is _MISSING or api_key is None:
        echo_err(f"No API key for profile '{profile}'")
        return ""
    if not isinstance(api_key, str):
        die(f"Error: the `api_key` of profile '{profile}' is not text")
    return api_key


def main():
    options = parse_options(sys.argv[1:])

    if options.show_help:
        show_help()
        return 0

    # The help text must work on a host without Docker, so this check comes
    # after the options.
    check_requirements()

    home = os.environ.get("HOME")
    if not home:
        die("Error: HOME is not set")
    try:
        username = pwd.getpwuid(os.geteuid()).pw_name
    except KeyError:
        die(f"Error: user ID {os.geteuid()} has no entry in the password database")

    devel_dir = os.path.realpath(os.path.join(home, "devel"))
    if not os.path.isdir(devel_dir):
        die(f"Error: {home}/devel does not exist")

    current_dir = os.path.realpath(os.getcwd())
    if not current_dir.startswith(devel_dir + "/"):
        current_dir = os.path.join(devel_dir, "dotfiles")
        echo_err(f"Not inside a ~/devel project, defaulting to {current_dir}")

    profile = options.profile
    if not profile:
        profile = detect_profile(current_dir)
    # Validate profile name to prevent command injection.
    # Max length: 64 characters, alphanumeric with dots, dashes, underscores.
    if not re.fullmatch(r"[a-zA-Z0-9_]([a-zA-Z0-9._-]{0,62}[a-zA-Z0-9_])?", profile):
        die(f"Error: Invalid profile name '{profile}'")

    # Compute the project name (path relative to ~/devel/).
    project_name = strip_leading_path(current_dir, devel_dir)

    aoe_instance_id, aoe_session_name = detect_aoe_session()

    echo_err(f"Profile: {profile}")
    echo_err(f"Project: {project_name}")
    if aoe_instance_id:
        echo_err(
            f"Agent of Empires detected: {aoe_instance_id} "
            f"(session: {aoe_session_name})"
        )

    user_config_path = f"{home}/config.json"
    user_config = load_user_config(user_config_path)
    api_key = resolve_api_key(user_config, profile)

    channel = options.channel or DEFAULT_CHANNEL
    docker_image_name = build_image_name(username, channel)
    dockerfile_path = os.path.join(
        devel_dir, "dotfiles", "references", "ai_containers", "Dockerfile"
    )

    ensure_image(options, docker_image_name, dockerfile_path, home, channel)

    # Different profiles have different projects, todos, chat histories, etc.
    profile_dir = f"{home}/.claude-{profile}"
    # The directory holds credentials and chat history. `makedirs` applies the
    # mode only to a directory that it creates, so tighten an existing one too.
    os.makedirs(profile_dir, mode=0o700, exist_ok=True)
    try:
        os.chmod(profile_dir, 0o700)
    except OSError as error:
        echo_err(f"Warning: cannot set the mode of {profile_dir}: {error}")
    try:
        copy_tree_contents(f"{home}/.claude-origin", profile_dir)
    except OSError as error:
        die(f"Error: cannot copy {home}/.claude-origin: {error}")

    apply_preferred_model(user_config, profile, home)

    project_dirs = list_project_dirs(devel_dir)
    apply_dependencies_list(f"{profile_dir}/CLAUDE.md", project_dirs)

    profile_json_path = f"{profile_dir}/.claude.json"
    create_profile_json(profile_json_path)
    approve_api_key(profile_json_path, api_key)
    apply_mcp_servers(user_config, profile_json_path, profile)

    prepare_shared_dirs()

    # Always restrict setting sources to user and local.
    harness_args = ["--setting-sources", "user,local", *options.harness_args]

    # Add the other project directories to Claude's context. The current
    # project is already the working directory.
    for relative_project_dir in project_dirs:
        project_dir = os.path.join(devel_dir, relative_project_dir)
        if project_dir == current_dir:
            continue
        harness_args += ["--add-dir", project_dir]

    config = RunConfig(
        home=home,
        devel_dir=devel_dir,
        current_dir=current_dir,
        profile=profile,
        project_name=project_name,
        api_key=api_key,
        aoe_instance_id=aoe_instance_id,
        aoe_session_name=aoe_session_name,
        docker_image_name=docker_image_name,
        process_output=options.process_output,
        harness_print_mode=options.harness_print_mode,
        no_docker_socket=options.no_docker_socket,
    )

    cmd, env = build_run_command(harness_args, config)

    if options.verbose:
        echo_err(f"Command: {shlex.join(cmd)}")
    echo_err("Running container...")
    sys.stdout.flush()
    sys.stderr.flush()

    if options.process_output:
        # Capture output and process it.
        result = subprocess.run(cmd, stdout=subprocess.PIPE, encoding="utf-8", env=env)
        if result.returncode != 0:
            # The output was captured, so relay it. Otherwise the failure is
            # silent.
            if result.stdout:
                echo_err(result.stdout.rstrip("\n"))
            return result.returncode
        process_print_output(result.stdout.rstrip("\n"))
        return 0

    # Replace this process with the container. Claude Code then owns the
    # terminal and its exit status becomes ours.
    try:
        os.execvpe(cmd[0], cmd, env)
    except OSError as error:
        die(f"Error: cannot run {cmd[0]}: {error}")


if __name__ == "__main__":
    sys.exit(main())
