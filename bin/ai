        "RIPGREP_CONFIG_PATH",
        "TERM",
        "TMUX_PANE",
        "TMUX_PANE_STATES_DIR",
        "TZ",
        "XDG_CACHE_HOME",
        "XDG_RUNTIME_DIR",
        "npm_config_cache",
    }
)
AGENT_BINARIES = (
    "safe_mv",
    "safe_rm",
    "ai_git_add",
    "ai_git_restore",
    "ai_git_commit",
    "review",
    "review_diff",
    "pane-state",
    "chime",
