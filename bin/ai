#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

# vim: ft=python

# / Run Claude Code inside a Docker container.
# /
# / Usage: ai [options] [-- harness-args...]
# / Options:
# /   --profile <name>  Profile to run as. Selects the `~/.claude-<name>`
# /                     directory, with its own login, history, and
# /                     credentials, and the `api_key`, `model`,
# /                     `effortLevel`, and `mcp_servers` of that profile in
# /                     `~/config.json`
# /                     (default: the organization directory of the project,
# /                     such as `orgname` for `~/devel/orgname/project`, or
# /                     the user name for a project directly under `~/devel`)
# /   --channel <name>  Claude Code release channel or version to install in
# /                     the image (default: `latest`). Accepts `latest`,
# /                     `stable`, or a version such as `2.1.0`. The channel is
# /                     part of the image tag, so each channel gets its own
# /                     image, and a switch to another channel builds that
# /                     image. The image of a channel is rebuilt once a day.
# /                     The image of a version is not, because a version
# /                     names one release.
# /   --process-output  Capture and process output (requires `--print` and
# /                     `--output-format json` in harness args)
# /   --force-rebuild   Rebuild the Docker image even if it is up to date. The
# /                     build runs without cache, because a cached build would
# /                     install the same release again
# /   --no-rebuild      Skip rebuilding image even if outdated
# /   --allow-stale     If build fails, use existing image (fatal if none
# /                     exists)
# /   --no-docker-socket
# /                     Do not mount the host Docker socket into the container
# /   --verbose         Print the Docker command before running it
# /   --help, -h        Show this help
# /
# / Harness arguments:
# /   Arguments after `--` are passed directly to Claude Code. The launcher
# /   puts `--setting-sources=user` and one `--add-dir` per visible project
# /   before them. A `--setting-sources` that you pass wins. An `--add-dir`
# /   that you pass adds to the list.
# /
# / Projects:
# /   A project is a directory that `list_project_dirs` reports. The current
# /   directory can be the project root or any directory below it. Both cases
# /   behave the same: the profile comes from the root, and the container
# /   starts in the root. If run from outside of `~/devel`, defaults to
# /   ~/devel/dotfiles as the project. A run from a directory under `~/devel`
# /   that is inside no project is an error. The default would start the
# /   agent on the dotfiles repository, where it can edit the scripts that run
# /   on the host, and a `.list_project_dirs_ignore` file asks for the
# /   opposite. `~/devel`, every project, and every directory between the two
# /   must be real directories, not links. The container sees `~/devel`
# /   through one mount, and a link whose target is outside of that mount
# /   does not resolve inside it. The launcher refuses to start when it finds
# /   one.
# /
# / Configuration:
# /   Reads an optional configuration file at `~/config.json` with API keys
# /   and other configuration. The file must be a regular file, not a link,
# /   owned by you, with no group or other permissions, as with `chmod 600`.
# /   The profile directory `~/.claude-<name>` must be a real directory, not a
# /   link. The launcher refuses to start when it is one.
# /
# /   Configuration format:
# /   ```
# /   {
# /     "claude_code": {
# /       "profiles": {
# /         "username": {
# /           "api_key": "sk-...",
# /           "model": "opus",
# /           "effortLevel": "xhigh",
# /           "mcp_servers": {
# /             "server-name": {"command": "...", "args": ["..."]}
# /           }
# /         },
# /         "orgname": {
# /           "api_key": "sk-..."
# /         }
# /       }
# /     }
# /   }
# /   ```
# /
# /   Every key is optional. A profile without an entry in `profiles` is a
# /   supported configuration. A detected profile without one only warns, and
# /   only when the configuration file exists. An explicit `--profile` without
# /   one is an error when the `~/.claude-<name>` directory does not exist
# /   yet, because that is almost always a typo. To start a new profile
# /   without an entry, create the directory first.
# /
# /   Without `api_key`, Claude Code falls back to OAuth credentials or asks
# /   the user to log in. Without `model`, the profile uses the model from
# /   `~/.claude-origin/settings.json`, which every run copies into the
# /   profile. `effortLevel` works the same way: with it, the launcher sets
# /   the global `effortLevel` of the profile `settings.json`. Without it, the
# /   profile uses the `effortLevel` of the origin file, if any. Without
# /   `mcp_servers`, the profile keeps the `mcpServers` key
# /   that is already in its `.claude.json`.
# /
# /   The `mcp_servers` object of a profile replaces the `mcpServers` key in
# /   that profile's `.claude.json`.
# /
# /   An `ANTHROPIC_API_KEY` variable in the environment takes precedence over
# /   the `api_key` of the profile. The launcher names the source of the key
# /   when it comes from the environment, and warns when both are present,
# /   because the account of the environment key pays for the session.
# /
# / Environment:
# /   The launcher reads these variables of the host:
# /
# /   ANTHROPIC_API_KEY  The API key of the session. See `Configuration`.
# /   AGENTS_ADDITIONAL_ENV_VARS
# /                      A colon-separated list of variable names to relay
# /                      into the container with the value of the host. A
# /                      name that the launcher or the image sets for the
# /                      container is skipped with a warning.
# /   RIPGREP_CONFIG_PATH
# /                      The options file of ripgrep. Relayed when the file is
# /                      under `~/devel`, where the container can read it.
# /                      Otherwise the container does not get it, and a
# /                      warning says so.
# /   DOCKER_HOST        The daemon of the host. A Unix socket is mounted into
# /                      the container. See `Security`.
# /   TZ                 The time zone of the container. Without it, the
# /                      launcher reads the zone from `/etc/localtime` or
# /                      `/etc/timezone`, and leaves it unset when neither
# /                      names one.
# /   TMUX_PANE          The pane that runs the launcher. See `tmux`.
# /
# / Security:
# /   The container runs read-only, with an explicit list of mounts. This
# /   limits mistakes. It is not a security boundary.
# /
# /   By default the host Docker socket is mounted and the container joins
# /   the group of the socket file, and on macOS also group 0, which owns the
# /   socket inside the Docker Desktop virtual machine. Any process in the
# /   container can then start a privileged container and take control of the
# /   host. Use `--no-docker-socket` for repositories that you do not trust.
# /   Docker is then unavailable inside the container.
# /
# /   The dotfiles repository holds the scripts that the agent calls and the
# /   `.claude-origin` directory that every run copies into the profile. When
# /   the project is not the dotfiles repository, the container sees that
# /   repository read-only, so the agent cannot change the origin. The
# /   launcher warns when `~/.claude-origin` resolves into `~/devel` but
# /   outside of that repository, because the `~/devel` mount is read-write
# /   there. An origin outside of `~/devel` is not visible in the container.
# /   The copy overwrites the files that the origin holds, and it mirrors the
# /   directories that the origin holds, so a file that the agent adds to
# /   `~/.claude/commands` does not survive the next run. A top-level entry
# /   that an earlier run installed and that the origin no longer holds is
# /   removed. The list of installed entries lives in
# /   `~/.ai-launcher/<profile>/manifest`, which no mount exposes, so the
# /   agent cannot make a run remove another entry. The lock that makes two
# /   launches of a profile take turns lives next to it, so the agent cannot
# /   stall a launch from inside the container. The rest of the profile
# /   directory is not touched. The `/learn` command writes to the origin, so
# /   it works only from the dotfiles project.
# /
# /   The container is limited to a number of processes and an amount of
# /   memory, so a runaway subprocess or a browser cannot take the host down.
# /   The limits are the `CONTAINER_PIDS_LIMIT` and `CONTAINER_MEMORY_LIMIT`
# /   constants in this script.
# /
# /   The mirror applies to every directory in the origin. Do not add to the
# /   origin a directory that Claude Code writes to, such as `plugins` or
# /   `skills`. Every run then removes what Claude Code stored there.
# /
# /   When the project is the dotfiles repository, the agent can edit the
# /   scripts that run on the host, such as `bin/ai`, `bin/list_project_dirs`,
# /   and `bin/pane-state-sync`. The next launch runs that code as you.
# /   `--no-docker-socket` does not close this path. Run an agent on the
# /   dotfiles repository only when you trust it.
# /
# /   The `~/devel` mount is read-write, and every project is an `--add-dir`,
# /   so the agent can edit every repository under `~/devel`, not only the
# /   project. Only the dotfiles repository is read-only. Move a repository
# /   that the agent must not touch out of `~/devel`, or add a
# /   `.list_project_dirs_ignore` file to keep it out of the `--add-dir` list.
# /   The mount still exposes an ignored repository.
# /
# /   The host directory `/tmp/ai-<user>/<profile>` is mounted at the same path
# /   in every container of the profile, so these containers share it. It holds
# /   the cache directories of the tools in the image, which the
# /   `XDG_CACHE_HOME` and `npm_config_cache` variables name, and the directory
# /   that the `AGENT_SHARED_DIR` variable names, where the hook scripts write.
# /   Only you can read those. The hooks see tool input and output, which can
# /   hold secrets from the session.
# /
# / tmux:
# /   The `pane-state` and `chime` scripts write below
# /   `/tmp/tmux-pane-states-<user>`, and `pane-state-sync` reads there. Each
# /   user of the machine has a private directory, named after the user, right
# /   below `/tmp`. Two users can have a pane with the same tmux target, so the
# /   states of one user must not reach the tmux server of another. The
# /   directory has no shared parent other than `/tmp`, whose owner is `root`,
# /   so no other user can rename or replace it. The container always gets the
# /   directory of the user at the same path, and the `TMUX_PANE_STATES_DIR`
# /   variable names it. Every profile uses that one directory, so a pane has
# /   one state file. When the launcher runs inside tmux, the container also
# /   gets the `TMUX_PANE` variable. The `running`, `waiting`, `ready`, and
# /   `default` scripts then mark the pane that runs the agent, and `waiting`
# /   and `ready` request the notification chime. The `pane-state-sync` script
# /   on the host picks both up. Outside tmux the variable is absent, and these
# /   scripts do nothing.

import contextlib
import datetime
import errno
import fcntl
import hashlib
import json
import os
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from decimal import ROUND_CEILING, ROUND_DOWN, Decimal

_MISSING = object()

# Options of this script that take a value, mapped to the `Options` field that
# holds it. The help scan uses the keys to tell a value from a flag.
VALUE_OPTIONS = {
    "--profile": "profile",
    "--channel": "channel",
}
# Options of this script that take no value, mapped to the `Options` field that
# they turn on.
FLAG_OPTIONS = {
    "--process-output": "process_output",
    "--force-rebuild": "force_rebuild",
    "--no-rebuild": "no_rebuild",
    "--allow-stale": "allow_stale",
    "--no-docker-socket": "no_docker_socket",
    "--verbose": "verbose",
}
DEFAULT_CLAUDE_CODE_CHANNEL = "latest"
DOCKERFILE_DIGEST_LABEL = "dockerfile_sha256"
BUILD_DATE_LABEL = "build_date"
# Prefix of the host directory, right below `/tmp`, where the `pane-state` and
# `chime` scripts write and `pane-state-sync` reads. The user name follows the
# prefix. See the `tmux` section of the help for why the directory is there.
TMUX_PANE_STATES_DIR_PREFIX = "/tmp/tmux-pane-states-"
# Variables that the launcher or the image sets for the container, or that
# the launcher relays on its own. A relay of one of these from
# `AGENTS_ADDITIONAL_ENV_VARS` would replace the value that the container
# needs with the value of the host, or pass the variable twice.
RESERVED_ENV_VARS = frozenset(
    {
        "AGENT_BROWSER_EXECUTABLE_PATH",
        "AGENT_PROFILE",
        "AGENT_SHARED_DIR",
        "ANTHROPIC_API_KEY",
        "CLAUDE_CONFIG_DIR",
        "COLORTERM",
        "DOCKER_HOST",
        "FORCE_COLOR",
        "HOME",
        "LANG",
        "NO_COLOR",
        "PATH",
