    "ready",
    "default",
)
# Prefix of the temporary files that the atomic writes create next to their
# target. A launch that dies between the creation and the rename leaves one
# behind, and the prefix lets the next launch recognize it.
TEMP_FILE_PREFIX = ".launcher-tmp-"
# How many bytes the comparison of two files reads at a time.
CONTENT_CHUNK_SIZE = 64 * 1024
# Name of the directory in the home directory that holds the state of the
# launcher, with one directory per profile inside it. No mount exposes it, so
# the agent cannot edit what is there. Profile directories are named
# `.claude-<profile>`, so this name never collides with one of them.
LAUNCHER_STATE_DIR_NAME = ".ai-launcher"
# Name of the file in the state directory of a profile that lists the
# top-level entries that the last launch installed from the origin, one per
# line. The copied entries and the derived files both count.
MANIFEST_NAME = "manifest"
# Name of the file in the state directory of a profile that the launches of
# the profile lock, so that they prepare the profile directory one at a time.
LOCK_NAME = "launcher.lock"
# Claude Code records an approved API key by its last characters, this many of
# them.
APPROVED_KEY_TAIL_LENGTH = 20
# How many times a launch reads, edits, and writes `.claude.json` before it
# gives up on a file that another session keeps changing.
PROFILE_JSON_WRITE_ATTEMPTS = 3
# A Docker repository name holds at most 255 characters, and the image name
# has a fixed suffix, so the user name part is cut to this length.
IMAGE_NAME_USER_LENGTH = 64
# The container name has a fixed prefix and a process ID suffix, so the
# project name part is cut to this length.
CONTAINER_NAME_PROJECT_LENGTH = 44
# How many processes the container can hold at once. A fork bomb or a
# subprocess that spawns without end stops at this count instead of at the
# limit of the host.
CONTAINER_PIDS_LIMIT = "4096"
# How much memory the container can use, in the format that `docker run
# --memory` takes. The value is also the swap limit, so the container gets no
# swap. Chromium, which `agent-browser` drives, and a large build are the
# usual consumers.
CONTAINER_MEMORY_LIMIT = "8g"


# --------------------------------------------------------------------------------------
# Entry point.
# --------------------------------------------------------------------------------------


def main():
    process_help_option(sys.argv[1:])

    paths = resolve_host_paths()
    username = resolve_username()

    project_dirs = resolve_project_dirs(
        list_project_dirs(paths.dotfiles_dir), paths.devel_dir
    )
    project_root = resolve_current_project_root(paths, project_dirs)
    # The project name is the path relative to `~/devel`.
    project_name = strip_leading_path(project_root, paths.devel_dir)

    options = parse_options(sys.argv[1:], project_name, username)

    # The options are checked before the Docker probe, so a typo in one of
    # them fails without a round trip to the daemon.
    check_docker_is_running()

    profile = options.profile
    profile_paths = resolve_profile_paths(paths.home, username, profile)
    check_origin_dir(paths, profile, profile_paths.profile_dir)

    log(f"Profile: {profile}")
    log(f"Project: {project_name}")

    user_config = load_user_config(paths.user_config_path)
    if user_config is None or not has_profile_entry(user_config, profile):
        check_profile_without_entry(
            options.profile_detected,
            profile,
            profile_paths.profile_dir,
            user_config,
            paths.user_config_path,
        )
    api_key = resolve_api_key(user_config, profile)

    # Every directory of the user is private. The names of the profile
    # directories are the names of the organizations, the shared directory
    # receives what the hooks see, which includes tool input and output, and
    # the caches hold what the tools fetched or browsed. Another user has no
    # business in any of them, nor in the pane state directory of the user.
    profile_tmp_dir = profile_paths.profile_tmp_dir
    prepare_tmp_dirs(
        (
            (profile_paths.user_tmp_dir, 0o700),
            (profile_tmp_dir, 0o700),
            (profile_paths.shared_dir, 0o700),
            (profile_paths.pane_states_dir, 0o700),
            (f"{profile_tmp_dir}/xdg_cache", 0o700),
            (f"{profile_tmp_dir}/npm_cache", 0o700),
        )
    )

    channel = options.channel
    # The lock is per user and channel, like the image, so two profiles that
    # launch on a new day at the same time take turns, and the second one
    # finds the image that the first one built. Two channels build in
    # parallel, because they build different images. The file sits in the
    # directory of the user under `/tmp`, so no other local user can create
    # it first. See `prepare_tmp_dirs` for the checks on that directory.
    image_spec = ImageSpec(
        name=build_image_name(username, channel),
        channel=channel,
        dockerfile_path=paths.dockerfile_path,
        home=paths.home,
        lock_path=f"{profile_paths.user_tmp_dir}/claude-code-img-lock-{channel}",
    )
    ensure_image(options, image_spec)

    # The project under work is not one of its own dependencies.
    dependency_dirs = [
        project_dir for project_dir in project_dirs if project_dir.path != project_root
    ]
    prepare_profile_dir(
        ProfilePrep(
            origin_dir=paths.origin_dir,
            profile_dir=profile_paths.profile_dir,
            state_dir=profile_paths.state_dir,
            user_config=user_config,
            profile=profile,
            api_key=api_key,
            dependency_names=[
                project_dir.relative_path for project_dir in dependency_dirs
            ],
        )
    )

    harness_args = build_harness_args(options.harness_args, dependency_dirs)

    run_config = RunConfig(
        paths=paths,
        profile_paths=profile_paths,
        project_root=project_root,
        profile=profile,
        project_name=project_name,
        api_key=api_key,
        docker_image_name=image_spec.name,
        container_name=generate_container_name(project_root),
        harness_print_mode=options.harness_print_mode,
        no_docker_socket=options.no_docker_socket,
    )

    run_command, env = build_run_command(harness_args, run_config)

    if options.verbose:
        log(f"Command: {shlex.join(run_command)}")
    log("Running container...")

    if options.process_output:
        return run_captured(run_command, env, run_config.container_name)

    # Replace this process with the container. Claude Code then owns the
    # terminal and its exit status becomes ours.
    #
    # `exec` discards the process image, and the buffers of the Python streams
    # with it. A line that `print` did not flush yet, such as one without a
    # newline, or one on a stream that is not line-buffered, would be lost.
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        os.execvpe(run_command[0], run_command, env)
    except OSError as error:
        die(f"cannot run {run_command[0]}: {error}")


# --------------------------------------------------------------------------------------
# Help.
# --------------------------------------------------------------------------------------


def process_help_option(argv):
    skip_next = False
    for argument in argv:
        if skip_next:
            # The token is the value of the option before it, not a flag.
            skip_next = False
            continue

        if argument == "--":
            # Any `--help` is targeted for Claude Code instead of this script.
            return

        if argument in VALUE_OPTIONS:
            skip_next = True
            continue

        if argument in ("--help", "-h"):
            show_help()
            sys.exit(0)


def show_help():
    for line in read_text(__file__).splitlines():
        if line == "# /":
            # A bare `# /` marks a blank line in the help text.
            print("")
            continue

        if line.startswith("# / "):
            print(line[4:])


# --------------------------------------------------------------------------------------
# Host environment.
# --------------------------------------------------------------------------------------


def check_docker_is_running():
    if shutil.which("docker") is None:
        die("Docker is not installed")

    # The probe fails for more reasons than a stopped daemon, such as a socket
    # without permission or a stale context, so relay what the client says.
    run_docker_or_die(
        ["version", "--format", "{{.Server.Version}}"],
        "cannot reach the Docker daemon",
    )


@dataclass
class HostPaths:
    home: str
    # `~/devel` is not a link, but a component of the home directory can be
    # one. The unresolved path is the one that the container sees, and every
    # path that is derived from it is unresolved too. The resolved path serves
    # the mount source and the comparisons with other resolved paths.
    devel_dir: str
    resolved_devel_dir: str
    # The dotfiles repository holds the helper scripts, the Dockerfile, and
    # the origin of the profile directories. It is also the default project.
    dotfiles_dir: str
    resolved_dotfiles_dir: str
    # The directory that every launch copies into the profile directory.
    origin_dir: str
    resolved_origin_dir: str
    dockerfile_path: str
    user_config_path: str


def resolve_host_paths():
    home = os.environ.get("HOME")
    if not home:
        die("HOME is not set")
    # Every path that is built from the home directory would otherwise depend
    # on the current directory, on the host and inside the container alike.
    if not os.path.isabs(home):
        die(f"HOME is {home}, expected an absolute path")
    # A trailing slash or a doubled separator would end up in every path that
    # is built from the home directory, such as `CLAUDE_CONFIG_DIR`.
    home = os.path.normpath(home)

    devel_dir = os.path.join(home, "devel")
    # The container sees `~/devel` through one mount at this path. A link
    # inside it whose target goes through the real path of `~/devel` does not
    # resolve inside the container, so the real path and this path must be
    # the same directory entry. See `resolve_project_dirs` for the same rule
    # on the projects.
    if os.path.islink(devel_dir):
        die(f"{devel_dir} is a link, expected a real directory")
    resolved_devel_dir = os.path.realpath(devel_dir)
    if not os.path.isdir(resolved_devel_dir):
        die(f"{devel_dir} does not exist")

    dotfiles_dir = os.path.join(devel_dir, "dotfiles")

    origin_dir = f"{home}/.claude-origin"
    if not os.path.isdir(origin_dir):
        die(f"{origin_dir} does not exist or is not a directory")

    return HostPaths(
        home=home,
        devel_dir=devel_dir,
        resolved_devel_dir=resolved_devel_dir,
        dotfiles_dir=dotfiles_dir,
        resolved_dotfiles_dir=os.path.realpath(dotfiles_dir),
        origin_dir=origin_dir,
        resolved_origin_dir=os.path.realpath(origin_dir),
        dockerfile_path=os.path.join(
            dotfiles_dir, "references", "ai_containers", "Dockerfile"
        ),
        user_config_path=f"{home}/config.json",
    )


def resolve_username():
    try:
        return pwd.getpwuid(os.getuid()).pw_name
    except KeyError:
        die(f"user ID {os.getuid()} has no entry in the password database")


# --------------------------------------------------------------------------------------
# Projects.
# --------------------------------------------------------------------------------------


def list_project_dirs(dotfiles_dir):
    try:
        result = subprocess.run(
            [os.path.join(dotfiles_dir, "bin", "list_project_dirs")],
            stdout=subprocess.PIPE,
            encoding="utf-8",
            errors="replace",
        )
    except OSError as error:
        die(f"cannot run list_project_dirs: {error}")
    if result.returncode != 0:
        die("list_project_dirs failed")
    # An empty line would join to `~/devel` itself, and that path contains
    # every directory that the launcher compares against it.
    return [line for line in result.stdout.splitlines() if line]


@dataclass
class ProjectDir:
    # The path relative to `~/devel`, as `list_project_dirs` reports it.
    relative_path: str
    # The unresolved path. The `~/devel` mount exposes this path inside the
    # container, so it is the one that every container-side path uses.
    path: str
    # The path with links resolved, for comparisons with other resolved paths.
    # No component below `~/devel` is a link, so the two paths differ only
    # when a component of the home directory is one.
    resolved_path: str


def resolve_project_dirs(relative_project_dirs, devel_dir):
    # The container sees `~/devel` through one mount. A link inside it whose
    # target goes through the real path of `~/devel` does not resolve inside
    # the container, and a link to another project makes `list_project_dirs`
    # report two names for one directory, where the name decides the profile.
    # So a project, and every directory between `~/devel` and it, must be a
    # real directory. See `find_link_component` for the check.
    project_dirs = []
    for relative_project_dir in relative_project_dirs:
        link = find_link_component(devel_dir, relative_project_dir)
        if link is not None:
            die(
                f"{link} is a link, expected a real directory. Projects, and "
                f"the directories between {devel_dir} and them, cannot be links"
            )
        path = os.path.join(devel_dir, relative_project_dir)
        if not os.path.isdir(path):
            # The output of `list_project_dirs` is decoded with replacement
            # characters, so a name that is not valid UTF-8 comes out as a
            # path that does not exist. The harness refuses to start on such
            # a path.
            log(f"Warning: {path} does not exist, skipping it")
            continue
        project_dirs.append(
            ProjectDir(
                relative_path=relative_project_dir,
                path=path,
                resolved_path=os.path.realpath(path),
            )
        )
    return project_dirs


def find_link_component(devel_dir, relative_project_dir):
    # Returns the first path on the way from `devel_dir` down to the project
    # that is a link, or `None` when every component is a real directory.
    path = devel_dir
    for component in relative_project_dir.split("/"):
        path = os.path.join(path, component)
        if os.path.islink(path):
            return path
    return None


def resolve_current_project_root(paths, project_dirs):
    # Everything that follows works on the project root. A run from a
    # subdirectory of the project must behave like a run from the root.
    try:
        current_dir = os.path.realpath(os.getcwd())
    except OSError as error:
        die(f"cannot read the current directory: {error}")
    project_root = find_project_root(current_dir, project_dirs)
    if project_root is None:
        # A directory under `~/devel` that is inside no project is an
        # organization directory, or a repository that a
        # `.list_project_dirs_ignore` file keeps out of the list. The default
        # below would start the agent on the dotfiles repository, where it can
        # edit the scripts that run on the host, and the ignore file asks for
        # the opposite. So the default applies only outside of `~/devel`.
        # `~/devel` itself is inside no project either, and counts as under.
        if current_dir == paths.resolved_devel_dir or is_below(
            current_dir, paths.resolved_devel_dir
        ):
            die(
                f"{current_dir} is {paths.devel_dir} or under it, but inside no "
                "project. Run from a project directory, or from outside "
                f"{paths.devel_dir} to work on {paths.dotfiles_dir}"
            )
        # The dotfiles repository is a project, so `resolve_project_dirs`
        # refuses a link there. The check stays for a repository that
        # `list_project_dirs` does not report. The container would fail to
        # enter a directory that it cannot see.
        if not is_below(paths.resolved_dotfiles_dir, paths.resolved_devel_dir):
            die(
                f"{paths.dotfiles_dir} resolves to "
                f"{paths.resolved_dotfiles_dir}, which is outside {paths.devel_dir} "
                "and is not visible inside the container"
            )
        project_root = paths.dotfiles_dir
        log(f"Outside {paths.devel_dir}, defaulting to {project_root}")
    return project_root


def find_project_root(current_dir, project_dirs):
    # `current_dir` is already resolved, so the comparison runs on resolved
    # paths. Return the unresolved path, because that is the path that the
    # `~/devel` mount exposes inside the container.
    #
    # Longest resolved path first, so a nested project wins over a parent
    # directory that is a project too. The comparison runs on resolved paths,
    # so the order must come from them as well.
    candidates = sorted(
        project_dirs,
        key=lambda project_dir: len(project_dir.resolved_path),
        reverse=True,
    )

    for project_dir in candidates:
        if current_dir == project_dir.resolved_path or is_below(
            current_dir, project_dir.resolved_path
        ):
            return project_dir.path
    return None


def strip_leading_path(path, prefix):
    if is_below(path, prefix):
        return path[len(prefix) + 1 :]
    return path


# --------------------------------------------------------------------------------------
# Options.
# --------------------------------------------------------------------------------------


@dataclass
class Options:
    profile: str = ""
    # Whether the profile came from the project instead of from `--profile`.
    profile_detected: bool = False
    channel: str = DEFAULT_CLAUDE_CODE_CHANNEL
    process_output: bool = False
    force_rebuild: bool = False
    no_rebuild: bool = False
    allow_stale: bool = False
    no_docker_socket: bool = False
    verbose: bool = False
    harness_print_mode: bool = False
    harness_args: list[str] = field(default_factory=list)


def parse_options(argv, project_name, username):
    options = Options()

    # A repeated value option would win silently over the first one, so
    # refuse it.
    seen_value_options = set()

    def set_value_option(option_name, value):
        if option_name in seen_value_options:
            die(f"{option_name} was given more than once")
        seen_value_options.add(option_name)
        setattr(options, VALUE_OPTIONS[option_name], value)

    index = 0
    while index < len(argv):
        argument = argv[index]
        # Accept both `--option value` and `--option=value`.
        option_name, separator, inline_value = argument.partition("=")
        has_inline_value = bool(separator)
        if has_inline_value and option_name in VALUE_OPTIONS:
            if not inline_value:
                die(f"{option_name} requires a non-empty argument")
            set_value_option(option_name, inline_value)
            index += 1
        elif has_inline_value and option_name in FLAG_OPTIONS:
            die(f"{option_name} does not take a value")
        elif argument in VALUE_OPTIONS:
            index += 1
            if index >= len(argv) or not argv[index]:
                die(f"{argument} requires a non-empty argument")
            if argv[index].startswith("-"):
                die(
                    f"{argument} requires a value, and a value cannot start "
                    f"with `-`. Got '{argv[index]}'"
                )
            set_value_option(argument, argv[index])
            index += 1
        elif argument in FLAG_OPTIONS:
            setattr(options, FLAG_OPTIONS[argument], True)
            index += 1
        elif argument == "--":
            options.harness_args = argv[index + 1 :]
            break
        else:
            die(f"Unknown option '{argument}'. Put harness arguments after `--`")

    harness_print_mode, harness_json_output = scan_harness_args(options.harness_args)
    options.harness_print_mode = harness_print_mode

    # Validate that `--process-output` is only used with
    # `--print --output-format json`.
    if options.process_output:
        if not harness_print_mode or not harness_json_output:
            die(
                "`--process-output` requires `--print` and "
                "`--output-format json` in harness args"
            )

    if options.no_rebuild and options.force_rebuild:
        die("--no-rebuild conflicts with --force-rebuild")

    # The channel becomes the image tag, so it must follow the Docker tag
    # grammar. That grammar also covers version numbers such as `2.1.0`.
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}", options.channel):
        die(f"Invalid channel name '{options.channel}'")

    options.profile_detected = not options.profile
    profile_source = ""
    if options.profile_detected:
        options.profile, profile_source = detect_profile(project_name, username)
    # The profile becomes part of a directory name, so it must stay a single
    # path component without a leading dot or hyphen.
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}", options.profile):
        if options.profile_detected:
            die(
                f"Invalid profile name '{options.profile}' detected from "
                f"{profile_source}. Use --profile to choose another one"
            )
        die(f"Invalid profile name '{options.profile}'")

    return options


def scan_harness_args(harness_args):
    # Returns whether the harness arguments ask for print mode, and whether
    # they ask for JSON output. The scan reads the arguments the way that the
    # harness does. A prompt that spells `--print` is a flag for the harness
    # too, and everything after a `--` is positional for both.
    print_mode = False
    json_output = False
    previous_argument = ""
    for argument in harness_args:
        if argument == "--":
            break

        if argument in ("--print", "-p"):
            print_mode = True

        if argument == "--output-format=json" or (
            previous_argument == "--output-format" and argument == "json"
        ):
            json_output = True

        previous_argument = argument
    return print_mode, json_output


def detect_profile(project_name, username):
    # Returns the profile and a description of where it came from, for
    # messages. A project inside an organization directory, such as
    # `orgname/project`, takes the organization as its profile. A top-level
    # project takes the user name.
    first_component, separator, _ = project_name.partition("/")
    if separator:
        return first_component, "the project"
    return username, "the user name"


# --------------------------------------------------------------------------------------
# Profile paths.
# --------------------------------------------------------------------------------------


@dataclass
class ProfilePaths:
    # The directory with the login, history, and credentials of the profile.
    profile_dir: str
    # The host directory of the user under `/tmp`, named after the launcher
    # and the user. The profile directory below is inside it, so two users
    # with the same profile name do not collide.
    user_tmp_dir: str
    # The host directory that every container of the profile mounts at the
    # same path. The directory below is inside it.
    profile_tmp_dir: str
    # The directory where the hook scripts write. The `AGENT_SHARED_DIR`
    # variable names it inside the container.
    shared_dir: str
    # The directory of the user, `TMUX_PANE_STATES_DIR_PREFIX` followed by the
    # user name. See the `tmux` section of the help.
    pane_states_dir: str
    # The directory of the profile below `LAUNCHER_STATE_DIR_NAME`, where the
    # launcher keeps what the agent must not touch: the manifest and the lock.
    state_dir: str


def resolve_profile_paths(home, username, profile):
    # The directory carries the `ai-` prefix, so it never overlaps with a
    # `/tmp/<user>` directory that another tool keeps, whose mode the launcher
    # would otherwise tighten.
    user_tmp_dir = f"/tmp/ai-{username}"
    profile_tmp_dir = f"{user_tmp_dir}/{profile}"
    return ProfilePaths(
        profile_dir=f"{home}/.claude-{profile}",
        user_tmp_dir=user_tmp_dir,
        profile_tmp_dir=profile_tmp_dir,
        shared_dir=f"{profile_tmp_dir}/claude-code-shared",
        pane_states_dir=f"{TMUX_PANE_STATES_DIR_PREFIX}{username}",
        state_dir=f"{home}/{LAUNCHER_STATE_DIR_NAME}/{profile}",
    )


def check_origin_dir(paths, profile, profile_dir):
    # The origin is copied into the profile directory. A profile that resolves
    # to the origin itself would rewrite the origin in place. A profile that
    # resolves to a directory below the origin would write into the origin and
    # copy the directory into itself.
    resolved_profile_dir = os.path.realpath(profile_dir)
    if resolved_profile_dir == paths.resolved_origin_dir or is_below(
        resolved_profile_dir, paths.resolved_origin_dir
    ):
        die(f"profile '{profile}' resolves into the origin directory")
    # The container sees the host only through its mounts. The `~/devel` mount
    # is read-write, and the dotfiles repository is the one part of it that is
    # mounted read-only, so an origin elsewhere under `~/devel` is open to the
    # agent. An origin outside of `~/devel` is not visible in the container,
    # so the agent cannot reach it, and no warning is due.
    resolved_origin_dir = paths.resolved_origin_dir
    if is_below(resolved_origin_dir, paths.resolved_devel_dir) and not is_below(
        resolved_origin_dir, paths.resolved_dotfiles_dir
    ):
        log(
            f"Warning: {paths.origin_dir} resolves to {resolved_origin_dir}, "
            f"inside {paths.devel_dir} but outside {paths.dotfiles_dir}. The "
            f"read-write mount of {paths.devel_dir} exposes it, so the agent "
            "can change the origin."
        )


# --------------------------------------------------------------------------------------
# User configuration.
# --------------------------------------------------------------------------------------


def load_user_config(config_path):
    # The file holds API keys, so it must be a regular file that belongs to
    # the user who runs the launcher, with no group or other access. See
    # `open_owned_regular_file` for the first three checks.
    try:
        descriptor, info = open_owned_regular_file(config_path, os.O_RDONLY)
    except FileNotFoundError:
        return None

    file_perms = stat.S_IMODE(info.st_mode)
    if file_perms & 0o077:
        die(
            f"{config_path} has permissions {file_perms:o}, expected "
            "no group or other access"
        )
    try:
        with os.fdopen(descriptor, encoding="utf-8") as handle:
            config = json.load(handle)
    except ValueError as error:
        die(f"{config_path} is not valid JSON: {error}")
    except OSError as error:
        die(f"cannot read {config_path}: {error}")
    if not isinstance(config, dict):
        die(f"{config_path} is not a JSON object")

    return config


def has_profile_entry(config, profile):
    return profile_node(config, profile) is not _MISSING


def check_profile_without_entry(
    profile_detected, profile, profile_dir, config, config_path
):
    # A profile without an entry is a supported configuration, so a detected
    # profile only warns. An explicit `--profile` with neither an entry nor a
    # profile directory is almost always a typo. The launch would create a new
    # profile directory and ask for a login. An existing directory says that
    # the profile is in use, so it passes without an entry.
    if not profile_detected and not os.path.isdir(profile_dir):
        if config is None:
            die(
                f"profile '{profile}' has no directory {profile_dir}, and there "
                f"is no {config_path} with an entry for it. Create the directory "
                "to start a new profile without an entry"
            )
        known_profiles = list_profiles(config)
        known = ""
        if known_profiles is not None:
            known = f" Known profiles: {', '.join(known_profiles) or 'none'}."
        die(
            f"profile '{profile}' has no entry in {config_path} and no "
            f"directory {profile_dir}.{known} Add an entry, or create the "
            "directory to start a new profile without one"
        )
    if config is not None:
        log(f"Warning: {config_path} has no entry for profile '{profile}'")


def list_profiles(config):
    # Returns the names in the `profiles` object, or `None` when the
    # configuration has no such object.
    claude_code = config.get("claude_code")
    if not isinstance(claude_code, dict):
        return None
    profiles = claude_code.get("profiles")
    if not isinstance(profiles, dict):
        return None
    return sorted(profiles)


def resolve_api_key(config, profile):
    api_key = profile_setting(config, profile, "api_key", default="")
    if not isinstance(api_key, str):
        die(f"the `api_key` of profile '{profile}' is not text")
    # A key pasted into the file or exported in a shell can carry a trailing
    # newline or spaces, and the API would reject the key with them.
    api_key = api_key.strip()

    # The account of the key that wins pays for the session, so name the
    # source whenever the environment key is used, not only when it wins over
    # the key of the profile.
    from_environment = os.environ.get("ANTHROPIC_API_KEY", "").strip()
    if from_environment:
        log(f"API key: ANTHROPIC_API_KEY from the environment, for profile '{profile}'")
        if api_key:
            log(
                "Warning: the environment key takes precedence over the "
                f"`api_key` of profile '{profile}'"
            )
        return from_environment

    # An empty key is a supported configuration. Claude Code then uses OAuth
    # credentials or asks the user to log in.
    if api_key:
        log(f"API key: `api_key` of profile '{profile}'")
    else:
        log("API key: none, Claude Code will use OAuth credentials")
    return api_key


def profile_setting(config, profile, key, default=None):
    # Returns the value of `key` in the object of the profile. Returns
    # `default` when there is no configuration file, no object for the
    # profile, no such key, or a `null` value.
    if config is None:
        return default
    node = profile_node(config, profile)
    if node is _MISSING:
        return default
    value = node.get(key)
    return default if value is None else value


def profile_node(config, profile):
    # Returns the object of the profile, or `_MISSING` when there is none. A
    # key on the way that holds something other than an object is an error,
    # because a fallback to the defaults would hide the mistake.
    node = config
    path = []
    for step in ("claude_code", "profiles", profile):
        path.append(step)
        node = node.get(step, _MISSING)
        if node is _MISSING:
            return _MISSING
        if not isinstance(node, dict):
            die(f"`{'.'.join(path)}` in the configuration file is not a JSON object")
    return node


# --------------------------------------------------------------------------------------
# Temporary directories.
# --------------------------------------------------------------------------------------


def prepare_tmp_dirs(tmp_dirs):
    # `tmp_dirs` holds `(path, mode)` pairs, parents before children. `/tmp`
    # is world-writable, so another local user can create these paths first,
    # as directories or as symbolic links into a directory that the user owns.
    # The container mounts them and host scripts read them, so each one must
    # be a real directory that belongs to the user who runs the launcher, and
    # that no other user can write to. See `ensure_directory` for the type
    # check. An existing directory is set to the mode as well. That can loosen
    # a directory that a strict umask created, or tighten one that a loose
    # umask created, which is fine, because every mode here is the one that
    # the directory is meant to have.
    #
    # A path that cannot be created is fatal. Docker would create the missing
    # mount source on the host as a directory owned by `root`.
    for path, mode in tmp_dirs:
        try:
            info = ensure_directory(path, mode)
        except OSError as error:
            die(f"cannot prepare {path}: {error}")
        if info.st_uid != os.getuid():
            # Only a directory whose parent is world-writable can belong to
            # another user, and such a parent has the sticky bit, which keeps
            # the user from removing it. The fix is not theirs to run.
            die(
                f"{path} is owned by user ID {info.st_uid}, not by you. Ask "
                "that user or an administrator to remove it"
            )
        if stat.S_IMODE(info.st_mode) & 0o022:
            # The directory belongs to the user, so the mode change below is
            # theirs to make. Another user could have written into it while
            # it was open, so the line asks them to look.
            log(
                f"Warning: {path} was writable by other users, setting its mode "
                f"to {mode:o}. Check its contents"
            )
        if stat.S_IMODE(info.st_mode) != mode:
            try:
                os.chmod(path, mode)
            except OSError as error:
                die(f"cannot set the mode of {path}: {error}")
        if not os.access(path, os.W_OK | os.X_OK):
            die(f"{path} is not writable")


# --------------------------------------------------------------------------------------
# Docker image.
# --------------------------------------------------------------------------------------


def build_image_name(username, channel):
    # A Docker repository name allows one separator between two runs of
    # letters and digits, so collapse every run of separators into one.
    sanitized = re.sub(r"[^a-z0-9._-]", "", username.lower())
    # Truncate before the strip, so the result never ends in a separator.
    sanitized = re.sub(r"[._-]{2,}", "-", sanitized)[:IMAGE_NAME_USER_LENGTH]
    sanitized = sanitized.strip("._-")
    if not sanitized:
        die(f"cannot build an image name from user name '{username}'")
    # Two user names can come out of the sanitization as the same string, and
    # the image bakes in the user ID and the home directory of one user, so the
    # user ID is part of the name. Two users then never share an image.
    return f"{sanitized}-{os.getuid()}-claude:{channel}"


@dataclass
class ImageSpec:
    # The image reference, `<repository>:<channel>`.
    name: str
    # The Claude Code release channel or version that the image installs. It
    # is also the tag of the image.
    channel: str
    dockerfile_path: str
    # The home directory that the image bakes in.
    home: str
    # The file that the launches which build this image lock.
    lock_path: str


def ensure_image(options, image_spec):
    # Two launches on a new day would both see a stale image and both build
    # it. The lock makes them take turns, and the second one then inspects
    # the image that the first one built. The inspection runs inside the lock
    # for that reason.
    with file_lock(
        image_spec.lock_path,
        f"Waiting for another launch that builds '{image_spec.name}'...",
    ):
        ensure_image_locked(options, image_spec)


def ensure_image_locked(options, image_spec):
    # The local date, so that a new day starts when it starts for the user,
    # and the message that names the day matches the clock on the wall.
    today = datetime.date.today()

    image_info = get_image_info(image_spec.name)

    if options.no_rebuild:
        if image_info is None:
            die(
                f"Docker image '{image_spec.name}' does not exist and "
                "--no-rebuild was specified"
            )
        # No build runs, so the Dockerfile is not read, and a change to it is
        # not among the reasons that this branch reports.
        rebuild_reason = get_rebuild_reason(
            options, image_info, None, today, image_spec.channel
        )
        if rebuild_reason:
            log(f"--no-rebuild specified, skipping rebuild despite: {rebuild_reason}")
        else:
            log("Skipping rebuild (--no-rebuild specified, image is up to date)")
        return

    dockerfile = read_dockerfile(image_spec.dockerfile_path)
    rebuild_reason = get_rebuild_reason(
        options, image_info, dockerfile, today, image_spec.channel
    )

    if rebuild_reason is None:
        log("Image is up to date, skipping rebuild")
        return

    log(f"Rebuilding image: {rebuild_reason}")

    # A missing Dockerfile is a build failure like any other. See
    # `read_dockerfile` for the warning that names the cause.
    #
    # The build busts its cache with the date of the day, so a cached build on
    # the same day reuses every layer and installs the same release again. A
    # forced rebuild is a request for a new image, so it runs without cache.
    if dockerfile is None:
        failure = "no Dockerfile to build from"
    elif build_image(
        image_spec, dockerfile, today, use_cache=not options.force_rebuild
    ):
        return
    else:
        failure = "Docker build failed"

    if not options.allow_stale:
        die(failure)

    if image_info is None:
        die(f"{failure}, and no existing image '{image_spec.name}' found")

    log(f"Using existing image (--allow-stale): {failure}")


def get_rebuild_reason(options, image_info, dockerfile, today, channel):
    if options.force_rebuild:
        return "--force-rebuild specified"
    if image_info is None:
        return "image does not exist"
    # An image without the label did not come from this script, so its
    # content is unknown, and a pinned version does not spare it.
    if not image_info.build_date:
        return "image has no build date label"
    if image_info.build_date != f"{today:%Y-%m-%d}" and not is_pinned_version(channel):
        return f"image is from {image_info.build_date}, today is {today:%Y-%m-%d}"
    if dockerfile is not None and image_info.dockerfile_digest != dockerfile.digest:
        return "Dockerfile changed since last build"
    return None


def is_pinned_version(channel):
    # `latest` and `stable` move, so an image from another day can hold an
    # older release. A version number names one release, and a rebuild would
    # install the same binary again.
    return re.fullmatch(r"\d+\.\d+\.\d+", channel) is not None


@dataclass
class Dockerfile:
    content: bytes
    digest: str


def read_dockerfile(dockerfile_path):
    # Returns `None` when the file cannot be read. The caller decides whether
    # that is fatal, because an existing image can still run without it.
    try:
        with open(dockerfile_path, "rb") as handle:
            content = handle.read()
    except OSError as error:
        log(f"Warning: cannot read {dockerfile_path}: {error}")
        return None
    return Dockerfile(content=content, digest=hashlib.sha256(content).hexdigest())


@dataclass
class ImageInfo:
    # Both fields come from labels that `build_image` stamps, and both are
    # empty for an image that no build of this script labeled, such as one
    # that came in through `docker load`. The build date is a `YYYY-MM-DD`
    # string, so that it compares with the date of today without a zone.
    build_date: str
    dockerfile_digest: str


def get_image_info(docker_image_name):
    # Returns `None` when the image does not exist. The existence check and
    # the inspection are two commands, because `docker image inspect` reports
    # a missing image and any other failure alike, and the two cases must not
    # be confused. A missing image is the expected case on the first launch of
    # a channel. Any other failure must not pass as a missing image, because
    # that would start a full build or make `--no-rebuild` report the wrong
    # cause.
    if not image_exists(docker_image_name):
        return None

    # The build date comes from a label and not from the image metadata,
    # because not every image store records the time of a tag.
    output = run_docker_or_die(
        [
            "image",
            "inspect",
            docker_image_name,
            "--format",
            f'{{{{index .Config.Labels "{BUILD_DATE_LABEL}"}}}}\t'
            f'{{{{index .Config.Labels "{DOCKERFILE_DIGEST_LABEL}"}}}}',
        ],
        "docker image inspect failed",
    )

    # The template prints an empty string for a label that the image does not
    # have, so both fields come out empty in that case.
    build_date, _, dockerfile_digest = output.rstrip("\n").partition("\t")
    return ImageInfo(build_date=build_date, dockerfile_digest=dockerfile_digest)


def image_exists(docker_image_name):
    # `docker image ls` exits with success and prints nothing for an image
    # that does not exist, so the check does not depend on the text of an
    # error message.
    output = run_docker_or_die(
        ["image", "ls", "--quiet", docker_image_name], "docker image ls failed"
    )
    return bool(output.strip())


def build_image(image_spec, dockerfile, today, *, use_cache):
    log("Building Docker image...")

    build_args = [
        "--label",
        f"{DOCKERFILE_DIGEST_LABEL}={dockerfile.digest}",
        "--label",
        f"{BUILD_DATE_LABEL}={today:%Y-%m-%d}",
        "--build-arg",
        f"UID={os.getuid()}",
        "--build-arg",
        f"GID={os.getgid()}",
        "--build-arg",
        f"HOME={image_spec.home}",
        "--build-arg",
        f"BUILD_DATE={today:%Y-%m-%d}",
    ]

    log(f"Installing Claude Code from channel '{image_spec.channel}'...")
    build_args += ["--build-arg", f"CLAUDE_CODE_CHANNEL={image_spec.channel}"]

    # A cache-less build must not keep a stale base image either, so it pulls
    # the base image again as well.
    if not use_cache:
        log("Building from scratch without cache...")
        build_args += [
            "--pull",
            "--no-cache",
        ]

    build_args += ["--tag", image_spec.name]

    # Pipe the Dockerfile via stdin (`-`) so no build context is sent.
    result = run_docker(
        ["build", *build_args, "-"],
        input=dockerfile.content,
        stdout=sys.stderr,
    )
    return result.returncode == 0


# --------------------------------------------------------------------------------------
# Profile directory.
# --------------------------------------------------------------------------------------

# Planted links. The agent can write to the profile directory from inside the
# container, so any path below it can turn into a link, a FIFO, or a directory
# that the agent planted, at any moment after a check on that path. A link
# would redirect a write, a chmod, or a read to a file elsewhere on the host,
# where the launcher runs as the user. The functions in this section therefore
# check with `lstat`, open through `open_without_following`, and send content,
# modes, and times to descriptors instead of paths. Below the top level, the
# parent directory can turn into a link as well, so the copy holds a
# descriptor of every directory that it works in, and names entries relative
# to that descriptor. The top level is the profile directory itself, which the
# container mounts, so the agent cannot replace it. Each site names this note.


@dataclass
class ProfilePrep:
    # The directory that is copied into the profile directory.
    origin_dir: str
    # The directory with the login, history, and credentials of the profile.
    profile_dir: str
    # The directory where the launcher keeps the manifest and the lock of the
    # profile. No mount exposes it.
    state_dir: str
    # The parsed `~/config.json`, or `None` when there is no such file.
    user_config: dict | None
    profile: str
    api_key: str
    # The paths of the dependency projects relative to `~/devel`, for the
    # dependencies list in the profile `CLAUDE.md`.
    dependency_names: list[str]


def prepare_profile_dir(profile_prep):
    profile_dir = profile_prep.profile_dir
    state_dir = profile_prep.state_dir

    # The origin is mirrored into the profile directory, and every check on
    # the way refuses a link. A profile directory that is a link would fail
    # deeper in the copy with a message that does not name the link.
    if os.path.islink(profile_dir):
        die(
            f"{profile_dir} is a link, expected a real directory. The launcher "
            "mirrors the origin into it and does not follow links there"
        )

    # The directory holds credentials and chat history. `makedirs` applies the
    # mode only to a directory that it creates, so tighten an existing one too.
    try:
        os.makedirs(profile_dir, mode=0o700, exist_ok=True)
    except OSError as error:
        die(f"cannot create {profile_dir}: {error}")
    try:
        os.chmod(profile_dir, 0o700)
    except OSError as error:
        log(f"Warning: cannot set the mode of {profile_dir}: {error}")

    # The state directory holds the lock below, and the launch cannot go on
    # without the lock, so a failure to create it is fatal. `makedirs` applies
    # the mode to the last directory only, so the parent is created on its own
    # to get it too. `mkdir` applies the mode only to a directory that it
    # creates, so tighten an existing one as well.
    for directory in (os.path.dirname(state_dir), state_dir):
        try:
            os.mkdir(directory, 0o700)
        except FileExistsError:
            pass
        except OSError as error:
            die(f"cannot create {directory}: {error}")
        try:
            os.chmod(directory, 0o700)
        except OSError as error:
            log(f"Warning: cannot set the mode of {directory}: {error}")

    # Two launches of the same profile at the same time would race. One of
    # them mirrors a directory while the other has a temporary file in it,
    # and the mirror removes that file before the rename. The lock makes the
    # launches take turns. The lock file sits in the state directory, which
    # no mount exposes, so the agent cannot hold the lock from inside the
    # container, nor replace the file with something that fails the open.
    lock_path = f"{state_dir}/{LOCK_NAME}"
    with file_lock(
        lock_path,
        f"Waiting for another launch that prepares profile '{profile_prep.profile}'...",
    ):
        # The sweep runs inside the lock, so it never removes a file that
        # another launch is about to rename. The state directory belongs to
        # this profile alone, so the same lock covers it.
        for directory in (profile_dir, state_dir):
            try:
                remove_stale_temp_files(directory)
            except OSError as error:
                log(f"Warning: cannot remove temporary files in {directory}: {error}")

        # The profile directory also holds history and credentials, so only
        # the directories that the origin has are mirrored. The top level is
        # not. `settings.json` and `CLAUDE.md` are derived files, so the copy
        # skips them. See `apply_settings` and `apply_dependencies_list`.
        try:
            copied_names = copy_tree_contents(
                profile_prep.origin_dir,
                profile_dir,
                mirror=False,
                skip=("settings.json", "CLAUDE.md"),
            )
        except OSError as error:
            die(f"cannot copy {profile_prep.origin_dir}: {error}")

        # A derived file counts as installed when the origin holds it, so the
        # manifest treats it like a copied entry, and one rule removes every
        # top-level entry that the origin dropped.
        installed_names = set(copied_names)

        if apply_settings(
            profile_prep.user_config,
            profile_prep.profile,
            profile_prep.origin_dir,
            profile_dir,
        ):
            installed_names.add("settings.json")

        if apply_dependencies_list(
            f"{profile_prep.origin_dir}/CLAUDE.md",
            f"{profile_dir}/CLAUDE.md",
            profile_prep.dependency_names,
        ):
            installed_names.add("CLAUDE.md")

        remove_entries_gone_from_origin(
            profile_dir, f"{state_dir}/{MANIFEST_NAME}", installed_names
        )

        profile_json_path = f"{profile_dir}/.claude.json"
        create_profile_json(profile_json_path)
        update_profile_json(
            profile_json_path,
            profile_prep.api_key,
            profile_prep.user_config,
            profile_prep.profile,
        )


def remove_stale_temp_files(directory):
    # Removes the temporary files of a launch that died before the rename.
    # Only the top level of the profile directory needs this sweep, see
    # `copy_tree_into` for the nested directories. Collect the entries first.
    # Removal during the scan is undefined.
    with os.scandir(directory) as entries:
        stale_paths = [
            entry.path for entry in entries if entry.name.startswith(TEMP_FILE_PREFIX)
        ]
    for stale_path in stale_paths:
        remove_path(stale_path)


def copy_tree_contents(source, destination, *, mirror, skip=()):
    # With `mirror`, the destination ends up with the same entries as the
    # source, and entries that the source does not have are removed. Without
    # it, the destination keeps its other entries. Top-level entries named in
    # `skip` are not copied, and the destination keeps its own version.
    # Returns the names of the top-level entries that were copied.
    #
    # The destination can be a planted link, see the section note above and
    # `open_directory`. The mode covers only a directory that the `mkdir`
    # creates.
    try:
        os.mkdir(destination, 0o700)
    except FileExistsError:
        pass
    destination_fd = open_directory(destination, destination)
    try:
        return copy_tree_into(
            source, destination_fd, destination, mirror=mirror, skip=skip
        )
    finally:
        os.close(destination_fd)


def copy_tree_into(source, destination_fd, destination_path, *, mirror, skip=()):
    # Copies the entries of the directory `source` into the directory that
    # `destination_fd` names. `destination_path` is that directory for
    # messages only. See `copy_tree_contents` for `mirror` and `skip`, and the
    # section note above for the descriptor.
    source_names = set()
    with os.scandir(source) as entries:
        for entry in entries:
            source_names.add(entry.name)
            if entry.name in skip:
                continue
            target_path = os.path.join(destination_path, entry.name)
            target_stat = lstat_entry(entry.name, destination_fd)
            if entry.is_symlink():
                # A link that already points to the same place is left alone,
                # so that a reader that watches the directory sees no change.
                link_target = os.readlink(entry.path)
                if target_stat is not None and stat.S_ISLNK(target_stat.st_mode):
                    if os.readlink(entry.name, dir_fd=destination_fd) == link_target:
                        continue
                if target_stat is not None:
                    remove_entry(entry.name, destination_fd)
                os.symlink(link_target, entry.name, dir_fd=destination_fd)
            elif entry.is_dir():
                if target_stat is not None and not stat.S_ISDIR(target_stat.st_mode):
                    remove_entry(entry.name, destination_fd)
                copy_directory(entry.path, entry.name, destination_fd, target_path)
            else:
                copy_file_atomically(
                    entry.path, entry.name, destination_fd, target_path
                )

    if mirror:
        # Collect the entries first. Removal during the scan is undefined.
        stale_names = [
            name for name in os.listdir(destination_fd) if name not in source_names
        ]
        for stale_name in stale_names:
            remove_entry(stale_name, destination_fd)

    return source_names - set(skip)


def copy_directory(source, name, parent_fd, path):
    # Mirrors the directory `source` into the entry `name` of the directory
    # that `parent_fd` names, and gives it the mode and the times of `source`.
    # `path` is the target for messages only. The mode covers only a directory
    # that the `mkdir` creates. A link that takes the place of the entry after
    # the `mkdir` fails the open, see the section note above.
    try:
        os.mkdir(name, 0o700, dir_fd=parent_fd)
    except FileExistsError:
        pass
    directory_fd = open_directory(name, path, dir_fd=parent_fd)
    try:
        copy_tree_into(source, directory_fd, path, mirror=True)
        copystat_if_changed(source, directory_fd)
    finally:
        os.close(directory_fd)


def lstat_entry(name, directory_fd):
    # Returns the `lstat` result of the entry `name` of the directory that
    # `directory_fd` names, or `None` when there is no such entry.
    try:
        return os.lstat(name, dir_fd=directory_fd)
    except FileNotFoundError:
        return None


def remove_entry(name, directory_fd):
    # Removes the entry `name` of the directory that `directory_fd` names,
    # whatever its type. A link is removed, not followed. `unlink` on a
    # directory fails with an error that differs between systems, so the type
    # decides the call.
    info = os.lstat(name, dir_fd=directory_fd)
    if stat.S_ISDIR(info.st_mode):
        shutil.rmtree(name, dir_fd=directory_fd)
    else:
        os.unlink(name, dir_fd=directory_fd)


def remove_entries_gone_from_origin(profile_dir, manifest_path, installed_names):
    # The top level of the profile directory is not mirrored, so an entry that
    # the origin no longer holds would stay in the profile forever. The
    # manifest at `manifest_path` lists the top-level entries that the
    # previous launch installed, and an entry on it that is not in
    # `installed_names` is removed. A failure only warns, because the launch
    # can go on without the removal.
    #
    # The manifest sits outside of every mount, so the agent cannot edit it.
    # A name with a separator would still make the removal reach outside of
    # the profile directory, so such a name is ignored. That keeps a corrupt
    # or hand-edited manifest inside the profile directory.
    try:
        previous_names = set(read_text(manifest_path).splitlines())
    except FileNotFoundError:
        previous_names = set()
    except (OSError, ValueError) as error:
        log(f"Warning: cannot read {manifest_path}: {error}")
        previous_names = set()

    # A name whose removal failed stays on the manifest, so the next launch
    # tries again.
    kept_names = set()
    for stale_name in sorted(previous_names - installed_names):
        if not is_plain_entry_name(stale_name):
            log(f"Warning: ignoring invalid name {stale_name!r} in {manifest_path}")
            continue
        if not remove_stale_profile_entry(f"{profile_dir}/{stale_name}"):
            kept_names.add(stale_name)

    manifest_names = installed_names | kept_names
    if previous_names == manifest_names:
        return
    try:
        write_text_atomically(
            manifest_path, "".join(f"{name}\n" for name in sorted(manifest_names))
        )
    except OSError as error:
        log(f"Warning: cannot write {manifest_path}: {error}")


def is_plain_entry_name(name):
    # Whether `name` is one directory entry, and not a path.
    return name not in ("", ".", "..") and "/" not in name and "\0" not in name


def copy_file_atomically(source, name, directory_fd, path):
    # Copies the regular file `source` to the entry `name` of the directory
    # that `directory_fd` names. `path` is the target for messages only.
    # Another session of the same profile can read the target at any moment,
    # so it must never see a partial file. A target with the same content is
    # left in place, so that a reader that watches the file sees no change.
    #
    # The target is reached through `directory_fd`, see the section note
    # above. A link that takes the place of the file after the `lstat` fails
    # the open, and the rename below then replaces the link itself. A
    # directory makes the rename fail, so one is removed first.
    target_stat = lstat_entry(name, directory_fd)
    if target_stat is not None and stat.S_ISREG(target_stat.st_mode):
        try:
            target_handle = open_regular_file(name, dir_fd=directory_fd)
        except OSError:
            target_handle = None
        if target_handle is not None:
            with target_handle:
                if has_same_content(source, target_handle):
                    copystat_if_changed(source, target_handle.fileno())
                    return
    elif target_stat is not None and stat.S_ISDIR(target_stat.st_mode):
        remove_entry(name, directory_fd)

    # The temporary file can turn into a planted link between the creation
    # and the copy, see the section note above. The content, the mode, and the
    # times go to the descriptor that `create_temp_file` returned, not to the
    # name.
    descriptor, temp_name = create_temp_file(directory_fd)
    try:
        # The handle takes the descriptor first, so that a failure in any call
        # below closes it. A call that ran before the handle existed would
        # leak the descriptor when it failed.
        with os.fdopen(descriptor, "wb") as temp_handle:
            source_stat = os.stat(source)
            with open(source, "rb") as source_handle:
                shutil.copyfileobj(source_handle, temp_handle)
            # The times must go last, and the buffer must be on disk first, or
            # the close writes the buffer and moves the modification time. The
            # sync makes the content durable before the rename, so a crash
            # right after the rename cannot leave an empty file at the target.
            temp_handle.flush()
            os.fsync(temp_handle.fileno())
            os.fchmod(temp_handle.fileno(), stat.S_IMODE(source_stat.st_mode))
            os.utime(
                temp_handle.fileno(),
                ns=(source_stat.st_atime_ns, source_stat.st_mtime_ns),
            )
        os.replace(temp_name, name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
    except BaseException:
        remove_file(temp_name, dir_fd=directory_fd)
        raise


def create_temp_file(directory_fd):
    # Creates a private temporary file in the directory that `directory_fd`
    # names, and returns its descriptor and its name. The name carries the
    # prefix that `remove_stale_temp_files` looks for. `O_EXCL` makes the open
    # fail when the name is taken, and another name is tried then.
    while True:
        name = f"{TEMP_FILE_PREFIX}{os.urandom(8).hex()}"
        try:
            descriptor = os.open(
                name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                0o600,
                dir_fd=directory_fd,
            )
        except FileExistsError:
            continue
        return descriptor, name


def has_same_content(source, target_handle):
    # Whether the open regular file `target_handle` has the content of
    # `source`.
    #
    # The agent can leave a large file at the target, so the sizes are
    # compared first, and the content is read in chunks. No step loads a whole
    # file into memory.
    target_size = os.fstat(target_handle.fileno()).st_size
    with open(source, "rb") as source_handle:
        if os.fstat(source_handle.fileno()).st_size != target_size:
            return False
        while True:
            source_chunk = source_handle.read(CONTENT_CHUNK_SIZE)
            if source_chunk != target_handle.read(CONTENT_CHUNK_SIZE):
                return False
            if not source_chunk:
                return True


def copystat_if_changed(source, descriptor):
    # Copies the mode and the times of `source` to the file or directory that
    # `descriptor` names. A change to the modification time is an event for a
    # watcher, so nothing is written when the metadata already matches.
    source_stat = os.stat(source)
    target_stat = os.fstat(descriptor)
    same_mtime = source_stat.st_mtime_ns == target_stat.st_mtime_ns
    same_mode = stat.S_IMODE(source_stat.st_mode) == stat.S_IMODE(target_stat.st_mode)
    if same_mtime and same_mode:
        return
    os.fchmod(descriptor, stat.S_IMODE(source_stat.st_mode))
    os.utime(descriptor, ns=(source_stat.st_atime_ns, source_stat.st_mtime_ns))


def sync_derived_file(origin_path, profile_path, read, write, transform):
    # Writes the profile file as the origin file with `transform` applied to
    # the content that `read` returns. `read` takes a `follow_links` keyword,
    # which is off for the profile file. `write` receives the origin path as
    # the source of the file mode. Returns whether the origin file exists.
    try:
        content = read(origin_path)
    except FileNotFoundError:
        # The profile copy of an earlier launch, if any, is not this
        # function's to remove. See `remove_entries_gone_from_origin`.
        return False
    except (OSError, ValueError) as error:
        log(f"Warning: cannot read {origin_path}: {error}")
        return True

    content = transform(content)

    # The profile path can be a planted directory or link, see the section
    # note above. A directory makes the write below fail, and a link makes the
    # comparison below read a file elsewhere on the host. Only a regular file
    # stays.
    if os.path.lexists(profile_path) and (
        os.path.islink(profile_path) or not os.path.isfile(profile_path)
    ):
        try:
            remove_path(profile_path)
        except OSError as error:
            log(f"Warning: cannot remove {profile_path}: {error}")
            return True
        log(f"Removed {profile_path}, it was not a regular file")

    # The result is written at most once, and only when it differs from the
    # current content. A running session of the same profile reads the profile
    # file, so it must not see the origin content and then the final content
    # on every launch.
    #
    # A link can appear at the profile path after the check above, see the
    # section note. The read refuses one, so a link counts as content that
    # differs, and the write below replaces the link itself.
    try:
        current_content = read(profile_path, follow_links=False)
    except (OSError, ValueError):
        current_content = _MISSING

    if current_content == content:
        return True
    try:
        write(profile_path, content, origin_path)
    except (OSError, ValueError) as error:
        log(f"Warning: cannot write {profile_path}: {error}")
        return True
    # A difference comes from an edit to the origin, or from an edit that
    # Claude Code or the user made to the profile file. The second kind is
    # lost here, so the reset is worth a line.
    if current_content is not _MISSING:
        log(f"Reset {profile_path}, it differed from the origin")
    return True


def apply_settings(config, profile, origin_dir, profile_dir):
    # The profile `settings.json` is the origin file with the `model` and the
    # `effortLevel` of the profile applied. Returns whether the origin file
    # exists.
    origin_settings = f"{origin_dir}/settings.json"
    profile_settings = f"{profile_dir}/settings.json"

    overrides = {}
    for key in ("model", "effortLevel"):
        value = resolve_profile_text_setting(config, profile, key)
        if value is not None:
            overrides[key] = value

    def set_overrides(settings):
        if not overrides:
            return settings
        if not isinstance(settings, dict):
            names = ", ".join(f"`{key}`" for key in overrides)
            log(f"Warning: {origin_settings} is not a JSON object, {names} not set")
            return settings
        settings.update(overrides)
        return settings

    origin_exists = sync_derived_file(
        origin_settings,
        profile_settings,
        read_json_file,
        write_json_file,
        set_overrides,
    )
    # The overrides go into a copy of the origin file, so without the file
    # there is nothing to put them in.
    if not origin_exists and overrides:
        names = ", ".join(f"`{key}`" for key in overrides)
        log(
            f"Warning: {origin_settings} does not exist, {names} of profile "
            f"'{profile}' not set"
        )
    return origin_exists


def remove_stale_profile_entry(path):
    # Removes the profile copy of an origin entry that no longer exists. The
    # top level of the profile directory is not mirrored, so the entries there
    # need this. A failure only warns, because the launch can go on without
    # it. Returns whether the path is gone.
    if not os.path.lexists(path):
        return True
    try:
        remove_path(path)
    except OSError as error:
        log(f"Warning: cannot remove {path}: {error}")
        return False
    log(f"Removed {path}, the origin does not have it")
    return True


def resolve_profile_text_setting(config, profile, key):
    # Returns the text value of `key` in the profile, or `None` when there is
    # none. An empty string counts as none, like an empty `api_key`.
    value = profile_setting(config, profile, key)
    if value is None:
        return None
    if not isinstance(value, str):
        log(
            f"Warning: the `{key}` of profile '{profile}' is not text, "
            f"`{key}` not set"
        )
        return None
    if not value:
        return None
    return value


def apply_dependencies_list(origin_claude_md, profile_claude_md, dependency_names):
    # The profile `CLAUDE.md` is the origin file with the dependencies marker
    # replaced by the list of dependency names. Without dependencies, the list
    # holds one `none` entry, so the marker never reaches the agent. Returns
    # whether the origin file exists.
    marker = "<!-- DEPENDENCIES_LIST -->"

    def expand(claude_md):
        if marker not in claude_md:
            return claude_md
        return expand_dependencies_marker(
            claude_md, marker, dependency_names or ["none"]
        )

    return sync_derived_file(
        origin_claude_md, profile_claude_md, read_text, write_text_atomically, expand
    )


def expand_dependencies_marker(claude_md, marker, dependency_names):
    # Only a line that holds the marker alone, with nothing but spaces around
    # it, is replaced. The list takes the indentation of that line. A marker
    # with other text on its line is left as it is.
    lines = []
    for line in claude_md.splitlines():
        if line.strip(" ") == marker:
            indent = line[: len(line) - len(line.lstrip(" "))]
            lines += [f"{indent}- {name}" for name in dependency_names]
        else:
            lines.append(line)
    return "".join(f"{line}\n" for line in lines)


def create_profile_json(profile_json_path):
    # Claude Code cannot start without this file, so a failure here is fatal.
    #
    # The path can be a planted link or directory, see the section note above.
    # The rename below fails on a directory with a message that does not name
    # the cause, so both are refused, and the user sees what is there before
    # it goes. The mode goes to a descriptor, and the open refuses a link that
    # appears after the check. See `open_without_following`.
    if os.path.islink(profile_json_path):
        die(f"{profile_json_path} is a link, expected a regular file. Remove it")
    if os.path.isdir(profile_json_path):
        die(f"{profile_json_path} is a directory, expected a regular file. Remove it")
    if not os.path.isfile(profile_json_path):
        try:
            write_text_atomically(profile_json_path, "{}\n")
        except OSError as error:
            die(f"cannot create {profile_json_path}: {error}")
    try:
        descriptor = open_without_following(profile_json_path)
    except OSError as error:
        log(f"Warning: cannot open {profile_json_path}: {error}")
        return
    try:
        os.fchmod(descriptor, 0o600)
    except OSError as error:
        log(f"Warning: cannot set the mode of {profile_json_path}: {error}")
    finally:
        os.close(descriptor)


def update_profile_json(profile_json_path, api_key, config, profile):
    # Every edit is applied to the parsed content, and the result is written
    # at most once. A running session of the same profile writes this file
    # too, so each launch must touch it as little as possible.
    #
    # A write from that session between the read and the replace would be
    # lost, so the replace happens only when the file did not change in
    # between. The check and the replace are not one step, so a narrow window
    # remains. A few attempts, one second apart, cover a session that writes
    # in a burst.
    #
    # The path can turn into a planted link after `create_profile_json`
    # checked it, see the section note above. The read goes through a
    # descriptor that refuses a link, the stat before the read comes from that
    # descriptor, and the stat before the write does not follow a link, so a
    # link that appears in between counts as a change and the write does not
    # happen.
    mcp_servers = resolve_mcp_servers(config, profile)
    approved_tail = resolve_approved_tail(api_key)
    if approved_tail is None and mcp_servers is None:
        return

    for attempt in range(PROFILE_JSON_WRITE_ATTEMPTS):
        if attempt > 0:
            time.sleep(1)
        try:
            with open_regular_file(profile_json_path) as handle:
                stat_before_read = os.fstat(handle.fileno())
                profile_json = json.load(handle)
        except (OSError, ValueError) as error:
            log(f"Warning: cannot read {profile_json_path}: {error}")
            return
        if not isinstance(profile_json, dict):
            log(f"Warning: {profile_json_path} is not a JSON object, not updated")
            return

        key_changed = approved_tail is not None and approve_api_key(
            profile_json, approved_tail
        )
        mcp_changed = mcp_servers is not None and apply_mcp_servers(
            profile_json, mcp_servers
        )
        if not key_changed and not mcp_changed:
            return

        try:
            stat_before_write = os.lstat(profile_json_path)
        except OSError as error:
            log(f"Warning: cannot read {profile_json_path}: {error}")
            return
        if (
            stat_before_write.st_mtime_ns != stat_before_read.st_mtime_ns
            or stat_before_write.st_ino != stat_before_read.st_ino
            or stat_before_write.st_size != stat_before_read.st_size
        ):
            continue

        try:
            write_json_file(profile_json_path, profile_json)
        except (OSError, ValueError) as error:
            log(f"Warning: cannot write {profile_json_path}: {error}")
            return
        if mcp_changed:
            log(f"MCP servers set for profile '{profile}'")
        return

    log(f"Warning: {profile_json_path} kept changing, not updated")


def resolve_approved_tail(api_key):
    # Returns the tail of the key that Claude Code records as approved, or
    # `None` when there is no key to approve.
    if not api_key:
        return None

    if len(api_key) <= APPROVED_KEY_TAIL_LENGTH:
        log(
            "Warning: the API key is too short to pre-approve, "
            "Claude Code will ask about it"
        )
        return None
    return api_key[-APPROVED_KEY_TAIL_LENGTH:]


def approve_api_key(profile_json, approved_tail):
    # Returns whether `profile_json` changed. Claude Code does not use a key
    # whose tail is on the `rejected` list, so a tail that the user declined
    # once is taken off that list as well.
    responses = profile_json.get("customApiKeyResponses")
    if not isinstance(responses, dict):
        responses = {}
        profile_json["customApiKeyResponses"] = responses
    changed = False
    rejected = responses.get("rejected")
    if isinstance(rejected, list) and approved_tail in rejected:
        responses["rejected"] = [tail for tail in rejected if tail != approved_tail]
        changed = True
    approved = responses.get("approved")
    if not isinstance(approved, list):
        approved = []
        responses["approved"] = approved
    if approved_tail not in approved:
        approved.append(approved_tail)
        changed = True
    return changed


def resolve_mcp_servers(config, profile):
    # Returns the `mcp_servers` of the profile, or `None` when there is none.
    mcp_servers = profile_setting(config, profile, "mcp_servers")
    if mcp_servers is None:
        return None
    if not isinstance(mcp_servers, dict):
        log(
            f"Warning: the `mcp_servers` of profile '{profile}' is not an object, "
            "MCP servers not set"
        )
        return None
    return mcp_servers


def apply_mcp_servers(profile_json, mcp_servers):
    # Returns whether `profile_json` changed.
    if profile_json.get("mcpServers") == mcp_servers:
        return False
    profile_json["mcpServers"] = mcp_servers
    return True


# --------------------------------------------------------------------------------------
# Container command.
# --------------------------------------------------------------------------------------


def build_harness_args(user_harness_args, dependency_dirs):
    # Read settings from the profile only. The `project` and `local` sources
    # are files under `.claude` in the repository, and a cloned repository can
    # commit either one with hooks in it. The profile is the one place that
    # the launcher controls, so it is the only source. A `--setting-sources`
    # in the harness arguments comes later on the command line and wins. That
    # is on purpose: an explicit value from the user is respected.
    #
    # Every option here uses the `--option=value` form. The harness declares
    # `--add-dir` as variadic, and its parser appends every following
    # non-option argument to a variadic option given as two tokens. A
    # positional prompt from the user would then become a directory. The `=`
    # form does not start that collection.
    harness_args = ["--setting-sources=user"]

    # Add the dependency directories to Claude's context. The current project
    # is already the working directory, and the caller leaves it out. The
    # harness refuses to start on a directory that does not exist, so the
    # caller passes only the projects that the container can see.
    for project_dir in dependency_dirs:
        harness_args.append(f"--add-dir={project_dir.path}")

    # The arguments of the user come last. A `--` among them ends the options
    # for the harness, so nothing of ours can follow it.
    return harness_args + user_harness_args


@dataclass
class RunConfig:
    paths: HostPaths
    profile_paths: ProfilePaths
    project_root: str
    profile: str
    project_name: str
    api_key: str
    docker_image_name: str
    container_name: str
    harness_print_mode: bool
    no_docker_socket: bool


def generate_container_name(project_root):
    basename = os.path.basename(project_root)
    dir_basename = re.sub(r"[^A-Za-z0-9_.-]", "", basename)
    return f"claude_code_{dir_basename[:CONTAINER_NAME_PROJECT_LENGTH]}_{os.getpid()}"


def build_run_command(harness_args, run_config):
    # The mount sources under the home directory are resolved paths, because
    # Docker needs the real directory. Every target is the unresolved path,
    # because the paths inside the container, such as the project root and the
    # scripts under the dotfiles repository, name `~/devel` as the user sees it
    # on the host. The sources under `/tmp` stay unresolved on purpose. The
    # scripts that write there see the same path on both sides of the mount,
    # and on macOS `/tmp` is a link to `/private/tmp`, so a resolved source
    # would not match the target.
    home = run_config.paths.home
    run_command = [
        "docker",
        "run",
        *container_args(run_config),
        *scratch_space_args(run_config.profile_paths),
        *devel_mount_args(run_config),
        *profile_mount_args(run_config),
        *agent_env_args(run_config),
        *agent_binary_args(run_config.paths),
        *ripgrep_config_args(run_config.paths),
        *timezone_args(),
        *git_config_args(home),
        *terminal_args(run_config.harness_print_mode),
        *additional_env_args(),
    ]

    # The socket gives the container control of the host, so
    # `--no-docker-socket` turns it off.
    if run_config.no_docker_socket:
        log("Docker socket not mounted (--no-docker-socket)")
    else:
        run_command += docker_socket_args(home)

    run_command += [
        # The image we just built.
        run_config.docker_image_name,
        # Whatever arguments we want to pass to the harness.
        *harness_args,
    ]

    return run_command, build_container_env(run_config.api_key)


def container_args(run_config):
    return [
        # Delete the container when it exits.
        "--rm",
        # Run an init process that will properly manage signals and other OS
        # facilities.
        "--init",
        # The container user is not root, so its processes hold no capability
        # to begin with. An empty bounding set keeps a set-user-ID binary from
        # gaining one, and `no-new-privileges` keeps such a binary from
        # gaining anything at all. With the Docker socket mounted, neither
        # matters, as the `Security` section of the help says.
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        # A runaway subprocess or a browser must not take the host down with
        # it. See the constants for the values. Without a swap limit, Docker
        # grants swap equal to the memory limit, so the container could hold
        # twice the amount. The same value for both turns swap off.
        "--pids-limit",
        CONTAINER_PIDS_LIMIT,
        "--memory",
        CONTAINER_MEMORY_LIMIT,
        "--memory-swap",
        CONTAINER_MEMORY_LIMIT,
        # Configure user.
        "--user",
        f"{os.getuid()}:{os.getgid()}",
        # Container name.
        "--name",
        run_config.container_name,
        # So that the agent can reach services running on the host via
        # `host.docker.internal`.
        "--add-host",
        "host.docker.internal:host-gateway",
    ]


def scratch_space_args(profile_paths):
    # Returns the arguments for the writable places of the container and for
    # the directories that the containers of the profile share.
    profile_tmp_dir = profile_paths.profile_tmp_dir
    runtime_dir = f"/run/user/{os.getuid()}"
    return [
        # Make the entire filesystem read-only. `/tmp` and the runtime
        # directory are the only writable places outside of the mounts. Both
        # are a tmpfs of the container, because a runtime directory belongs to
        # one session, and two containers of a profile must not share sockets
        # and locks. The runtime directory gets its own tmpfs, because the XDG
        # specification asks for a directory with mode 700 that the user owns,
        # and `/tmp` is world-writable.
        "--read-only",
        "--tmpfs",
        "/tmp",
        "--tmpfs",
        f"{runtime_dir}:mode=700,uid={os.getuid()},gid={os.getgid()}",
        "--env",
        f"XDG_RUNTIME_DIR={runtime_dir}",
        # The directory that every container of the profile shares. It sits
        # under the `/tmp` tmpfs, and Docker applies the deeper mount last.
        # The cache directories that Chromium and Node tools write to are
        # inside it, so the containers of the profile share those too. npm
        # does not read the XDG variables, so it gets its own one.
        "--volume",
        f"{profile_tmp_dir}:{profile_tmp_dir}",
        "--env",
        f"XDG_CACHE_HOME={profile_tmp_dir}/xdg_cache",
        "--env",
        f"npm_config_cache={profile_tmp_dir}/npm_cache",
        # The directory where the `pane-state` and `chime` scripts write, and
        # the variable that names it for them. See the `tmux` section of the
        # help.
        "--volume",
        f"{profile_paths.pane_states_dir}:{profile_paths.pane_states_dir}",
        "--env",
        f"TMUX_PANE_STATES_DIR={profile_paths.pane_states_dir}",
        # Chromium, which `agent-browser` drives, keeps the memory of its
        # renderers in `/dev/shm`. Docker gives a container 64 MB there, and
        # large pages crash the renderers at that size.
        "--shm-size",
        "1g",
    ]


def devel_mount_args(run_config):
    paths = run_config.paths
    args = [
        # Mount the entire `~/devel` directory and set the project root as the
        # working directory.
        "--volume",
        f"{paths.resolved_devel_dir}:{paths.devel_dir}",
        "--workdir",
        run_config.project_root,
    ]

    # The dotfiles repository is the source of the agent scripts and of the
    # `.claude-origin` directory that every run copies into the profile. Mount
    # it read-only over the `~/devel` mount when it is not the project, so the
    # agent cannot change what the next run installs. Docker applies the
    # deeper mount last, so the read-only one wins. No project is a link, so
    # the unresolved paths compare.
    if run_config.project_root != paths.dotfiles_dir:
        args += [
            "--volume",
            f"{paths.resolved_dotfiles_dir}:{paths.dotfiles_dir}:ro",
        ]
    return args


def profile_mount_args(run_config):
    home = run_config.paths.home
    return [
        # Claude Code files. This makes it so that it looks for `.claude.json`
        # inside `~/.claude` instead of inside `~`.
        "--env",
        f"CLAUDE_CONFIG_DIR={home}/.claude",
        # The profile directory is not a link, but a component of the home
        # directory can be one, so the source is the resolved path, like the
        # other mount sources under the home directory. See
        # `prepare_profile_dir` for the check on the directory itself.
        "--volume",
        f"{os.path.realpath(run_config.profile_paths.profile_dir)}:{home}/.claude",
    ]


def agent_env_args(run_config):
    # Returns the variables that the harness and the scripts in the container
    # read. A name alone relays the value of the host, and Docker leaves the
    # variable out when the host does not set it.
    return [
        # Anthropic's API key if available. The name alone keeps the value out
        # of the command line. If not defined, Claude Code will check for OAuth
        # credentials. If not there too, it will ask the user how they want to
        # login.
        "--env",
        "ANTHROPIC_API_KEY",
        # This is used to show the active profile and project in the status
        # line.
        "--env",
        f"AGENT_PROFILE={run_config.profile}",
        "--env",
        f"PROJECT_NAME={run_config.project_name}",
        # Let the `pane-state` script mark the pane that runs the agent, and
        # let the `chime` script ring on the host. `TMUX_PANE` names the pane
        # that runs the launcher. Without it, the scripts do nothing.
        "--env",
        "TMUX_PANE",
        # The hook scripts write their debug output here. Without the
        # variable, the scripts fall back to a directory named after the user,
        # and the container user is not the host user.
        "--env",
        f"AGENT_SHARED_DIR={run_config.profile_paths.shared_dir}",
        # Terminal configuration.
        "--env",
        "TERM",
        "--env",
        "COLORTERM",
        "--env",
        "FORCE_COLOR",
        "--env",
        "NO_COLOR",
    ]


def agent_binary_args(paths):
    # Mount the scripts that the agent calls by name. Skip one when it is
    # absent, so Docker does not create it on the host as a directory owned by
    # `root`, inside the dotfiles working tree.
    args = []
    for binary in AGENT_BINARIES:
        binary_path = f"{paths.resolved_dotfiles_dir}/bin/{binary}"
        if not os.path.isfile(binary_path):
            log(f"Warning: {binary_path} does not exist, not mounting it")
            continue
        args += ["--volume", f"{binary_path}:/usr/local/bin/{binary}:ro"]
    return args


def ripgrep_config_args(paths):
    # Returns the `docker run` arguments that relay `RIPGREP_CONFIG_PATH`, the
    # file that ripgrep reads its options from. Claude Code runs ripgrep for
    # the file suggestions on `@`. The container sees the host only through
    # the `~/devel` mount, so a file elsewhere is not there, and ripgrep then
    # prints an error on every call.
    config_path = os.environ.get("RIPGREP_CONFIG_PATH", "")
    if not config_path:
        return []
    # A relative path or a doubled separator would fail the prefix test below,
    # and a relative path would name another file in the container, where the
    # working directory differs. The container gets the absolute path.
    config_path = os.path.abspath(config_path)
    # The path itself must be under the mount, and so must the file that it
    # resolves to. The mount exposes a link, but not a target outside of it.
    visible = is_below(config_path, paths.devel_dir) and is_below(
        os.path.realpath(config_path), paths.resolved_devel_dir
    )
    if not visible or not os.path.isfile(config_path):
        log(
            f"Warning: {config_path} is not visible in the container, "
            "RIPGREP_CONFIG_PATH not relayed"
        )
        return []
    return ["--env", f"RIPGREP_CONFIG_PATH={config_path}"]


def timezone_args():
    # This enables sessions to show up with the right timestamps. An empty
    # value would mean UTC, so leave the variable unset instead and let the
    # image decide.
    timezone = get_timezone()
    if not timezone:
        return []
    return ["--env", f"TZ={timezone}"]


def git_config_args(home):
    # Mount the Git configuration of the user, so that the aliases and the
    # other preferences apply inside the container. Skip it when it is absent,
    # so Docker does not create it on the host as a directory owned by `root`.
    git_config_dir = f"{home}/.config/git"
    if not os.path.isdir(git_config_dir):
        log(
            f"Warning: {git_config_dir} does not exist, Git configuration will "
            "not be available inside the container"
        )
        return []
    return ["--volume", f"{os.path.realpath(git_config_dir)}:{git_config_dir}:ro"]


def terminal_args(harness_print_mode):
    args = []
    stdin_tty = stdin_is_tty()

    # An interactive session needs stdin for the keyboard, and a prompt that
    # arrives through a pipe needs stdin to reach the harness. Print mode from
    # a terminal is the exception. The container sees the attached terminal as
    # a pipe, and the harness then waits for end of file that the user never
    # sends. Leave stdin detached there, so the harness reads end of file at
    # once.
    if not harness_print_mode or not stdin_tty:
        args.append("--interactive")

    # A TTY belongs to an interactive session only. In print mode it mixes
    # terminal control codes into the output that the caller captures. The
    # interactive UI of the harness needs one, and without it the harness
    # fails inside the container with a message that does not name the cause,
    # so the launcher says it here.
    if not harness_print_mode:
        if stdin_tty:
            args.append("--tty")
        else:
            log("Warning: stdin is not a terminal, the interactive UI needs one")

    return args


def get_timezone():
    timezone = os.environ.get("TZ", "")
    if timezone:
        return timezone
    try:
        link = os.readlink("/etc/localtime")
    except OSError:
        link = ""
    # A link that does not go through a `zoneinfo` directory carries no zone
    # name.
    match = re.search(r"/zoneinfo/(.+)$", link)
    if match:
        return match.group(1)
    # A host without the link, which is common on Linux, keeps the zone name
    # in this file. Return nothing when neither source has it, so the caller
    # leaves `TZ` unset.
    try:
        return read_text("/etc/timezone").strip()
    except (OSError, ValueError):
        return ""


def additional_env_args():
    # Returns the `docker run` arguments that relay the variables named in
    # `AGENTS_ADDITIONAL_ENV_VARS`, a colon-separated list. The name alone is
    # passed, so the value stays out of the command line. A name that the list
    # repeats is relayed once.
    args = []
    seen_env_vars = set()
    additional_env_vars = os.environ.get("AGENTS_ADDITIONAL_ENV_VARS", "")
    for additional_env_var in additional_env_vars.split(":"):
        additional_env_var = additional_env_var.strip()
        if not additional_env_var or additional_env_var in seen_env_vars:
            continue
        seen_env_vars.add(additional_env_var)
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", additional_env_var):
            log(
                f"Warning: {additional_env_var} is not a valid variable name, "
                "skipping it"
            )
            continue
        if additional_env_var in RESERVED_ENV_VARS:
            log(
                f"Warning: {additional_env_var} is set by the launcher for the "
                "container, skipping it"
            )
            continue
        # Docker leaves out a variable that the host does not set, and the
        # container would then lack it without a word.
        if additional_env_var not in os.environ:
            log(f"Warning: {additional_env_var} is not set on the host, skipping it")
            continue
        log(f"Additional environment variable: {additional_env_var}")
        args += ["--env", additional_env_var]
    return args


def docker_socket_args(home):
    # Returns the `docker run` arguments that give the container access to the
    # host Docker socket, or an empty list when no socket is found. A rootless
    # daemon listens where `DOCKER_HOST` points, so that path comes first. A
    # `DOCKER_HOST` that is not a Unix socket names a daemon that a mount
    # cannot reach, and a local socket would give the container another
    # daemon than the one that built the image, so the container gets none.
    candidates = []
    docker_host = os.environ.get("DOCKER_HOST", "")
    if docker_host and not docker_host.startswith("unix://"):
        log(
            f"Warning: DOCKER_HOST is {docker_host}, not a Unix socket. Docker "
            "will not be available inside the container"
        )
        return []
    if docker_host:
        socket_path = docker_host[len("unix://") :]
        if socket_path:
            candidates.append(socket_path)
    candidates += [f"{home}/.docker/run/docker.sock", "/var/run/docker.sock"]
    for candidate in candidates:
        socket_info = stat_socket(candidate)
        if socket_info is None:
            continue
        # The group of the socket file grants access to the socket of a Linux
        # daemon, which belongs to the `docker` group. Docker Desktop owns the
        # socket as root inside its virtual machine, and the group of the file
        # on the macOS side says nothing about that, so group 0 is added there.
        # A Linux socket that belongs to group 0 needs it as well. Without the
        # socket, the container holds neither privilege.
        group_ids = {socket_info.st_gid}
        if sys.platform == "darwin":
            group_ids.add(0)
        args = []
        for group_id in sorted(group_ids):
            args += ["--group-add", str(group_id)]
        args += [
            "--volume",
            f"{candidate}:/var/run/docker.sock",
            "--env",
            "DOCKER_HOST=unix:///var/run/docker.sock",
        ]
        return args

    log(
        "Warning: Docker socket not found, Docker will not be available inside "
        "the container"
    )
    return []


def stat_socket(path):
    # Returns the stat result of the socket, or `None` when the path is not a
    # socket or cannot be read.
    try:
        info = os.stat(path)
    except OSError:
        return None
    if not stat.S_ISSOCK(info.st_mode):
        return None
    return info


def stdin_is_tty():
    try:
        return sys.stdin is not None and sys.stdin.isatty()
    except ValueError:
        return False


def build_container_env(api_key):
    env = dict(os.environ)
    if api_key:
        env["ANTHROPIC_API_KEY"] = api_key
    else:
        env.pop("ANTHROPIC_API_KEY", None)
    return env


# --------------------------------------------------------------------------------------
# Captured run.
# --------------------------------------------------------------------------------------


def run_captured(run_command, env, container_name):
    # Runs the container, captures its standard output, and returns the exit
    # code for the launcher. `run_command` starts with `docker`, because the
    # uncaptured run passes it to `exec` as is.
    try:
        result = run_docker(
            run_command[1:],
            stdout=subprocess.PIPE,
            encoding="utf-8",
            errors="replace",
            env=env,
        )
    except KeyboardInterrupt:
        # The interrupt kills the Docker client. The container can outlive it
        # and keep spending tokens, so stop it by name. The client runs here
        # without `run_docker`, because that one dies when the client cannot
        # start, and the exit would then report a failure instead of the
        # interrupt.
        with contextlib.suppress(OSError):
            subprocess.run(
                ["docker", "stop", "--timeout", "5", container_name],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        raise
    output = result.stdout.rstrip("\n")

    # The harness exits with an error code and still prints a JSON body when
    # the run fails. Format that body like a successful one. Output that is
    # not that body is relayed as is on stdout, where the output of the
    # harness belongs, so the failure is not silent, and the exit code of the
    # harness is kept.
    try:
        summary = parse_print_output(output)
    except ValueError as error:
        if output:
            print(output)
        if result.returncode == 0:
            die(f"{error}")
        return shell_exit_code(result.returncode)

    print_summary(summary)
    if result.returncode != 0:
        return shell_exit_code(result.returncode)

    # The harness can exit with success and still report a failed run. The
    # `result` text then holds the error message, which is already printed.
    if summary.is_error:
        log("Error: the harness reported an error")
        return 1
    return 0


@dataclass
class PrintSummary:
    result: str
    # The cost in dollars, or `None` when the harness output does not hold a
    # numeric `total_cost_usd`.
    cost: Decimal | None
    # The duration in seconds, or `None` when the harness output does not hold
    # a numeric `duration_ms`.
    duration: Decimal | None
    is_error: bool


def parse_print_output(output):
    # Raises `ValueError` when the output is not the JSON body of a print run.
    try:
        data = json.loads(output)
    except json.JSONDecodeError as error:
        raise ValueError(f"harness output is not valid JSON: {error}") from error
    if not isinstance(data, dict):
        raise ValueError("harness output is not a JSON object")

    is_error = data.get("is_error") is True

    # A failed run, such as one that hit the turn limit, has no `result` text.
    # It names the failure in `subtype` and lists the messages in `errors`.
    result = data.get("result")
    if result is None and is_error:
        errors = data.get("errors")
        if isinstance(errors, list) and errors:
            result = "\n".join(
                error if isinstance(error, str) else json.dumps(error)
                for error in errors
            )
        else:
            result = f"The harness failed: {data.get('subtype', 'unknown error')}"
    if not isinstance(result, str):
        raise ValueError(f"harness output has no text `result`: {result!r}")

    # The cost and the duration are progress information. A body without them,
    # or with them in another shape, is still the body of a print run, so a
    # successful run must not fail on them.
    cost = data.get("total_cost_usd")
    duration_ms = data.get("duration_ms")

    return PrintSummary(
        result=result,
        cost=Decimal(str(cost)) if is_number(cost) else None,
        duration=Decimal(str(duration_ms)) / 1000 if is_number(duration_ms) else None,
        is_error=is_error,
    )


def is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def print_summary(summary):
    # The result is the output of the harness, so it goes to stdout. The cost
    # and duration lines are progress information, so they go with the logs.
    print(summary.result)
    log("")
    if summary.cost is None:
        log("Cost: unknown")
    else:
        log(f"Cost: ${round_up_cents(summary.cost)}")
    if summary.duration is None:
        log("Duration: unknown")
    else:
        log(f"Duration: {format_duration(summary.duration)}")


def round_up_cents(value):
    cents = (value * 100).to_integral_value(rounding=ROUND_CEILING)
    return f"{cents / 100:.2f}"


def format_duration(total_seconds):
    total = total_seconds.quantize(Decimal("0.001"), rounding=ROUND_DOWN)

    hours = int(total / 3600)
    remainder = total - hours * 3600
    minutes = int(remainder / 60)
    seconds = remainder - minutes * 60

    result = ""
    if hours > 0:
        result = f"{hours}h"
    if minutes > 0 or hours > 0:
        result = f"{result}{minutes}m"
    return f"{result}{seconds:.3f}s"


def shell_exit_code(returncode):
    # `subprocess` reports a death by signal as the negated signal number. The
    # shell convention for that case is 128 plus the signal number.
    if returncode < 0:
        return 128 - returncode
    return returncode


# --------------------------------------------------------------------------------------
# Generic helpers.
# --------------------------------------------------------------------------------------


def log(message):
    # Progress, warnings, and errors go to stderr, so that stdout carries only
    # the output of the harness.
    print(message, file=sys.stderr)


def die(message):
    # Logs `message` with the `Error: ` prefix and exits with status 1.
    log(f"Error: {message}")
    sys.exit(1)


def is_below(path, directory):
    # Whether `path` is inside `directory`. The directory itself does not
    # count. Both must be resolved, or both unresolved, for the comparison to
    # mean anything.
    return path.startswith(directory + "/")


def run_docker(arguments, **kwargs):
    # Runs the Docker client with `arguments` and returns the completed
    # process. `kwargs` go to `subprocess.run` as they are. A client that
    # cannot start is fatal, because every caller needs its result.
    try:
        return subprocess.run(["docker", *arguments], **kwargs)
    except OSError as error:
        die(f"cannot run docker: {error}")


def run_docker_or_die(arguments, failure):
    # Runs the Docker client with `arguments` and returns what it wrote on
    # standard output. When the client fails, dies with `failure` and what the
    # client wrote on standard error, so the message names the cause.
    result = run_docker(
        arguments,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        encoding="utf-8",
        errors="replace",
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or "no error message from the client"
        die(f"{failure}: {detail}")
    return result.stdout


@contextlib.contextmanager
def file_lock(lock_path, wait_message):
    # Holds an exclusive lock on `lock_path` for the duration of the block.
    # `wait_message` is logged when another process holds the lock, so the
    # user knows why nothing happens.
    #
    # `flock` takes an exclusive lock on a read-only descriptor too, so a lock
    # file that other local users can open lets any of them stall every
    # launch. The mode keeps the file private. `os.open` applies it only to a
    # file that it creates, so tighten an existing one as well. The file can
    # sit in a world-writable directory, where another user can create it
    # first, see `open_owned_regular_file`.
    try:
        descriptor, _ = open_owned_regular_file(
            lock_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600
        )
    except FileNotFoundError as error:
        die(f"cannot open {lock_path}: {error}")
    try:
        os.fchmod(descriptor, 0o600)
    except OSError as error:
        die(f"cannot set the mode of {lock_path}: {error}")
    with os.fdopen(descriptor, "a") as lock_file:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log(wait_message)
            try:
                fcntl.flock(lock_file, fcntl.LOCK_EX)
            except OSError as error:
                die(f"cannot lock {lock_path}: {error}")
        except OSError as error:
            die(f"cannot lock {lock_path}: {error}")
        yield


def open_owned_regular_file(path, flags, mode=0o600):
    # Opens `path` with `flags` and returns the descriptor and its `fstat`
    # result. Dies when the path is a link, is not a regular file, or belongs
    # to another user. A missing file raises `FileNotFoundError`, because the
    # callers differ on what that means. The checks run on the open
    # descriptor, so the file that passes them is the file that the descriptor
    # names. `O_NOFOLLOW` makes a link fail the open, so a link cannot
    # redirect the open to a file of someone else's choice. `O_NONBLOCK` makes
    # the open of a FIFO return at once instead of waiting for the other end,
    # so the type check can reject it. A regular file ignores the flag. `mode`
    # applies only to a file that `O_CREAT` creates. With `O_RDONLY` the open
    # of a directory succeeds, so the type check runs on the descriptor before
    # any `fdopen`, and reports that case by name.
    try:
        descriptor = os.open(path, flags | os.O_NOFOLLOW | os.O_NONBLOCK, mode)
    except FileNotFoundError:
        raise
    except OSError as error:
        if error.errno == errno.ELOOP:
            die(f"{path} is a link, expected a regular file")
        die(f"cannot open {path}: {error}")
    try:
        info = os.fstat(descriptor)
    except OSError as error:
        die(f"cannot read {path}: {error}")
    if not stat.S_ISREG(info.st_mode):
        die(f"{path} is not a regular file")
    if info.st_uid != os.getuid():
        die(f"{path} is owned by user ID {info.st_uid}, not by you")
    return descriptor, info


def ensure_directory(path, mode):
    # Creates `path` with `mode` when nothing is there, and returns the
    # `lstat` result of what is there. Raises `NotADirectoryError` when that
    # is a link or not a directory, and lets any other `OSError` through, so
    # the caller can name what it was doing. `lstat` does not follow links, so
    # a link fails the check. `mkdir` applies the mode only to a directory
    # that it creates, and the umask trims it, so the caller sets the mode of
    # an existing one.
    try:
        os.mkdir(path, mode)
    except FileExistsError:
        pass
    info = os.lstat(path)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        raise NotADirectoryError(errno.ENOTDIR, "is a link or not a directory", path)
    return info


def open_without_following(path, *, dir_fd=None):
    # Opens `path` for reading and returns the descriptor. With `dir_fd`, a
    # relative `path` names an entry of the directory that `dir_fd` names.
    # `O_NOFOLLOW` makes a link at the path fail the open, so the descriptor
    # names what is at the path, and not what a link points to. `O_NONBLOCK`
    # makes the open of a FIFO return at once instead of waiting for a writer,
    # so the caller can check the type and reject it. A regular file and a
    # directory ignore the flag. The error for a link is `ELOOP`, whose text
    # says nothing about the path, so that one is raised again with a message
    # that names the link. Every failure is an `OSError`, like any other
    # failure of a read.
    try:
        return os.open(
            path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd
        )
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise OSError(
                errno.ELOOP,
                f"{path} is a link, and the launcher does not follow links "
                "there. Remove it",
            ) from error
        raise


def open_directory(name, path, *, dir_fd=None):
    # Opens the directory `name` and returns the descriptor. With `dir_fd`, a
    # relative `name` is an entry of the directory that `dir_fd` names. `path`
    # is the full path, for messages only. `O_NOFOLLOW` makes a link fail the
    # open, and `O_DIRECTORY` makes anything that is not a directory fail it,
    # so the descriptor names a real directory. The error for a link is
    # `ELOOP`, whose text says nothing about the path, so that one is raised
    # again with a message that names the link.
    try:
        return os.open(
            name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dir_fd
        )
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise OSError(
                errno.ELOOP,
                f"{path} is a link, expected a real directory. The launcher "
                "does not follow links there. Remove it",
            ) from error
        raise


def open_regular_file(path, *, dir_fd=None):
    # Opens `path` for reading and returns a binary handle. Anything that is
    # not a regular file fails. See `open_without_following` for the open and
    # for `dir_fd`.
    descriptor = open_without_following(path, dir_fd=dir_fd)
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise OSError(errno.EINVAL, "not a regular file", path)
        return os.fdopen(descriptor, "rb")
    except BaseException:
        os.close(descriptor)
        raise


def read_text(path, *, follow_links=True):
    # Without `follow_links`, a link at `path` fails the read. See
    # `open_regular_file`.
    if follow_links:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    with open_regular_file(path) as handle:
        return handle.read().decode("utf-8")


def write_text_atomically(path, content, mode_source=None):
    # With `mode_source`, the file gets the mode of that path. Without it, the
    # file keeps the private mode that `mkstemp` gives it. The mode goes to the
    # descriptor, not to the path, because the temporary path can turn into a
    # planted link. See the note of the `Profile directory` section. The sync
    # makes the content durable before the rename, so a crash right after the
    # rename cannot leave an empty file at the target.
    directory = os.path.dirname(path) or "."
    descriptor, temp_path = tempfile.mkstemp(dir=directory, prefix=TEMP_FILE_PREFIX)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
            if mode_source is not None:
                mode = stat.S_IMODE(os.stat(mode_source).st_mode)
                os.fchmod(handle.fileno(), mode)
        os.replace(temp_path, path)
    except BaseException:
        remove_file(temp_path)
        raise


def read_json_file(path, *, follow_links=True):
    # Without `follow_links`, a link at `path` fails the read. See
    # `open_regular_file`.
    return json.loads(read_text(path, follow_links=follow_links))


def write_json_file(path, data, mode_source=None):
    # A JSON file can spell a lone surrogate as an escape, and the parser turns
    # that into a character that UTF-8 cannot encode. Such a value falls back
    # to escapes for every character outside of ASCII, so the write succeeds.
    text = json.dumps(data, indent=2, ensure_ascii=False)
    try:
        text.encode("utf-8")
    except UnicodeEncodeError:
        text = json.dumps(data, indent=2, ensure_ascii=True)
    write_text_atomically(path, text + "\n", mode_source)


def remove_file(path, *, dir_fd=None):
    # With `dir_fd`, a relative `path` names an entry of the directory that
    # `dir_fd` names.
    try:
        os.unlink(path, dir_fd=dir_fd)
    except FileNotFoundError:
        pass


def remove_path(path):
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    else:
        os.unlink(path)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        # Ctrl-C during the build or a captured run. The shell convention for a
        # death by SIGINT is 128 + 2.
        sys.exit(130)
    except BrokenPipeError:
        # The reader of stdout went away, as with `ai ... | head`. Python
        # flushes stdout once more at exit, and that flush would fail again
        # and print a second error, so stdout is pointed at the null device
        # first. The shell convention for a death by SIGPIPE is 128 + 13.
        null_descriptor = os.open(os.devnull, os.O_WRONLY)
        os.dup2(null_descriptor, sys.stdout.fileno())
        sys.exit(141)
