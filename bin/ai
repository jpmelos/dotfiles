#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

# vim: ft=python

# / Run Claude Code inside a Docker container.
# /
# / Usage: ai [options] [-- harness-args...]
# / Options:
# /   --profile <name>  Specify profile for API key lookup (default: the
# /                     organization directory of the project, such as
# /                     `orgname` for `~/devel/orgname/project`, or the user
# /                     name for a project directly under `~/devel`)
# /   --channel <name>  Claude Code release channel or version to install in
# /                     the image (default: `latest`). Accepts `latest`,
# /                     `stable`, or a version such as `2.1.0`. The channel is
# /                     part of the image tag, so each channel gets its own
# /                     image, and a switch to another channel builds that
# /                     image. The image of a channel is rebuilt once a day.
# /                     The image of a version is not, because a version
# /                     names one release.
# /   --process-output  Capture and process output (requires `--print` and
# /                     `--output-format json` in harness args)
# /   --force-rebuild   Force rebuild of Docker image
# /   --no-build-cache  Build from scratch without using cache
# /   --no-rebuild      Skip rebuilding image even if outdated
# /   --allow-stale     If build fails, use existing image (fatal if none
# /                     exists)
# /   --no-docker-socket
# /                     Do not mount the host Docker socket into the container
# /   --verbose         Print the Docker command before running it
# /   --help, -h        Show this help
# /
# / Arguments after `--` are passed directly to Claude Code.
# /
# / A project is a directory that `list_project_dirs` reports. The current
# / directory can be the project root or any directory below it. Both cases
# / behave the same: the profile comes from the root, and the container starts
# / in the root. If run outside of every project, defaults to ~/devel/dotfiles
# / as the project.
# /
# / Security:
# /   The container runs read-only, with an explicit list of mounts. This
# /   limits mistakes. It is not a security boundary.
# /
# /   By default the host Docker socket is mounted and the container joins
# /   group 0. Any process in the container can then start a privileged
# /   container and take control of the host. Use `--no-docker-socket` for
# /   repositories that you do not trust. Docker is then unavailable inside
# /   the container.
# /
# /   The dotfiles repository holds the scripts that the agent calls and the
# /   `.claude-origin` directory that every run copies into the profile. When
# /   the project is not the dotfiles repository, the container sees that
# /   repository read-only, so the agent cannot change the origin. The copy
# /   overwrites the files that the origin holds, and it mirrors the
# /   directories that the origin holds, so a file that the agent adds to
# /   `~/.claude/commands` does not survive the next run. The rest of the
# /   profile directory is not touched. The `/learn` command writes to the
# /   origin, so it works only from the dotfiles project.
# /
# /   Host directories under `/tmp/<user>` carry state between the container
# /   and the host. Any local user can read them. That is on purpose. Nothing
# /   secret goes there. The `AGENT_SHARED_DIR` variable names the directory
# /   where the status line and hook scripts write.
# /
# / tmux:
# /   The container always gets a mount of `/tmp/<user>/tmux`, and the
# /   `AGENT_TMUX_DIR` variable names it. When the launcher runs inside tmux,
# /   the container also gets the `TMUX_PANE` variable. The `running`,
# /   `pending`, `ready`, and `default` scripts then mark the pane that runs
# /   the agent, and `pending` and `ready` request the notification chime. The
# /   `pane-state-sync` script on the host picks both up. Outside tmux the
# /   variable is absent, and these scripts do nothing.
# /
# / Configuration:
# /   Reads an optional configuration file at `~/config.json` (requires
# /   `chmod 600`) with API keys and other configuration.
# /
# /   Configuration format:
# /   ```
# /   {
# /     "claude_code": {
# /       "profiles": {
# /         "username": {
# /           "api_key": "sk-...",
# /           "model": "opus",
# /           "mcp_servers": {
# /             "server-name": {"command": "...", "args": ["..."]}
# /           }
# /         },
# /         "orgname": {
# /           "api_key": "sk-..."
# /         }
# /       }
# /     }
# /   }
# /   ```
# /
# /   Every key is optional. Without `api_key`, Claude Code falls back to OAuth
# /   credentials or asks the user to log in. Without `model`, the profile uses
# /   the model from `~/.claude-origin/settings.json`, which every run copies
# /   into the profile. Without `mcp_servers`, the profile keeps the
# /   `mcpServers` key that is already in its `.claude.json`.
# /
# /   The `mcp_servers` object of a profile replaces the `mcpServers` key in
# /   that profile's `.claude.json`.
# /
# /   An `ANTHROPIC_API_KEY` variable in the environment takes precedence over
# /   the `api_key` of the profile. The launcher warns when both are present,
# /   because the account of the environment key pays for the session.

import datetime
import filecmp
import json
import os
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from decimal import ROUND_CEILING, ROUND_DOWN, Decimal

_MISSING = object()

DEFAULT_CLAUDE_CODE_CHANNEL = "latest"
AGENT_BINARIES = (
    "safe_mv",
    "safe_rm",
    "ai_git_add",
    "ai_git_restore",
    "ai_git_commit",
    "review",
    "review_diff",
    "pane-state",
    "chime",
    "running",
    "pending",
    "ready",
    "default",
)
# Entries that Claude Code keeps under its configuration directory. The copy
# of the origin overwrites every file that the origin holds and mirrors every
# directory that the origin holds, so one of these in the origin would wipe the
# state of every profile.
CLAUDE_STATE_ENTRIES = frozenset(
    {
        ".claude.json",
        ".credentials.json",
        ".last-cleanup",
        "backups",
        "debug",
        "file-history",
        "history.jsonl",
        "ide",
        "mcp-needs-auth-cache.json",
        "paste-cache",
        "plugins",
        "policy-limits.json",
        "projects",
        "remote-settings.json",
        "session-env",
        "sessions",
        "shell-snapshots",
        "statsig",
        "todos",
    }
)


def process_help_option(argv):
    for argument in argv:
        if argument == "--":
            # Any `--help` is targeted for Claude Code instead of this script.
            return

        if argument in ("--help", "-h"):
            show_help()
            sys.exit(0)


def show_help():
    for line in read_text(__file__).splitlines():
        if line == "# /":
            # A bare `# /` marks a blank line in the help text.
            print("")
            continue

        if line.startswith("# / "):
            print(line[4:])


def check_docker_is_running():
    if shutil.which("docker") is None:
        die("Error: Docker is not installed")

    docker_probe = subprocess.run(
        ["docker", "version", "--format", "{{.Server.Version}}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if docker_probe.returncode != 0:
        die("Error: Docker daemon is not running")


@dataclass
class Options:
    profile: str = ""
    channel: str = ""
    process_output: bool = False
    force_rebuild: bool = False
    no_build_cache: bool = False
    no_rebuild: bool = False
    allow_stale: bool = False
    no_docker_socket: bool = False
    verbose: bool = False
    harness_print_mode: bool = False
    harness_json_output: bool = False
    harness_args: list = field(default_factory=list)


def parse_options(argv, project_name, username):
    options = Options()

    value_options = {
        "--profile": "profile",
        "--channel": "channel",
    }

    flags = {
        "--process-output": "process_output",
        "--force-rebuild": "force_rebuild",
        "--no-build-cache": "no_build_cache",
        "--no-rebuild": "no_rebuild",
        "--allow-stale": "allow_stale",
        "--no-docker-socket": "no_docker_socket",
        "--verbose": "verbose",
    }

    index = 0
    while index < len(argv):
        argument = argv[index]
        # Accept both `--option value` and `--option=value`.
        option_name, has_inline_value, inline_value = argument.partition("=")
        if has_inline_value and option_name in value_options:
            if not inline_value:
                die(f"Error: {option_name} requires a non-empty argument")
            setattr(options, value_options[option_name], inline_value)
            index += 1
        elif argument in value_options:
            index += 1
            if index >= len(argv) or not argv[index] or argv[index].startswith("-"):
                die(f"Error: {argument} requires a non-empty argument")
            setattr(options, value_options[argument], argv[index])
            index += 1
        elif argument in flags:
            setattr(options, flags[argument], True)
            index += 1
        elif argument == "--":
            options.harness_args = argv[index + 1 :]
            break
        else:
            die(f"Error: Unknown option '{argument}'")

    # Detect print mode and JSON output format in harness args. The scan reads
    # the arguments the way that the harness does. A prompt that spells
    # `--print` is a flag for the harness too, and everything after a `--` is
    # positional for both.
    previous_argument = ""
    for argument in options.harness_args:
        if argument == "--":
            break

        if argument in ("--print", "-p"):
            options.harness_print_mode = True

        if argument == "--output-format=json" or (
            previous_argument == "--output-format" and argument == "json"
        ):
            options.harness_json_output = True

        previous_argument = argument

    # Validate that `--process-output` is only used with
    # `--print --output-format json`.
    if options.process_output:
        if not options.harness_print_mode or not options.harness_json_output:
            die(
                "Error: `--process-output` requires `--print` and "
                "`--output-format json` in harness args"
            )

    if options.no_rebuild and (options.force_rebuild or options.no_build_cache):
        die("Error: --no-rebuild conflicts with --force-rebuild and --no-build-cache")

    # The channel becomes the image tag, so it must follow the Docker tag
    # grammar. That grammar also covers version numbers such as `2.1.0`.
    if options.channel and not re.fullmatch(
        r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}", options.channel
    ):
        die(f"Error: Invalid channel name '{options.channel}'")

    profile_detected = not options.profile
    if profile_detected:
        options.profile = detect_profile(project_name, username)
    # The profile becomes part of a directory name, so it must stay a single
    # path component without a leading dot.
    if not re.fullmatch(r"[a-zA-Z0-9_-][a-zA-Z0-9_.-]{0,63}", options.profile):
        if profile_detected:
            die(
                f"Error: Invalid profile name '{options.profile}' detected from "
                "the project. Use --profile to choose another one"
            )
        die(f"Error: Invalid profile name '{options.profile}'")

    return options


def detect_profile(project_name, username):
    # A project inside an organization directory, such as `orgname/project`,
    # takes the organization as its profile. A top-level project takes the
    # user name.
    first_component, separator, _ = project_name.partition("/")
    return first_component if separator else username


def strip_leading_path(path, prefix):
    if path.startswith(prefix + "/"):
        return path[len(prefix) + 1 :]
    return path


def find_project_root(current_dir, devel_dir, project_dirs):
    # A project directory can be a symbolic link, and `current_dir` is already
    # resolved, so resolve the project directory for the comparison. Return
    # the unresolved path, because that is the path that the `~/devel` mount
    # exposes inside the container.
    #
    # Longest resolved path first, so a nested project wins over a parent
    # directory that is a project too. The comparison runs on resolved paths,
    # so the order must come from them as well.
    candidates = []
    for relative_project_dir in project_dirs:
        project_dir = os.path.join(devel_dir, relative_project_dir)
        candidates.append((os.path.realpath(project_dir), project_dir))
    candidates.sort(key=lambda candidate: len(candidate[0]), reverse=True)

    for resolved_project_dir, project_dir in candidates:
        if current_dir == resolved_project_dir or current_dir.startswith(
            resolved_project_dir + "/"
        ):
            # The `~/devel` mount exposes the link, but not a target outside
            # of it. The container would then fail to enter the directory.
            if not resolved_project_dir.startswith(devel_dir + "/"):
                die(
                    f"Error: {project_dir} resolves to {resolved_project_dir}, "
                    f"which is outside {devel_dir} and is not visible inside "
                    "the container"
                )
            return project_dir
    return None


def load_user_config(config_path):
    # The file holds API keys, so it must be a regular file that belongs to
    # the user who runs the launcher, with no group or other access. `lstat`
    # does not follow links, so a link fails the check.
    try:
        info = os.lstat(config_path)
    except FileNotFoundError:
        return None
    except OSError as error:
        die(f"Error: cannot read {config_path}: {error}")
    if not stat.S_ISREG(info.st_mode):
        die(f"Error: {config_path} is not a regular file")
    if info.st_uid != os.getuid():
        die(f"Error: {config_path} is owned by user ID {info.st_uid}, not by you")

    file_perms = stat.S_IMODE(info.st_mode)
    if file_perms & 0o077:
        die(
            f"Error: {config_path} has permissions {file_perms:o}, expected "
            "no group or other access"
        )
    try:
        config = read_json_file(config_path)
    except ValueError as error:
        die(f"Error: {config_path} is not valid JSON: {error}")
    except OSError as error:
        die(f"Error: cannot read {config_path}: {error}")
    if not isinstance(config, dict):
        die(f"Error: {config_path} is not a JSON object")

    return config


def resolve_api_key(config, profile):
    api_key = _MISSING
    if config is not None:
        api_key = profile_setting(config, profile, "api_key")
    if api_key is _MISSING or api_key is None:
        api_key = ""
    if not isinstance(api_key, str):
        die(f"Error: the `api_key` of profile '{profile}' is not text")

    from_environment = os.environ.get("ANTHROPIC_API_KEY", "")
    if from_environment:
        if api_key:
            echo_err(
                "Warning: ANTHROPIC_API_KEY is set in the environment and takes "
                f"precedence over the `api_key` of profile '{profile}'. The "
                "account of the environment key pays for this session."
            )
        return from_environment

    # An empty key is a supported configuration. Claude Code then uses OAuth
    # credentials or asks the user to log in.
    return api_key


def profile_node(config, profile):
    # Returns the object of the profile, or `_MISSING` when there is none.
    node = config
    for step in ("claude_code", "profiles", profile):
        node = node.get(step)
        if not isinstance(node, dict):
            return _MISSING
    return node


def has_profile_entry(config, profile):
    return profile_node(config, profile) is not _MISSING


def profile_setting(config, profile, key):
    node = profile_node(config, profile)
    if node is _MISSING:
        return _MISSING
    return node.get(key, _MISSING)


def build_image_name(username, channel):
    sanitized = re.sub(r"[^a-z0-9._-]", "", username.lower()).strip("._-")[:64]
    if not sanitized:
        die(f"Error: cannot build an image name from user name '{username}'")
    return f"{sanitized}-claude:{channel}"


def ensure_image(options, docker_image_name, dockerfile_path, home, channel):
    today = datetime.datetime.now(datetime.timezone.utc).date()

    last_build = get_last_build(docker_image_name)
    try:
        dockerfile_mtime = os.stat(dockerfile_path).st_mtime
    except OSError:
        dockerfile_mtime = 0
    rebuild_reason = get_rebuild_reason(
        options, last_build, dockerfile_mtime, today, channel
    )

    if options.no_rebuild:
        if last_build is None:
            die(
                f"Error: Docker image '{docker_image_name}' does not exist and "
                "--no-rebuild was specified"
            )
        if rebuild_reason:
            echo_err(
                f"--no-rebuild specified, skipping rebuild despite: {rebuild_reason}"
            )
        else:
            echo_err("Skipping rebuild (--no-rebuild specified, image is up to date)")
        return

    if rebuild_reason is None:
        echo_err("Image is up to date, skipping rebuild.")
        return

    echo_err(f"Rebuilding image: {rebuild_reason}")

    use_cache = not options.no_build_cache
    if build_image(use_cache, docker_image_name, dockerfile_path, home, channel, today):
        return

    if not options.allow_stale:
        die("Error: Docker build failed")

    if last_build is None:
        die(
            "Error: Docker build failed and no existing image "
            f"'{docker_image_name}' found"
        )

    echo_err("Build failed, using existing image (--allow-stale)")


def get_last_build(docker_image_name):
    stdout, stderr = inspect_last_build(docker_image_name)

    # TODO: Remove this once it's not needed anymore. There is some bug in
    # Docker in which sometimes `docker image inspect` can't find an image, but
    # then you run `docker image ls` and then `docker image inspect` again, and
    # it works... This is an attempt to automatically overcome it.
    if "No such image" in stderr:
        echo_err("WARNING: image not found, trying to fix it")
        subprocess.run(
            ["docker", "image", "ls", docker_image_name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        stdout, stderr = inspect_last_build(docker_image_name)
        if "No such image" not in stderr:
            echo_err("WARNING: 'docker image ls' fixed it")

    if not stdout:
        # A missing image is the expected case. Any other failure must not
        # pass as a missing image, because that would start a full build or
        # make `--no-rebuild` report the wrong cause.
        if stderr and "No such image" not in stderr:
            die(f"Error: docker image inspect failed: {stderr}")
        return None

    try:
        timestamp = int(stdout)
    except ValueError:
        die(
            "Error: cannot read the build date of image "
            f"'{docker_image_name}' from '{stdout}'"
        )

    # An image that no build of this script tagged, such as one that came in
    # through `docker load`, has a zero tag time, which Docker reports as a
    # date long before the epoch. Treat it as an image from the epoch, so the
    # daily rebuild replaces it.
    if timestamp <= 0:
        echo_err(f"Warning: image '{docker_image_name}' has no build date")
        timestamp = 0

    # The caller compares the build date with the UTC date of today, so the
    # value must carry the same zone.
    return datetime.datetime.fromtimestamp(timestamp, tz=datetime.timezone.utc)


def inspect_last_build(docker_image_name):
    result = subprocess.run(
        [
            "docker",
            "image",
            "inspect",
            docker_image_name,
            "--format",
            "{{.Metadata.LastTagTime.Unix}}",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        encoding="utf-8",
    )
    return result.stdout.rstrip("\n"), result.stderr.rstrip("\n")


def get_rebuild_reason(options, last_build, dockerfile_mtime, today, channel):
    if options.no_build_cache:
        return "--no-build-cache specified"
    if options.force_rebuild:
        return "--force-rebuild specified"
    if last_build is None:
        return "image does not exist"
    if last_build.date() != today and not is_pinned_version(channel):
        return f"image is from {last_build:%Y-%m-%d}, today is {today:%Y-%m-%d}"
    if dockerfile_mtime > last_build.timestamp():
        return "Dockerfile modified after last build"
    return None


def is_pinned_version(channel):
    # `latest` and `stable` move, so an image from another day can hold an
    # older release. A version number names one release, and a rebuild would
    # install the same binary again.
    return re.fullmatch(r"\d+\.\d+\.\d+", channel) is not None


def build_image(use_cache, docker_image_name, dockerfile_path, home, channel, today):
    echo_err("Building Docker image...")

    build_args = [
        "--build-arg",
        f"UID={os.getuid()}",
        "--build-arg",
        f"GID={os.getgid()}",
        "--build-arg",
        f"HOME={home}",
        "--build-arg",
        f"BUILD_DATE={today:%Y-%m-%d}",
    ]

    echo_err(f"Installing Claude Code from channel '{channel}'...")
    build_args += ["--build-arg", f"CLAUDE_CODE_CHANNEL={channel}"]

    if not use_cache:
        echo_err("Building from scratch without cache...")
        build_args.append("--no-cache")

    build_args += ["--tag", docker_image_name]

    try:
        dockerfile = open(dockerfile_path, "rb")
    except OSError as error:
        echo_err(f"Error: cannot read {dockerfile_path}: {error}")
        return False

    # Pipe the Dockerfile via stdin (`-`) so no build context is sent.
    with dockerfile:
        result = subprocess.run(
            ["docker", "build", *build_args, "-"],
            stdin=dockerfile,
            stdout=sys.stderr,
        )
    return result.returncode == 0


def copy_tree_contents(source, destination, *, mirror, skip=()):
    # With `mirror`, the destination ends up with the same entries as the
    # source, and entries that the source does not have are removed. Without
    # it, the destination keeps its other entries. Top-level entries named in
    # `skip` are not copied, and the destination keeps its own version.
    os.makedirs(destination, exist_ok=True)
    source_names = set()
    for entry in os.scandir(source):
        source_names.add(entry.name)
        if entry.name in skip:
            continue
        target = os.path.join(destination, entry.name)
        if entry.is_symlink():
            # A link that already points to the same place is left alone, so
            # that a reader that watches the directory sees no change.
            link_target = os.readlink(entry.path)
            if os.path.islink(target) and os.readlink(target) == link_target:
                continue
            if os.path.lexists(target):
                remove_path(target)
            os.symlink(link_target, target)
        elif entry.is_dir():
            if os.path.islink(target) or (
                os.path.lexists(target) and not os.path.isdir(target)
            ):
                remove_path(target)
            copy_tree_contents(entry.path, target, mirror=True)
            shutil.copystat(entry.path, target)
        else:
            copy_file_atomically(entry.path, target)

    if mirror:
        # Collect the entries first. Removal during the scan is undefined.
        for entry in list(os.scandir(destination)):
            if entry.name not in source_names:
                remove_path(entry.path)


def copy_file_atomically(source, target):
    # Another session of the same profile can read the target at any moment,
    # so it must never see a partial file. A target with the same content is
    # left in place, so that a reader that watches the file sees no change.
    if os.path.isfile(target) and not os.path.islink(target):
        if filecmp.cmp(source, target, shallow=False):
            # `copystat` changes the modification time, and a watcher sees
            # that as an event, so skip it when the metadata matches too.
            source_stat = os.stat(source)
            target_stat = os.stat(target)
            same_mtime = source_stat.st_mtime_ns == target_stat.st_mtime_ns
            same_mode = stat.S_IMODE(source_stat.st_mode) == stat.S_IMODE(
                target_stat.st_mode
            )
            if not (same_mtime and same_mode):
                shutil.copystat(source, target)
            return
    elif os.path.lexists(target):
        remove_path(target)

    descriptor, temp_path = tempfile.mkstemp(dir=os.path.dirname(target))
    os.close(descriptor)
    try:
        shutil.copyfile(source, temp_path)
        shutil.copystat(source, temp_path)
        os.replace(temp_path, target)
    except BaseException:
        remove_file(temp_path)
        raise


def echo_err(message):
    print(message, file=sys.stderr)


def die(message, *, code=1):
    echo_err(message)
    sys.exit(code)


def read_text(path):
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def write_text_atomically(path, content):
    directory = os.path.dirname(path) or "."
    descriptor, temp_path = tempfile.mkstemp(dir=directory)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
        os.replace(temp_path, path)
    except BaseException:
        remove_file(temp_path)
        raise


def read_json_file(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def write_json_file(path, data):
    write_text_atomically(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n")


def remove_file(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def remove_path(path):
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    else:
        os.unlink(path)


def is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def round_up_cents(value):
    cents = (Decimal(str(value)) * 100).to_integral_value(rounding=ROUND_CEILING)
    return f"{cents / 100:.2f}"


def format_duration(total_seconds):
    total = Decimal(str(total_seconds)).quantize(Decimal("0.001"), rounding=ROUND_DOWN)

    hours = int(total / 3600)
    remainder = total - hours * 3600
    minutes = int(remainder / 60)
    seconds = remainder - minutes * 60

    result = ""
    if hours > 0:
        result = f"{hours}h"
    if minutes > 0 or hours > 0:
        result = f"{result}{minutes}m"
    return f"{result}{seconds:.3f}s"


@dataclass
class PrintSummary:
    result: str
    cost: Decimal
    duration: Decimal
    is_error: bool


def parse_print_output(output):
    # Raises `ValueError` when the output is not the JSON body of a print run.
    try:
        data = json.loads(output)
    except json.JSONDecodeError as error:
        raise ValueError(f"harness output is not valid JSON: {error}") from error
    if not isinstance(data, dict):
        raise ValueError("harness output is not a JSON object")

    is_error = data.get("is_error") is True

    # A failed run, such as one that hit the turn limit, has no `result` text.
    # It names the failure in `subtype` and lists the messages in `errors`.
    result = data.get("result")
    if result is None and is_error:
        errors = data.get("errors")
        if isinstance(errors, list) and errors:
            result = "\n".join(str(error) for error in errors)
        else:
            result = f"The harness failed: {data.get('subtype', 'unknown error')}"
    if not isinstance(result, str):
        raise ValueError(f"harness output has no text `result`: {result!r}")

    cost = data.get("total_cost_usd")
    if not is_number(cost):
        raise ValueError(f"harness output has no numeric `total_cost_usd`: {cost!r}")

    duration_ms = data.get("duration_ms")
    if not is_number(duration_ms):
        raise ValueError(
            f"harness output has no numeric `duration_ms`: {duration_ms!r}"
        )

    return PrintSummary(
        result=result,
        cost=Decimal(str(cost)),
        duration=Decimal(str(duration_ms)) / 1000,
        is_error=is_error,
    )


def print_summary(summary):
    print(summary.result)
    print("")
    print(f"Cost: ${round_up_cents(summary.cost)}")
    print(f"Duration: {format_duration(summary.duration)}")


def generate_container_name(project_root):
    basename = os.path.basename(project_root)
    dir_basename = re.sub(r"[^a-zA-Z0-9_.-]", "", basename)
    return f"claude_code_{dir_basename[:44]}_{os.getpid()}"


def get_timezone():
    timezone = os.environ.get("TZ", "")
    if timezone:
        return timezone
    try:
        link = os.readlink("/etc/localtime")
    except OSError:
        return ""
    # A link that does not go through a `zoneinfo` directory carries no zone
    # name. Return nothing, so the caller leaves `TZ` unset.
    match = re.search(r"/zoneinfo/(.+)$", link)
    if not match:
        return ""
    return match.group(1)


@dataclass
class RunConfig:
    home: str
    devel_dir: str
    dotfiles_dir: str
    project_root: str
    profile: str
    project_name: str
    api_key: str
    docker_image_name: str
    container_name: str
    shared_dir: str
    tmux_dir: str
    harness_print_mode: bool
    no_docker_socket: bool


def build_container_env(api_key):
    env = dict(os.environ)
    if api_key:
        env["ANTHROPIC_API_KEY"] = api_key
    else:
        env.pop("ANTHROPIC_API_KEY", None)
    return env


def prepare_shared_dirs(shared_root, shared_dirs):
    # `/tmp` is world-writable, so another local user can create these paths
    # first, as directories or as symbolic links into a directory that the
    # user owns. The container mounts them and host scripts read them, so each
    # one must be a real directory that belongs to the user who runs the
    # launcher. `lstat` does not follow links, so a link fails the check.
    #
    # A path that cannot be created is fatal. Docker would create the missing
    # mount source on the host as a directory owned by `root`.
    for path in (shared_root, *shared_dirs):
        try:
            os.mkdir(path)
        except FileExistsError:
            pass
        except OSError as error:
            die(f"Error: cannot create {path}: {error}")
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            die(f"Error: {path} is not a directory")
        if info.st_uid != os.getuid():
            die(f"Error: {path} is owned by user ID {info.st_uid}, not by you")
        if not os.access(path, os.W_OK | os.X_OK):
            die(f"Error: {path} is not writable")


def build_run_command(harness_args, run_config):
    home = run_config.home
    devel_dir = run_config.devel_dir
    dotfiles_dir = run_config.dotfiles_dir

    cmd = [
        "docker",
        "run",
        # Delete the container when it exits.
        "--rm",
        # Run an init process that will properly manage signals and other OS
        # facilities.
        "--init",
        # Configure user.
        "--user",
        f"{os.getuid()}:{os.getgid()}",
        # Container name.
        "--name",
        run_config.container_name,
        # So that the agent can reach services running on the host via
        # `host.docker.internal`.
        "--add-host",
        "host.docker.internal:host-gateway",
        # Make the entire filesystem read-only. `/tmp` is the only writable
        # place outside of the mounts, so the runtime and cache directories
        # that Chromium and Node tools write to must live under it.
        "--read-only",
        "--tmpfs",
        "/tmp",
        "--env",
        "XDG_RUNTIME_DIR=/tmp",
        "--env",
        "XDG_CACHE_HOME=/tmp/cache",
        # Mount the entire `~/devel` directory and set the project root as the
        # working directory.
        "--volume",
        f"{devel_dir}:{devel_dir}",
        "--workdir",
        run_config.project_root,
        # Claude Code files. This makes it so that it looks for `.claude.json`
        # inside `~/.claude` instead of inside `~`.
        "--env",
        f"CLAUDE_CONFIG_DIR={home}/.claude",
        "--volume",
        f"{home}/.claude-{run_config.profile}:{home}/.claude",
        # Anthropic's API key if available. The name alone keeps the value out
        # of the command line. If not defined, Claude Code will check for OAuth
        # credentials. If not there too, it will ask the user how they want to
        # login.
        "--env",
        "ANTHROPIC_API_KEY",
        # This is used to show the active profile and project in the status
        # line.
        "--env",
        f"AGENT_PROFILE={run_config.profile}",
        "--env",
        f"PROJECT_NAME={run_config.project_name}",
        # Let the `pane-state` script mark the pane that runs the agent, and
        # let the `chime` script ring on the host. `TMUX_PANE` names the pane
        # that runs the launcher. Docker leaves the variable out when the host
        # does not set it, and the scripts then do nothing. `AGENT_TMUX_DIR`
        # names the shared directory where these scripts write. The container
        # cannot derive it, because its user name differs from the host's.
        "--env",
        "TMUX_PANE",
        "--env",
        f"AGENT_TMUX_DIR={run_config.tmux_dir}",
        # The status line and hook scripts write their debug output here. The
        # container cannot derive the path, for the same reason as above.
        "--env",
        f"AGENT_SHARED_DIR={run_config.shared_dir}",
        # Claude Code reads this to search for file suggestions on `@`.
        "--env",
        "RIPGREP_CONFIG_PATH",
        # Terminal configuration.
        "--env",
        "TERM",
        "--env",
        "COLORTERM",
        "--env",
        "FORCE_COLOR",
        "--env",
        "NO_COLOR",
    ]

    for shared_dir in (run_config.shared_dir, run_config.tmux_dir):
        cmd += ["--volume", f"{shared_dir}:{shared_dir}"]

    # The dotfiles repository is the source of the agent scripts and of the
    # `.claude-origin` directory that every run copies into the profile. Mount
    # it read-only over the `~/devel` mount when it is not the project, so the
    # agent cannot change what the next run installs. Docker applies the
    # deeper mount last, so the read-only one wins.
    if run_config.project_root != dotfiles_dir:
        cmd += ["--volume", f"{dotfiles_dir}:{dotfiles_dir}:ro"]

    # Mount the scripts that the agent calls by name. Skip one when it is
    # absent, so Docker does not create it on the host as a directory owned by
    # `root`, inside the dotfiles working tree.
    for binary in AGENT_BINARIES:
        binary_path = f"{dotfiles_dir}/bin/{binary}"
        if not os.path.isfile(binary_path):
            echo_err(f"Warning: {binary_path} does not exist, not mounting it")
            continue
        cmd += ["--volume", f"{binary_path}:/usr/local/bin/{binary}:ro"]

    # This enables sessions to show up with the right timestamps. An empty
    # value would mean UTC, so leave the variable unset instead and let the
    # image decide.
    timezone = get_timezone()
    if timezone:
        cmd += ["--env", f"TZ={timezone}"]

    # Mount git configuration so my aliases and other preferences are in
    # effect. Skip it when it is absent, so Docker does not create it on the
    # host as a directory owned by `root`.
    git_config_dir = f"{home}/.config/git"
    if os.path.isdir(git_config_dir):
        cmd += ["--volume", f"{git_config_dir}:{git_config_dir}:ro"]
    else:
        echo_err(
            f"Warning: {git_config_dir} does not exist, Git configuration will "
            "not be available inside the container"
        )

    # An interactive session needs stdin for the keyboard, and a prompt that
    # arrives through a pipe needs stdin to reach the harness. Print mode from
    # a terminal is the exception. The container sees the attached terminal as
    # a pipe, and the harness then waits for end of file that the user never
    # sends. Leave stdin detached there, so the harness reads end of file at
    # once.
    if not run_config.harness_print_mode or not stdin_is_tty():
        cmd.append("--interactive")

    # A TTY belongs to an interactive session only. In print mode it mixes
    # terminal control codes into the output that the caller captures.
    if not run_config.harness_print_mode and stdin_is_tty():
        cmd.append("--tty")

    # Relay additional environment variables from
    # `AGENTS_ADDITIONAL_ENV_VARS`.
    additional_env_vars = os.environ.get("AGENTS_ADDITIONAL_ENV_VARS", "")
    if additional_env_vars:
        for additional_env_var in additional_env_vars.split(":"):
            # Trim whitespace.
            additional_env_var = additional_env_var.strip()
            if not additional_env_var:
                continue
            if not re.fullmatch(r"[a-zA-Z_][a-zA-Z0-9_]*", additional_env_var):
                echo_err(
                    f"Warning: Skipping invalid env var name: {additional_env_var}"
                )
                continue
            echo_err(f"Additional environment variable: {additional_env_var}")
            cmd += ["--env", additional_env_var]

    # Set up Docker access from inside the container. The socket gives the
    # container control of the host, so `--no-docker-socket` turns it off.
    if run_config.no_docker_socket:
        echo_err("Docker socket not mounted (--no-docker-socket)")
    else:
        candidates = (f"{home}/.docker/run/docker.sock", "/var/run/docker.sock")
        for candidate in candidates:
            if is_socket(candidate):
                cmd += [
                    # Group 0 is what grants access to the socket. Without the
                    # socket, the container has no reason to hold the
                    # privilege.
                    "--group-add",
                    "0",
                    "--volume",
                    f"{candidate}:/var/run/docker.sock",
                    "--env",
                    "DOCKER_HOST=unix:///var/run/docker.sock",
                ]
                break
        else:
            echo_err(
                "Warning: Docker socket not found, Docker will not be "
                "available inside the container"
            )

    cmd += [
        # The image we just built.
        run_config.docker_image_name,
        # Whatever arguments we want to pass to the harness.
        *harness_args,
    ]

    return cmd, build_container_env(run_config.api_key)


def is_socket(path):
    try:
        return stat.S_ISSOCK(os.stat(path).st_mode)
    except OSError:
        return False


def stdin_is_tty():
    try:
        return sys.stdin is not None and sys.stdin.isatty()
    except ValueError:
        return False


def list_project_dirs(dotfiles_dir):
    try:
        result = subprocess.run(
            [os.path.join(dotfiles_dir, "bin", "list_project_dirs")],
            stdout=subprocess.PIPE,
            encoding="utf-8",
        )
    except OSError as error:
        die(f"Error: cannot run list_project_dirs: {error}")
    if result.returncode != 0:
        die("Error: list_project_dirs failed")
    # An empty line would join to `~/devel` itself, and that path contains
    # every directory that the launcher compares against it.
    return [line for line in result.stdout.splitlines() if line]


def apply_settings(config, profile, origin_dir, profile_dir):
    # The profile `settings.json` is the origin file with the `model` of the
    # profile applied. The result is computed first and written at most once.
    # A running session of the same profile watches this file, so it must not
    # see the origin content and then the final content on every launch.
    origin_settings = f"{origin_dir}/settings.json"
    profile_settings = f"{profile_dir}/settings.json"

    try:
        settings = read_json_file(origin_settings)
    except FileNotFoundError:
        return
    except (OSError, ValueError) as error:
        echo_err(f"Warning: cannot read {origin_settings}: {error}")
        return

    preferred_model = resolve_preferred_model(config, profile)
    if preferred_model is not None:
        if isinstance(settings, dict):
            settings["model"] = preferred_model
            echo_err(f"Model set to '{preferred_model}' for profile '{profile}'")
        else:
            echo_err(f"Warning: {origin_settings} is not a JSON object, model not set")

    try:
        current_settings = read_json_file(profile_settings)
    except (OSError, ValueError):
        current_settings = _MISSING

    if current_settings == settings:
        return
    try:
        write_json_file(profile_settings, settings)
    except OSError as error:
        echo_err(f"Warning: cannot write {profile_settings}: {error}")


def resolve_preferred_model(config, profile):
    # Returns the `model` of the profile, or `None` when there is none.
    if config is None:
        return None
    preferred_model = profile_setting(config, profile, "model")
    if preferred_model is _MISSING or preferred_model is None:
        return None
    if not isinstance(preferred_model, str):
        echo_err(
            f"Warning: the `model` of profile '{profile}' is not text, model not set"
        )
        return None
    return preferred_model


def apply_dependencies_list(origin_claude_md, profile_claude_md, project_dirs):
    # The profile `CLAUDE.md` is the origin file with the dependencies marker
    # replaced by the list of projects. The result is computed first and
    # written at most once. A running session of the same profile reads this
    # file, so it must not see the origin content and then the final content
    # on every launch.
    marker = "<!-- DEPENDENCIES_LIST -->"

    try:
        claude_md = read_text(origin_claude_md)
    except FileNotFoundError:
        return
    except (OSError, UnicodeDecodeError) as error:
        echo_err(f"Warning: cannot read {origin_claude_md}: {error}")
        return

    if marker in claude_md:
        if project_dirs:
            claude_md = expand_dependencies_marker(claude_md, marker, project_dirs)
        else:
            echo_err(f"Warning: no projects found, {marker} stays in CLAUDE.md")

    try:
        current_claude_md = read_text(profile_claude_md)
    except (OSError, UnicodeDecodeError):
        current_claude_md = _MISSING

    if current_claude_md == claude_md:
        return
    try:
        write_text_atomically(profile_claude_md, claude_md)
    except OSError as error:
        echo_err(f"Warning: cannot write {profile_claude_md}: {error}")


def expand_dependencies_marker(claude_md, marker, project_dirs):
    lines = []
    for line in claude_md.splitlines():
        if marker in line:
            # Extract the indentation from the marker line.
            indent = line.split(marker, 1)[0]
            lines += [f"{indent}- {project_dir}" for project_dir in project_dirs]
        else:
            lines.append(line)
    return "".join(f"{line}\n" for line in lines)


def create_profile_json(profile_json_path):
    # Claude Code cannot start without this file, so a failure here is fatal.
    if not os.path.isfile(profile_json_path):
        try:
            write_text_atomically(profile_json_path, "{}\n")
        except OSError as error:
            die(f"Error: cannot create {profile_json_path}: {error}")
    try:
        os.chmod(profile_json_path, 0o600)
    except OSError as error:
        echo_err(f"Warning: cannot set the mode of {profile_json_path}: {error}")


def update_profile_json(profile_json_path, api_key, config, profile):
    # The file is read once, every edit is applied to the parsed content, and
    # the result is written at most once. A running session of the same
    # profile writes this file too, so each launch must touch it as little as
    # possible.
    mcp_servers = resolve_mcp_servers(config, profile)
    if not api_key and mcp_servers is None:
        return

    try:
        profile_json = read_json_file(profile_json_path)
    except (OSError, ValueError) as error:
        echo_err(f"Warning: cannot read {profile_json_path}: {error}")
        return
    if not isinstance(profile_json, dict):
        echo_err(f"Warning: {profile_json_path} is not a JSON object, not updated")
        return

    changed = approve_api_key(profile_json, api_key)
    if mcp_servers is not None and apply_mcp_servers(profile_json, mcp_servers):
        echo_err(f"MCP servers set for profile '{profile}'")
        changed = True
    if not changed:
        return

    try:
        write_json_file(profile_json_path, profile_json)
    except OSError as error:
        echo_err(f"Warning: cannot write {profile_json_path}: {error}")


def approve_api_key(profile_json, api_key):
    # Returns whether `profile_json` changed.
    if not api_key:
        return False

    tail_length = 20
    if len(api_key) <= tail_length:
        echo_err(
            "Warning: the API key is too short to pre-approve, "
            "Claude Code will ask about it"
        )
        return False
    approved_tail = api_key[-tail_length:]

    responses = profile_json.get("customApiKeyResponses")
    if not isinstance(responses, dict):
        responses = {}
        profile_json["customApiKeyResponses"] = responses
    approved = responses.get("approved")
    if not isinstance(approved, list):
        approved = []
        responses["approved"] = approved
    if approved_tail in approved:
        return False
    approved.append(approved_tail)
    return True


def resolve_mcp_servers(config, profile):
    # Returns the `mcp_servers` of the profile, or `None` when there is none.
    if config is None:
        return None
    mcp_servers = profile_setting(config, profile, "mcp_servers")
    if mcp_servers is _MISSING or mcp_servers is None:
        return None
    if not isinstance(mcp_servers, dict):
        echo_err(
            f"Warning: the `mcp_servers` of profile '{profile}' is not an object, "
            "MCP servers not set"
        )
        return None
    return mcp_servers


def apply_mcp_servers(profile_json, mcp_servers):
    # Returns whether `profile_json` changed.
    if profile_json.get("mcpServers") == mcp_servers:
        return False
    profile_json["mcpServers"] = mcp_servers
    return True


def check_origin_entries(origin_dir):
    for entry in os.scandir(origin_dir):
        if entry.name in CLAUDE_STATE_ENTRIES:
            die(
                f"Error: {origin_dir} holds '{entry.name}', which Claude Code "
                "uses for state. The copy into the profile would overwrite "
                "that state."
            )


def main():
    process_help_option(sys.argv[1:])

    check_docker_is_running()

    home = os.environ.get("HOME")
    if not home:
        die("Error: HOME is not set")

    try:
        username = pwd.getpwuid(os.getuid()).pw_name
    except KeyError:
        die(f"Error: user ID {os.getuid()} has no entry in the password database")

    devel_dir = os.path.realpath(os.path.join(home, "devel"))
    if not os.path.isdir(devel_dir):
        die(f"Error: {home}/devel does not exist")

    # The dotfiles repository holds the helper scripts, the Dockerfile, and
    # the origin of the profile directories. It is also the default project.
    dotfiles_dir = os.path.join(devel_dir, "dotfiles")

    project_dirs = list_project_dirs(dotfiles_dir)

    # Everything below works on the project root. A run from a subdirectory
    # of the project must behave like a run from the root.
    current_dir = os.path.realpath(os.getcwd())
    project_root = find_project_root(current_dir, devel_dir, project_dirs)
    if project_root is None:
        project_root = dotfiles_dir
        echo_err(f"Not inside a ~/devel project, defaulting to {project_root}")

    # Compute the project name (path relative to ~/devel/).
    project_name = strip_leading_path(project_root, devel_dir)

    options = parse_options(sys.argv[1:], project_name, username)
    profile = options.profile

    origin_dir = f"{home}/.claude-origin"
    profile_dir = f"{home}/.claude-{profile}"
    if not os.path.isdir(origin_dir):
        die(f"Error: {origin_dir} does not exist or is not a directory")
    # The origin is copied into the profile directory. A profile that resolves
    # to the origin itself would rewrite the origin in place.
    if os.path.realpath(profile_dir) == os.path.realpath(origin_dir):
        die(f"Error: profile '{profile}' resolves to the origin directory")

    echo_err(f"Profile: {profile}")
    echo_err(f"Project: {project_name}")

    user_config_path = f"{home}/config.json"
    user_config = load_user_config(user_config_path)
    if user_config is not None and not has_profile_entry(user_config, profile):
        # A typo in `--profile` lands here. The launch goes on, because a
        # profile without an entry is a supported configuration.
        echo_err(
            f"Warning: {user_config_path} has no entry for profile '{profile}'"
        )
    api_key = resolve_api_key(user_config, profile)

    channel = options.channel or DEFAULT_CLAUDE_CODE_CHANNEL
    docker_image_name = build_image_name(username, channel)
    dockerfile_path = os.path.join(
        dotfiles_dir, "references", "ai_containers", "Dockerfile"
    )
    ensure_image(options, docker_image_name, dockerfile_path, home, channel)

    # The directory holds credentials and chat history. `makedirs` applies the
    # mode only to a directory that it creates, so tighten an existing one too.
    try:
        os.makedirs(profile_dir, mode=0o700, exist_ok=True)
    except OSError as error:
        die(f"Error: cannot create {profile_dir}: {error}")
    try:
        os.chmod(profile_dir, 0o700)
    except OSError as error:
        echo_err(f"Warning: cannot set the mode of {profile_dir}: {error}")
    # The profile directory also holds history and credentials, so only the
    # directories that the origin has are mirrored. The top level is not.
    # `settings.json` gets the profile model merged in, so `apply_settings`
    # copies it instead.
    # `CLAUDE.md` gets the dependencies list expanded, so
    # `apply_dependencies_list` copies it instead.
    try:
        check_origin_entries(origin_dir)
        copy_tree_contents(
            origin_dir, profile_dir, mirror=False, skip=("settings.json", "CLAUDE.md")
        )
    except OSError as error:
        die(f"Error: cannot copy {origin_dir}: {error}")

    apply_settings(user_config, profile, origin_dir, profile_dir)

    apply_dependencies_list(
        f"{origin_dir}/CLAUDE.md", f"{profile_dir}/CLAUDE.md", project_dirs
    )

    profile_json_path = f"{profile_dir}/.claude.json"
    create_profile_json(profile_json_path)
    update_profile_json(profile_json_path, api_key, user_config, profile)

    shared_root = f"/tmp/{username}"
    shared_dir = f"{shared_root}/claude-code-shared"
    tmux_dir = f"{shared_root}/tmux"
    prepare_shared_dirs(shared_root, (shared_dir, tmux_dir))

    # Restrict setting sources to user and local by default. A
    # `--setting-sources` in the harness arguments comes later on the command
    # line and wins. That is on purpose: an explicit value from the user is
    # respected.
    #
    # Every option here uses the `--option=value` form. The harness declares
    # `--add-dir` as variadic, and its parser appends every following
    # non-option argument to a variadic option given as two tokens. A
    # positional prompt from the user would then become a directory. The `=`
    # form does not start that collection.
    harness_args = ["--setting-sources=user,local"]

    # Add the other project directories to Claude's context. The current
    # project is already the working directory. A project that resolves to a
    # path outside of `~/devel` is not visible inside the container, and the
    # harness refuses to start on a directory that does not exist.
    for relative_project_dir in project_dirs:
        project_dir = os.path.join(devel_dir, relative_project_dir)
        if project_dir == project_root:
            continue
        if not os.path.realpath(project_dir).startswith(devel_dir + "/"):
            echo_err(
                f"Warning: {project_dir} resolves outside {devel_dir}, not added "
                "to the context"
            )
            continue
        harness_args.append(f"--add-dir={project_dir}")

    # The arguments of the user come last. A `--` among them ends the options
    # for the harness, so nothing of ours can follow it.
    harness_args += options.harness_args

    run_config = RunConfig(
        home=home,
        devel_dir=devel_dir,
        dotfiles_dir=dotfiles_dir,
        project_root=project_root,
        profile=profile,
        project_name=project_name,
        api_key=api_key,
        docker_image_name=docker_image_name,
        container_name=generate_container_name(project_root),
        shared_dir=shared_dir,
        tmux_dir=tmux_dir,
        harness_print_mode=options.harness_print_mode,
        no_docker_socket=options.no_docker_socket,
    )

    cmd, env = build_run_command(harness_args, run_config)

    if options.verbose:
        echo_err(f"Command: {shlex.join(cmd)}")
    echo_err("Running container...")

    if options.process_output:
        # Capture output and process it.
        try:
            result = subprocess.run(
                cmd,
                stdout=subprocess.PIPE,
                encoding="utf-8",
                errors="replace",
                env=env,
            )
        except KeyboardInterrupt:
            # The interrupt kills the Docker client. The container can outlive
            # it and keep spending tokens, so stop it by name.
            subprocess.run(
                ["docker", "stop", "--time", "5", run_config.container_name],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            raise
        output = result.stdout.rstrip("\n")

        # The harness exits with an error code and still prints a JSON body
        # when the run fails. Format that body like a successful one. Output
        # that is not that body is relayed as is, so the failure is not
        # silent, and the exit code of the harness is kept.
        try:
            summary = parse_print_output(output)
        except ValueError as error:
            if output:
                echo_err(output)
            if result.returncode == 0:
                die(f"Error: {error}")
            return result.returncode

        print_summary(summary)
        if result.returncode != 0:
            return result.returncode

        # The harness can exit with success and still report a failed run. The
        # `result` text then holds the error message, which is already printed.
        if summary.is_error:
            echo_err("Error: the harness reported an error")
            return 1
        return 0

    # Replace this process with the container. Claude Code then owns the
    # terminal and its exit status becomes ours.
    try:
        os.execvpe(cmd[0], cmd, env)
    except OSError as error:
        die(f"Error: cannot run {cmd[0]}: {error}")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        # Ctrl-C during the build or a captured run. The shell convention for a
        # death by SIGINT is 128 + 2.
        sys.exit(130)
