#!/usr/bin/env bash
set -euo pipefail
trap 'echo "Exit status $? at line $LINENO from: $BASH_COMMAND" >&2' ERR

# Rename files only inside the current repository and outside `jpenv-bin`.
# Links are not resolved because the operation applies to the link itself.

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "${repo_root:-}" ]; then
    echo "Error: not inside a git repository." >&2
    exit 1
fi
if [ "$repo_root" != "/" ]; then
    repo_root="${repo_root%/}"
fi

canonical_abs_path() {
    local input_path="${1:-}"
    local combined_path
    local rest
    local -a path_stack=()
    local component
    local result
    local part
    if [ -z "$input_path" ]; then
        echo "Error: empty path." >&2
        return 1
    fi
    if [[ "$input_path" == /* ]]; then
        combined_path="$input_path"
    else
        combined_path="${PWD:-$(pwd)}/$input_path"
    fi
    if [ "$combined_path" != "/" ]; then
        combined_path="${combined_path%/}"
    fi
    rest="${combined_path#/}"
    while [ -n "$rest" ]; do
        if [[ "$rest" == */* ]]; then
            component="${rest%%/*}"
            rest="${rest#*/}"
        else
            component="$rest"
            rest=""
        fi
        case "$component" in
            ""|".")
                continue
                ;;
            "..")
                if [ "${#path_stack[@]}" -gt 0 ]; then
                    unset "path_stack[$((${#path_stack[@]}-1))]"
                fi
                ;;
            *)
                path_stack+=("$component")
                ;;
        esac
    done
    if [ "${#path_stack[@]}" -eq 0 ]; then
        printf '/\n'
    else
        result=""
        for part in "${path_stack[@]}"; do
            result="$result/$part"
        done
        printf '%s\n' "$result"
    fi
}

check_path() {
    local original_path="${1:-}"
    local absolute_path
    absolute_path="$(canonical_abs_path "$original_path")" || exit 1
    if [ "$absolute_path" = "$repo_root" ]; then
        echo "Error: refusing to operate on repository" \
            "root: $original_path" >&2
        exit 1
    fi
    if [ "$repo_root" != "/" ]; then
        if [[ "$absolute_path" != "$repo_root"/* ]]; then
            echo "Error: refusing to operate outside" \
                "repository ($repo_root): $original_path" >&2
            exit 1
        fi
    fi
    local forbidden_prefix="$repo_root/jpenv-bin"
    if [ "$repo_root" = "/" ]; then
        forbidden_prefix="/jpenv-bin"
    fi
    if [ "$absolute_path" = "$forbidden_prefix" ] \
        || [[ "$absolute_path" == "$forbidden_prefix"/* ]]; then
        echo "Error: refusing to operate inside jpenv-bin: $original_path" >&2
        exit 1
    fi
}

declare -a arg_list=()
if [ $# -gt 0 ]; then
    arg_list=("$@")
fi
end_of_options=false
index=0
while [ "$index" -lt "$#" ]; do
    current_arg="${arg_list[$index]}"
    if [ "$end_of_options" = true ]; then
        check_path "$current_arg"
    elif [ "$current_arg" = "--" ]; then
        end_of_options=true
    elif [ "$current_arg" = "-" ]; then
        check_path "$current_arg"
    elif [ "$current_arg" = "--target-directory" ]; then
        next_index=$((index + 1))
        if [ "$next_index" -lt "$#" ]; then
            check_path "${arg_list[$next_index]}"
            index=$((index + 1))
        fi
    elif [ "$current_arg" = "--suffix" ]; then
        next_index=$((index + 1))
        if [ "$next_index" -lt "$#" ]; then
            index=$((index + 1))
        fi
    elif [[ "$current_arg" == --target-directory=* ]]; then
        check_path "${current_arg#--target-directory=}"
    elif [[ "$current_arg" == --* ]]; then
        :
    elif [[ "$current_arg" == -* ]]; then
        cluster="${current_arg#-}"
        char_pos=0
        cluster_len=${#cluster}
        while [ "$char_pos" -lt "$cluster_len" ]; do
            opt_char="${cluster:$char_pos:1}"
            if [ "$opt_char" = "t" ]; then
                rest_chars="${cluster:$((char_pos + 1))}"
                if [ -n "$rest_chars" ]; then
                    check_path "$rest_chars"
                else
                    next_index=$((index + 1))
                    if [ "$next_index" -lt "$#" ]; then
                        check_path "${arg_list[$next_index]}"
                        index=$((index + 1))
                    fi
                fi
                break
            elif [ "$opt_char" = "S" ]; then
                rest_chars="${cluster:$((char_pos + 1))}"
                if [ -z "$rest_chars" ]; then
                    next_index=$((index + 1))
                    if [ "$next_index" -lt "$#" ]; then
                        index=$((index + 1))
                    fi
                fi
                break
            fi
            char_pos=$((char_pos + 1))
        done
    else
        check_path "$current_arg"
    fi
    index=$((index + 1))
done

exec mv "$@"
