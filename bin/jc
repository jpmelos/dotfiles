#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

# vim: ft=python

# / Manage `~/config.json`, the local configuration, and its copy in the
# / "Local Configuration" note of 1Password.
# /
# / Usage: jc <fetch|save>
# /        jc get <path>
# / Subcommands:
# /   fetch       Copy the note to `~/config.json`. When the file exists and
# /               is different, show the diff and ask before the overwrite.
# /               The file always ends with mode `600`.
# /   save        Copy `~/config.json` to the note. When the note is
# /               different, show the diff and ask before the update. The
# /               file must exist.
# /   get <path>  Print the value at `path` in `~/config.json`. See `Values`.
# / Options:
# /   --help, -h  Show this help
# /
# / A question takes one key, without Enter. Only `y` or `Y` accepts it.
# /
# / Values:
# /   `path` is a list of keys with a dot between each two, such as
# /   `claude_code.profiles`. `get` prints the value in JSON syntax:
# /   - A string in double quotes, with JSON escapes.
# /   - A number, `true`, `false`, or `null` as it is.
# /   - A list or an object with an indent of two spaces.
# /
# /   A key that does not exist prints `null`. A `null` on the way counts as a
# /   key that does not exist. Any other value on the way that is not an
# /   object is an error, because the file does not have the expected shape.
# /   A key with a dot in its name cannot be part of `path`. Get the object
# /   that holds the key, and read the key from that object.
# /
# / Configuration file:
# /   `get` reads `~/config.json` only when it is a regular file, not a link,
# /   owned by you, with no group or other permissions, as with `chmod 600`.
# /   The file must hold a JSON object.
# /
# / Exit status:
# /   0  Success. For `get`, the value is on stdout.
# /   1  Error. The message is on stderr.
# /   2  `get` only: `~/config.json` does not exist. A caller that treats the
# /      file as optional can tell this case apart from an error.
# /
# / Requirements:
# /   `fetch` and `save` need the 1Password CLI, `op`, with an active
# /   session, and `diff`.

import errno
import json
import os
import stat
import subprocess
import sys
import termios
import tty

USAGE = "Usage: jc <fetch|save>\n       jc get <path>"
# The 1Password item that holds the configuration, and the field of the item
# with the text.
ITEM_NAME = "Local Configuration"
FIELD_NAME = "notesPlain"
CONFIG_PATH = os.path.expanduser("~/config.json")
# The configuration path as the messages show it.
CONFIG_DISPLAY_PATH = "~/config.json"
# The file holds secrets, such as API keys, so only its owner can read it.
CONFIG_MODE = 0o600
# The exit status of `get` when the configuration file does not exist.
MISSING_CONFIG_STATUS = 2


# --------------------------------------------------------------------------------------
# Entry point.
# --------------------------------------------------------------------------------------


def main():
    arguments = sys.argv[1:]
    subcommand = arguments[0] if arguments else ""

    if not subcommand:
        print(USAGE)
        return 1

    if subcommand in ("--help", "-h"):
        show_help()
        return 0
    if subcommand == "fetch":
        return fetch_config()
    if subcommand == "save":
        return save_config()
    if subcommand == "get":
        if len(arguments) != 2:
            die("`get` takes one path, such as `jc get claude_code.profiles`.")
        return get_value(arguments[1])
    die(f"Unknown subcommand '{subcommand}'. Use 'fetch', 'save', or 'get'.")


def show_help():
    with open(__file__, encoding="utf-8") as handle:
        lines = handle.read().splitlines()
    for line in lines:
        if line == "# /":
            # A bare `# /` marks a blank line in the help text.
            print()
            continue

        if line.startswith("# / "):
            print(line[4:])


# --------------------------------------------------------------------------------------
# Subcommands.
# --------------------------------------------------------------------------------------


def fetch_config():
    note_text = read_note()

    if os.path.isfile(CONFIG_PATH):
        diff_output = diff_with_text([CONFIG_PATH, "-"], note_text)
        if diff_output is None:
            set_config_mode()
            print("No differences found. Local file is already up to date.")
            return 0

        print("Diff (local → 1Password):")
        print(diff_output)
        print()
        question = f"Overwrite {CONFIG_DISPLAY_PATH} with 1Password content? [y/N] "
        if not confirm(question):
            print("Cancelled.")
            return 0

    write_config(note_text)
    print(f"Saved to {CONFIG_DISPLAY_PATH}.")
    return 0


def save_config():
    note_text = read_note()

    if not os.path.isfile(CONFIG_PATH):
        die(f"{CONFIG_DISPLAY_PATH} does not exist.")

    diff_output = diff_with_text(["-", CONFIG_PATH], note_text)
    if diff_output is None:
        print("No differences found. 1Password is already up to date.")
        return 0

    print("Diff (1Password → local):")
    print(diff_output)
    print()
    if not confirm("Update 1Password with local content? [y/N] "):
        print("Cancelled.")
        return 0

    write_note(read_config())
    print("Updated 1Password successfully.")
    return 0


def get_value(path):
    keys = path.split(".")
    if not all(keys):
        die(f"Invalid path '{path}'. Put one dot between each two keys.")

    # JSON `null` and a missing key are both `None` here, and a `None` stays
    # `None` to the end of the path.
    value = load_config()
    walked_keys = []
    for key in keys:
        if value is None:
            break
        if not isinstance(value, dict):
            die(
                f"`{'.'.join(walked_keys)}` in {CONFIG_DISPLAY_PATH} is not a "
                "JSON object"
            )
        walked_keys.append(key)
        value = value.get(key)

    print_json(value)
    return 0


# --------------------------------------------------------------------------------------
# 1Password.
# --------------------------------------------------------------------------------------


def read_note():
    # Returns the text of the note, with its trailing newlines replaced by
    # one. The configuration file ends with one newline, so the two texts
    # compare equal when the rest is the same.
    failure = f"Failed to get '{ITEM_NAME}' from 1Password:"
    try:
        result = subprocess.run(
            [
                "op",
                "item",
                "get",
                ITEM_NAME,
                "--fields",
                FIELD_NAME,
                "--format",
                "json",
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            encoding="utf-8",
            errors="replace",
        )
    except OSError as error:
        die(f"{failure}\n{error}")
    if result.returncode != 0:
        detail = result.stderr.strip() or "no error message from op"
        die(f"{failure}\n{detail}")

    try:
        field = json.loads(result.stdout)
    except ValueError as error:
        die(f"op returned invalid JSON for '{ITEM_NAME}': {error}")
    if not isinstance(field, dict):
        die(f"op returned no field object for '{ITEM_NAME}'")

    # A missing or `null` value counts as an empty note.
    value = field.get("value")
    if value is None:
        value = ""
    if not isinstance(value, str):
        die(f"The `{FIELD_NAME}` field of '{ITEM_NAME}' is not text")
    return value.rstrip("\n") + "\n"


def write_note(config_text):
    # The trailing newlines of the configuration file stay out of the note.
    note_text = config_text.rstrip("\n")
    failure = f"Failed to update '{ITEM_NAME}' in 1Password."
    try:
        result = subprocess.run(
            ["op", "item", "edit", ITEM_NAME, f"{FIELD_NAME}={note_text}"]
        )
    except OSError as error:
        die(f"{failure}\n{error}")
    if result.returncode != 0:
        die(failure)


# --------------------------------------------------------------------------------------
# Configuration file.
# --------------------------------------------------------------------------------------


def load_config():
    # Returns the parsed configuration file, a `dict`. Exits with
    # `MISSING_CONFIG_STATUS` when the file does not exist.
    #
    # The file holds secrets, so it must be a regular file that belongs to the
    # user who runs this script, with no group or other access. The checks run
    # on the open descriptor, so the file that passes them is the file that
    # the parser reads. `O_NOFOLLOW` makes a link fail the open. `O_NONBLOCK`
    # makes the open of a FIFO return at once instead of waiting for a writer,
    # so the type check can reject it. A regular file ignores the flag. The
    # open of a directory succeeds, so the type check runs on the descriptor
    # before `fdopen`, which refuses a directory with a less clear message.
    try:
        descriptor = os.open(CONFIG_PATH, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        die(
            f"{CONFIG_DISPLAY_PATH} does not exist. Run `jc fetch` to create it.",
            MISSING_CONFIG_STATUS,
        )
    except OSError as error:
        if error.errno == errno.ELOOP:
            die(f"{CONFIG_DISPLAY_PATH} is a link, expected a regular file")
        die(f"Cannot open {CONFIG_DISPLAY_PATH}: {error}")

    try:
        info = os.fstat(descriptor)
    except OSError as error:
        die(f"Cannot read {CONFIG_DISPLAY_PATH}: {error}")
    if not stat.S_ISREG(info.st_mode):
        die(f"{CONFIG_DISPLAY_PATH} is not a regular file")
    if info.st_uid != os.getuid():
        die(f"{CONFIG_DISPLAY_PATH} is owned by user ID {info.st_uid}, not by you")
    file_mode = stat.S_IMODE(info.st_mode)
    if file_mode & 0o077:
        die(
            f"{CONFIG_DISPLAY_PATH} has permissions {file_mode:o}, expected no "
            f"group or other access, as with `chmod {CONFIG_MODE:o}`"
        )

    try:
        with os.fdopen(descriptor, "rb") as handle:
            config = json.load(handle)
    except ValueError as error:
        die(f"{CONFIG_DISPLAY_PATH} is not valid JSON: {error}")
    except OSError as error:
        die(f"Cannot read {CONFIG_DISPLAY_PATH}: {error}")
    if not isinstance(config, dict):
        die(f"{CONFIG_DISPLAY_PATH} is not a JSON object")
    return config


def read_config():
    # `newline=""` keeps the line endings of the file as they are.
    try:
        with open(CONFIG_PATH, encoding="utf-8", newline="") as handle:
            return handle.read()
    except (OSError, UnicodeDecodeError) as error:
        die(f"Cannot read {CONFIG_DISPLAY_PATH}: {error}")


def write_config(text):
    # `os.open` applies the mode only to a file that it creates, so the mode
    # of an existing file is set before the write. The secrets are then never
    # in a file that other users can read.
    try:
        descriptor = os.open(
            CONFIG_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, CONFIG_MODE
        )
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as handle:
            os.fchmod(handle.fileno(), CONFIG_MODE)
            handle.write(text)
    except OSError as error:
        die(f"Cannot write {CONFIG_DISPLAY_PATH}: {error}")


def set_config_mode():
    try:
        os.chmod(CONFIG_PATH, CONFIG_MODE)
    except OSError as error:
        die(f"Cannot set the mode of {CONFIG_DISPLAY_PATH}: {error}")


# --------------------------------------------------------------------------------------
# Generic helpers.
# --------------------------------------------------------------------------------------


def die(message, status=1):
    # Prints `message` with the `Error: ` prefix to stderr and exits with
    # `status`.
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(status)


def print_json(value):
    # A JSON file can spell a lone surrogate as an escape, and the parser
    # turns that into a character that UTF-8 cannot encode. Such a value
    # falls back to escapes for every character outside of ASCII. The bytes
    # go to stdout as they are, so the locale does not change them.
    text = json.dumps(value, indent=2, ensure_ascii=False)
    try:
        encoded = text.encode("utf-8")
    except UnicodeEncodeError:
        encoded = json.dumps(value, indent=2, ensure_ascii=True).encode("utf-8")
    sys.stdout.buffer.write(encoded + b"\n")


def diff_with_text(arguments, text):
    # Runs `diff` with `arguments`, where `-` stands for `text`, and returns
    # its output. Returns `None` when the two inputs are the same. The text
    # goes through standard input, so the secrets never touch a temporary
    # file.
    try:
        result = subprocess.run(
            ["diff", *arguments],
            input=text.encode("utf-8"),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except OSError as error:
        die(f"Cannot run diff: {error}")
    if result.returncode == 0:
        return None
    # Status 1 means that the inputs differ. Any other status is a failure,
    # such as a file that `diff` cannot read.
    if result.returncode != 1:
        detail = result.stderr.decode("utf-8", errors="replace").strip()
        die(f"diff failed: {detail or 'no error message from diff'}")
    return result.stdout.decode("utf-8", errors="replace").rstrip("\n")


def confirm(question):
    # Shows `question` and reads one character. Returns whether it is `y` or
    # `Y`. Enter and the end of the input count as no. The question goes to
    # stderr, so it shows on the terminal when stdout goes elsewhere.
    sys.stdout.flush()
    sys.stderr.write(question)
    sys.stderr.flush()
    answer = read_character()
    print()
    return answer in ("y", "Y")


def read_character():
    # Returns the next character of standard input, or an empty string at the
    # end of the input. On a terminal, line mode goes off for the read, so the
    # read returns after one key, without Enter. Echo stays on, so the key
    # shows after the question.
    if not sys.stdin.isatty():
        return sys.stdin.read(1)

    descriptor = sys.stdin.fileno()
    original_attributes = termios.tcgetattr(descriptor)
    attributes = termios.tcgetattr(descriptor)
    attributes[tty.LFLAG] &= ~termios.ICANON
    attributes[tty.CC][termios.VMIN] = 1
    attributes[tty.CC][termios.VTIME] = 0
    termios.tcsetattr(descriptor, termios.TCSANOW, attributes)
    try:
        return sys.stdin.read(1)
    finally:
        termios.tcsetattr(descriptor, termios.TCSADRAIN, original_attributes)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        # Ctrl-C at a question or during a command. The shell convention for a
        # death by SIGINT is 128 + 2.
        sys.exit(130)
