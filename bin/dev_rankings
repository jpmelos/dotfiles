FILTER_JS = [
    "(function () {",
    "  'use strict';",
    "  var PALETTE = [",
    "    '#4e79a7',",
    "    '#f28e2b',",
    "    '#e15759',",
    "    '#76b7b2',",
    "    '#59a14f',",
    "    '#edc948',",
    "    '#b07aa1',",
    "    '#ff9da7',",
    "    '#9c755f',",
    "    '#bab0ac'",
    "  ];",
    "  var TABLE_LIMIT = 20;",
    "  var CHART_LIMIT = 10;",
    "  var dataEl = document.getElementById('dr-data');",
    "  var charts = window.__drCharts || {};",
    "  if (!dataEl) {",
    "    return;",
    "  }",
    "  var DATA = null;",
    "  try {",
    "    DATA = JSON.parse(dataEl.textContent);",
    "  } catch (err) {",
    "    return;",
    "  }",
    "  var STORE_KEY = 'dev-rankings-' + DATA.meta.slug + '-repos';",
    "  function sortRepos(repos) {",
    "    return repos.slice().sort(function (a, b) {",
    "      var al = a.toLowerCase(), bl = b.toLowerCase();",
    "      if (al < bl) {",
    "        return -1;",
    "      }",
    "      if (al > bl) {",
    "        return 1;",
    "      }",
    "      if (a < b) {",
    "        return -1;",
    "      }",
    "      if (a > b) {",
    "        return 1;",
    "      }",
    "      return 0;",
    "    });",
    "  }",
    "  var currentRepos = sortRepos(DATA.repos);",
    "  function loadState() {",
    "    try {",
    "      var raw = localStorage.getItem(STORE_KEY);",
    "      return raw ? JSON.parse(raw) : null;",
    "    } catch (err) {",
    "      return null;",
    "    }",
    "  }",
    "  function saveState(state) {",
    "    try {",
    "      localStorage.setItem(STORE_KEY, JSON.stringify(state));",
    "    } catch (err) {}",
    "  }",
    "  var stored = loadState();",
    "  var excluded = [];",
    "  if (stored === null) {",
    "    saveState({repos: currentRepos, excluded: []});",
    "  } else {",
    "    var known = stored.repos || [];",
    "    var fresh = currentRepos.filter(function (repo) {",
    "      return known.indexOf(repo) === -1;",
    "    });",
    "    excluded = (stored.excluded || []).filter(function (repo) {",
    "      return currentRepos.indexOf(repo) !== -1;",
    "    });",
    "    if (fresh.length > 0) {",
    "      showWarning(fresh);",
    "    }",
    "    saveState({repos: currentRepos, excluded: excluded});",
    "  }",
    "  function showWarning(fresh) {",
    "    var box = document.getElementById('repo-alert');",
    "    var list = document.getElementById('repo-alert-list');",
    "    if (!box || !list) {",
    "      return;",
    "    }",
    "    sortRepos(fresh).forEach(function (repo) {",
    "      var item = document.createElement('li');",
    "      item.textContent = repo;",
    "      list.appendChild(item);",
    "    });",
    "    box.hidden = false;",
    "  }",
    "  function isExcluded(repo) {",
    "    return excluded.indexOf(repo) !== -1;",
    "  }",
    "  var boxes = Array.prototype.slice.call(",
    "    document.querySelectorAll('input[type=\"checkbox\"][data-repo]')",
    "  );",
    "  boxes.forEach(function (box) {",
    "    if (isExcluded(box.getAttribute('data-repo'))) {",
    "      box.checked = false;",
    "    }",
    "    box.addEventListener('change', function () {",
    "      excluded = [];",
    "      boxes.forEach(function (other) {",
    "        if (!other.checked) {",
    "          excluded.push(other.getAttribute('data-repo'));",
    "        }",
    "      });",
    "      saveState({repos: currentRepos, excluded: excluded});",
    "      refreshAll();",
    "    });",
    "  });",
    "  function periodStart(weeks) {",
    "    return 52 - weeks;",
    "  }",
    "  function keptPairs(map) {",
    "    var lists = [], repo;",
    "    for (repo in map) {",
    "      if (!isExcluded(repo)) {",
    "        lists.push(map[repo]);",
    "      }",
    "    }",
    "    return lists;",
    "  }",
    "  function rangeSum(lists, start) {",
    "    var sum = 0, i, k, pairs;",
    "    for (i = 0; i < lists.length; i++) {",
    "      pairs = lists[i];",
    "      for (k = 0; k < pairs.length; k++) {",
    "        if (pairs[k][0] >= start) {",
    "          sum += pairs[k][1];",
    "        }",
    "      }",
    "    }",
    "    return sum;",
    "  }",
    "  function weeklySums(lists, weeks) {",
    "    var start = periodStart(weeks);",
    "    var values = [], week, i, k, sum, pairs;",
    "    for (week = start; week < 52; week++) {",
    "      sum = 0;",
    "      for (i = 0; i < lists.length; i++) {",
    "        pairs = lists[i];",
    "        for (k = 0; k < pairs.length; k++) {",
    "          if (pairs[k][0] === week) {",
    "            sum += pairs[k][1];",
    "          }",
    "        }",
    "      }",
    "      values.push(sum);",
    "    }",
    "    return values;",
    "  }",
    "  function rankKeys(totals) {",
    "    return Object.keys(totals).sort(function (a, b) {",
    "      var diff = totals[b] - totals[a];",
    "      if (diff !== 0) {",
    "        return diff;",
    "      }",
    "      var al = a.toLowerCase(), bl = b.toLowerCase();",
    "      if (al < bl) {",
    "        return -1;",
    "      }",
    "      if (al > bl) {",
    "        return 1;",
    "      }",
    "      return 0;",
    "    });",
    "  }",
    "  function handleHref(handle) {",
    "    if (!DATA.meta.orgMode) {",
    "      return 'https://github.com/' + handle;",
    "    }",
    "    var safe = handle.toLowerCase().replace(/[^a-z0-9-]/g, '-');",
    "    var href = './dev-rankings-' + DATA.meta.slug + '-handle-';",
    "    href += safe + '-' + DATA.meta.stamp + '.html';",
    "    return href;",
    "  }",
    "  function repoHref(repo) {",
    "    return 'https://github.com/' + repo;",
    "  }",
    "  function datasetFor(label, values, order) {",
    "    var color = PALETTE[order % PALETTE.length];",
    "    return {",
    "      label: label,",
    "      data: values,",
    "      borderColor: color,",
    "      backgroundColor: color,",
    "      borderWidth: 2,",
    "      pointRadius: 2,",
    "      tension: 0.3,",
    "      fill: false",
    "    };",
    "  }",
    "  function fmtCount(value) {",
    "    return value.toLocaleString('en-US');",
    "  }",
    "  function addRow(tbody, position, text, href, count) {",
    "    var tr = document.createElement('tr');",
    "    var rank = document.createElement('td');",
    "    rank.textContent = String(position);",
    "    tr.appendChild(rank);",
    "    var name = document.createElement('td');",
    "    var link = document.createElement('a');",
    "    link.setAttribute('href', href);",
    "    link.textContent = text;",
    "    name.appendChild(link);",
    "    tr.appendChild(name);",
    "    var num = document.createElement('td');",
    "    num.textContent = fmtCount(count);",
    "    tr.appendChild(num);",
    "    tbody.appendChild(tr);",
    "  }",
    "  function emptyRow(tbody) {",
    "    var tr = document.createElement('tr');",
    "    ['-', 'None', '0'].forEach(function (text) {",
    "      var cell = document.createElement('td');",
    "      cell.textContent = text;",
    "      tr.appendChild(cell);",
    "    });",
    "    tbody.appendChild(tr);",
    "  }",
    "  function rebuildRows(tbody, ranked, totals, hrefFor) {",
    "    while (tbody.firstChild) {",
    "      tbody.removeChild(tbody.firstChild);",
    "    }",
    "    if (ranked.length === 0) {",
    "      emptyRow(tbody);",
    "      return;",
    "    }",
    "    ranked.slice(0, TABLE_LIMIT).forEach(function (name, i) {",
    "      addRow(tbody, i + 1, name, hrefFor(name), totals[name]);",
    "    });",
    "  }",
    "  function updateChart(card, datasets) {",
    "    var canvas = card.querySelector('canvas');",
    "    var chart = canvas ? charts[canvas.id] : null;",
    "    if (chart) {",
    "      chart.data.datasets = datasets;",
    "      chart.update();",
    "    }",
    "  }",
    "  function refreshHandleCard(card, scope, weeks) {",
    "    var totals = {}, name;",
    "    var start = periodStart(weeks);",
    "    for (name in scope) {",
    "      totals[name] = rangeSum(keptPairs(scope[name]), start);",
    "    }",
    "    var ranked = rankKeys(totals);",
    "    var tbody = card.querySelector('tbody');",
    "    if (tbody) {",
    "      rebuildRows(tbody, ranked, totals, handleHref);",
    "    }",
    "    updateChart(card, ranked.slice(0, CHART_LIMIT).map(",
    "      function (name, i) {",
    "        var values = weeklySums(keptPairs(scope[name]), weeks);",
    "        return datasetFor(name, values, i);",
    "      }",
    "    ));",
    "  }",
    "  function refreshRepoCard(card, repos, weeks) {",
    "    var totals = {}, name;",
    "    var start = periodStart(weeks);",
    "    for (name in repos) {",
    "      if (!isExcluded(name)) {",
    "        totals[name] = rangeSum([repos[name]], start);",
    "      }",
    "    }",
    "    var ranked = rankKeys(totals);",
    "    var tbody = card.querySelector('tbody');",
    "    if (tbody) {",
    "      rebuildRows(tbody, ranked, totals, repoHref);",
    "    }",
    "    updateChart(card, ranked.slice(0, CHART_LIMIT).map(",
    "      function (name, i) {",
    "        var values = weeklySums([[repos[name] || []]], weeks);",
    "        return datasetFor(name, values, i);",
    "      }",
    "    ));",
    "  }",
    "  function refreshCard(card) {",
    "    var weeks = parseInt(card.getAttribute('data-weeks'), 10);",
    "    var metric = card.getAttribute('data-metric');",
    "    if (metric === 'org') {",
    "      var values = weeklySums(keptPairs(DATA.org || {}), weeks);",
    "      updateChart(card, [datasetFor('PRs merged', values, 0)]);",
    "      return;",
    "    }",
    "    var scope = DATA.metrics[metric] || {};",
    "    if (DATA.handle) {",
    "      refreshRepoCard(card, scope[DATA.handle] || {}, weeks);",
    "    } else {",
    "      refreshHandleCard(card, scope, weeks);",
    "    }",
    "  }",
    "  function refreshTotals() {",
    "    var sections = document.querySelectorAll('section.period');",
    "    Array.prototype.forEach.call(sections, function (sec) {",
    "      var card = sec.querySelector('article.card[data-weeks]');",
    "      var span = sec.querySelector('[data-total]');",
    "      if (!card || !span) {",
    "        return;",
    "      }",
    "      var weeks = parseInt(card.getAttribute('data-weeks'), 10);",
    "      var total = 0, name, scope;",
    "      if (DATA.handle) {",
    "        scope = (DATA.metrics.merged || {})[DATA.handle] || {};",
    "        var start = periodStart(weeks);",
    "        for (name in scope) {",
    "          if (!isExcluded(name)) {",
    "            total += rangeSum([scope[name]], start);",
    "          }",
    "        }",
    "      } else {",
    "        total = weeklySums(",
    "          keptPairs(DATA.org || {}), weeks",
    "        ).reduce(function (a, b) {",
    "          return a + b;",
    "        }, 0);",
    "      }",
    "      span.textContent = total + ' merged PRs.';",
    "    });",
    "  }",
    "  function refreshAll() {",
    "    var cards = document.querySelectorAll(",
    "      'article.card[data-weeks][data-metric]'",
    "    );",
    "    Array.prototype.forEach.call(cards, refreshCard);",
    "    refreshTotals();",
    "  }",
    "  refreshAll();",
    "})();",
]


METHOD_NOTES = [
    "Only pull requests merged in each week count.",
    "Weeks run Sunday 00:00 to Saturday 23:59 UTC.",
    "Lines changed credit both author and merger.",
    "Reviews count distinct pull requests reviewed.",
    "Author self reviews do not count.",
    "Data comes from the GitHub API through gh.",
    "Cached data lives under the state directory.",
    "Tables show the top 20 handles; charts show top 10.",
    "The org-wide chart sums all merged pull requests per week.",
]


def render_html(
    title, scope_text, made_text, sections, link_for, notes,
    header_extra=(), filter_repos=None, filter_json=None,
):
    """Render the full report page and return it as text."""
    out = []
    out.append("<!DOCTYPE html>")
    out.append('<html lang="en">')
    out.append("<head>")
    out.append('<meta charset="utf-8">')
    out.append(
        '<meta name="viewport" content="width=device-width, '
        + 'initial-scale=1">'
    )
    out.append("<title>" + html.escape(title) + "</title>")
    script_tag = '<script src="' + CHART_JS_URL + '"></script>'
    out.append(script_tag)
    out.append("<style>")
    out.extend(css_lines())
    out.append("</style>")
    out.append("</head>")
    out.append("<body>")
    out.append('<header class="hero">')
    out.append("<h1>" + html.escape(title) + "</h1>")
    out.append("<p>Scope: " + html.escape(scope_text) + "</p>")
    out.append("<p>Generated: " + html.escape(made_text) + "</p>")
    for paragraph in header_extra:
        out.append("<p>" + paragraph + "</p>")
    out.append("</header>")
    if filter_repos is not None:
        out.append('<div id="repo-alert" hidden>')
        out.append("<strong>New repo showing up for the first time:</strong>")
        out.append('<ul id="repo-alert-list"></ul>')
        out.append("</div>")
    out.append('<nav class="periods">')
    for section in sections:
        anchor = section["anchor"]
        label = html.escape(section["label"])
        out.append('<a href="#' + anchor + '">' + label + "</a>")
    out.append("</nav>")
    out.append("<main>")
    for section in sections:
        out.append('<section class="period" id="')
        out[-1] += section["anchor"] + '">'
        out.append("<h2>" + html.escape(section["label"]) + "</h2>")
        out.append(
            '<p class="range">'
            + html.escape(section["range_text"])
            + ' - <span data-total>'
            + str(section["pr_total"])
            + " merged PRs.</span></p>"
        )
        out.append('<div class="grid">')
        for card in section["cards"]:
            article_open = '<article class="card" data-weeks="'
            article_open += str(card["weeks"]) + '" data-metric="'
            article_open += card["metric"] + '">'
            out.append(article_open)
            out.append("<h3>" + html.escape(card["title"]) + "</h3>")
            if card.get("ranked") is not None:
                if card.get("table_kind") == "repos":
                    table_rows = table_repo_lines(
                        card["ranked"], TABLE_LIMIT
                    )
                else:
                    table_rows = table_lines(
                        card["ranked"], TABLE_LIMIT, link_for
                    )
                out.extend(table_rows)
            out.extend(
                chart_block(
                    card["chart_id"],
                    card["labels"],
                    card["series"],
                    card["unit"],
                )
            )
            out.append("</article>")
        out.append("</div>")
        out.append("</section>")
    if filter_repos is not None:
        out.append('<section class="period" id="repo-filter">')
        out.append("<h2>Repositories</h2>")
        out.append("<p>Uncheck a repository to leave it out of")
        out[-1] += " every number on this page and the per-handle pages."
        out.append("<ul>")
        for repo in filter_repos:
            safe_repo = html.escape(repo, quote=True)
            box_open = '<li><label><input type="checkbox" data-repo="'
            box_open += safe_repo + '" checked> '
            out.append(box_open + safe_repo + "</label></li>")
        out.append("</ul>")
        out.append("</section>")
    out.append("</main>")
    out.append("<footer>")
    out.append("<h2>Method</h2>")
    out.append("<ul>")
    # The caller provides the method notes.
    for note in notes:
        out.append("<li>" + html.escape(note) + "</li>")
    out.append("</ul>")
    out.append("</footer>")
    if filter_json is not None:
        out.append('<script id="dr-data" type="application/json">')
        out.append(filter_json)
        out.append("</script>")
        out.append("<script>")
        out.extend(FILTER_JS)
        out.append("</script>")
    out.append("</body>")
    out.append("</html>")
    return "\n".join(out) + "\n"


def sparse_detail(weekly, only=None):
    """Nest sparse weekly pairs by handle and repo."""
    by_handle = {}
    for index, handles in enumerate(weekly):
        for handle, repos in handles.items():
            if only is not None and handle != only:
                continue
            target = by_handle.setdefault(handle, {})
            for repo, value in repos.items():
                if value:
                    target.setdefault(repo, []).append([index, value])
    return by_handle


def build_handle_sections(handle, detail, week_starts):
    """Build per-repository sections for one handle."""
    sections = []
    for label, week_count in PERIODS:
        anchor = "last-" + str(week_count) + "-weeks"
        start = week_starts[FETCH_WEEKS - week_count]
        end = week_starts[FETCH_WEEKS - 1]
        end_day = end + datetime.timedelta(days=6)
        range_text = start.date().isoformat()
        range_text += " to " + end_day.date().isoformat()
        labels = []
        first = FETCH_WEEKS - week_count
        for index in range(first, FETCH_WEEKS):
            labels.append(week_starts[index].date().isoformat())
        cards = []
        merged_total = 0
        for key, metric_title in METRICS:
            repo_totals = {}
            for index in range(first, FETCH_WEEKS):
                repos = detail[key][index].get(handle, {})
                for repo, value in repos.items():
                    repo_totals[repo] = repo_totals.get(repo, 0) + value
            ranked = sorted(
                repo_totals.items(),
                key=lambda item: (-item[1], item[0].lower()),
            )
            if key == "merged":
                merged_total = sum(repo_totals.values())
            top_repos = [repo for repo, _ in ranked[:CHART_LIMIT]]
            series = {}
            for repo in top_repos:
                values = []
                for index in range(first, FETCH_WEEKS):
                    repos = detail[key][index].get(handle, {})
                    values.append(repos.get(repo, 0))
                series[repo] = values
            chart_id = "chart-handle-" + key + "-" + str(week_count)
            cards.append(
                {
                    "title": metric_title,
                    "ranked": ranked,
                    "table_kind": "repos",
                    "weeks": week_count,
                    "metric": key,
                    "labels": labels,
                    "series": series,
                    "unit": metric_title,
                    "chart_id": chart_id,
                }
            )
        sections.append(
            {
                "anchor": anchor,
                "label": label,
                "range_text": range_text,
                "pr_total": merged_total,
                "cards": cards,
            }
        )
    return sections


@click.command(context_settings={"help_option_names": ["-h", "--help"]})
@click.argument("organization")
@click.argument("repository", required=False, default=None)
def main(organization, repository):
    """Rank contributors from merged pull requests. Fetch the last 52 full
    weeks of merged pull requests for ORGANIZATION, with an optional
    REPOSITORY limit, then render rankings and charts as one HTML page.
    """
    if not valid_name(organization):
        fail("invalid organization name.")
    if repository is not None and not valid_name(repository):
        fail("invalid repository name.")
    check_github_cli()

    now = datetime.datetime.now(datetime.UTC)
    today = now.date()
    current_start = sunday_start_utc(now)
    latest_start = current_start - datetime.timedelta(days=DAYS_PER_WEEK)
    first_start = latest_start - datetime.timedelta(
        days=DAYS_PER_WEEK * (FETCH_WEEKS - 1)
    )
    oldest_day = first_start.date()

    if repository:
        scope_text = organization + "/" + repository
        scope_query = "repo:" + scope_text
    else:
        scope_text = organization
        scope_query = "org:" + organization
    slug = slug_for_scope(organization, repository)
    base_dir = os.environ.get("XDG_STATE_HOME", "")
    if not base_dir:
        base_dir = os.path.join(os.path.expanduser("~"), ".local", "state")
    state_root = os.path.join(base_dir, "dev_rankings")
    database_path = os.path.join(state_root, slug, "data.json")
    database = load_database(database_path)

    day = oldest_day
    step = datetime.timedelta(days=1)
    end_day = today - step
    missing_days = []
    while day <= end_day:
        day_text = day.isoformat()
        if day_text not in database["days_fetched"]:
            missing_days.append(day_text)
        day += step

    guard = RateGuard()
    counts = {}
    if missing_days:
        counts = count_missing_days(missing_days, scope_query, guard)
    total = sum(counts.get(day_text, 0) for day_text in missing_days)
    if missing_days:
        download_missing_days(
            missing_days,
            scope_query,
            guard,
            database,
            database_path,
            total,
        )

    merged_weekly = [{} for _ in range(FETCH_WEEKS)]
    authored_weekly = [{} for _ in range(FETCH_WEEKS)]
    reviewed_weekly = [{} for _ in range(FETCH_WEEKS)]
    loc_weekly = [{} for _ in range(FETCH_WEEKS)]
    org_weekly = [0] * FETCH_WEEKS
    org_repo_detail = {}
    all_repos = set()
    detail = {
        "merged": [{} for _ in range(FETCH_WEEKS)],
        "authored": [{} for _ in range(FETCH_WEEKS)],
        "reviewed": [{} for _ in range(FETCH_WEEKS)],
        "loc": [{} for _ in range(FETCH_WEEKS)],
    }
    week_starts = []
    for index in range(FETCH_WEEKS):
        week_starts.append(first_start + datetime.timedelta(days=index * 7))
    for stored in database["pull_requests"].values():
        raw_time = stored.get("merged_at") or ""
        if not raw_time:
            continue
        try:
            merged_time = parse_github_time(raw_time)
        except ValueError:
            continue
        delta = (merged_time - first_start).total_seconds()
        index = int(delta // SECONDS_PER_WEEK)
        if index < 0 or index >= FETCH_WEEKS:
            continue
        org_weekly[index] += 1
        author = stored.get("author") or ""
        merger = stored.get("merged_by") or ""
        org_name = stored.get("organization") or ""
        repo_name = stored.get("repository") or ""
        repo_key = ""
        if org_name and repo_name:
            repo_key = org_name + "/" + repo_name
        bump(merged_weekly[index], merger)
        bump(authored_weekly[index], author)
        bump_nested(detail["merged"], index, merger, repo_key)
        bump_nested(detail["authored"], index, author, repo_key)
        for reviewer in stored.get("reviewers") or []:
            bump(reviewed_weekly[index], reviewer)
            bump_nested(detail["reviewed"], index, reviewer, repo_key)
        loc = stored.get("loc") or 0
        for handle in {author, merger}:
            bump(loc_weekly[index], handle, loc)
            bump_nested(detail["loc"], index, handle, repo_key, loc)
        if repo_key:
            all_repos.add(repo_key)
            week_counts = org_repo_detail.get(repo_key)
            if week_counts is None:
                week_counts = {}
                org_repo_detail[repo_key] = week_counts
            week_counts[index] = week_counts.get(index, 0) + 1

    weeklies = {
        "merged": merged_weekly,
        "authored": authored_weekly,
        "reviewed": reviewed_weekly,
        "loc": loc_weekly,
    }
    org_labels = [w.date().isoformat() for w in week_starts]
    handles_with_pages = set()
    org_end = week_starts[-1] + datetime.timedelta(days=6)
    org_range = week_starts[0].date().isoformat()
    org_range += " to " + org_end.date().isoformat()
    sections = [
        {
            "anchor": "org-wide-total",
            "label": "Org-wide total",
            "range_text": org_range,
            "pr_total": sum(org_weekly),
            "cards": [
                {
                    "title": "PRs merged per week (org-wide)",
                    "ranked": None,
                    "weeks": FETCH_WEEKS,
                    "metric": "org",
                    "labels": org_labels,
                    "series": {"PRs merged": org_weekly},
                    "unit": "PRs merged",
                    "chart_id": "chart-org-weekly-total",
                }
            ],
        }
    ]
    for label, week_count in PERIODS:
        anchor = "last-" + str(week_count) + "-weeks"
        start = week_starts[FETCH_WEEKS - week_count]
        end = week_starts[FETCH_WEEKS - 1]
        end_day = end + datetime.timedelta(days=6)
        range_text = start.date().isoformat()
        range_text += " to " + end_day.date().isoformat()
        labels = []
        for index in range(FETCH_WEEKS - week_count, FETCH_WEEKS):
            labels.append(week_starts[index].date().isoformat())
        pr_total = 0
        for stored in database["pull_requests"].values():
            raw_time = stored.get("merged_at") or ""
            if not raw_time:
                continue
            try:
                merged_time = parse_github_time(raw_time)
            except ValueError:
                continue
            if start <= merged_time < current_start:
                pr_total += 1
        cards = []
        for key, metric_title in METRICS:
            _totals, ranked = summarize_period(weeklies[key], week_count)
            if repository is None:
                for handle, _ in ranked[:TABLE_LIMIT]:
                    handles_with_pages.add(handle)
            top_handles = [h for h, _ in ranked[:CHART_LIMIT]]
            series = weekly_values(weeklies[key], top_handles, week_count)
            chart_id = "chart-" + key + "-" + str(week_count)
            cards.append(
                {
                    "title": metric_title,
                    "ranked": ranked,
                    "labels": labels,
                    "weeks": week_count,
                    "metric": key,
                    "series": series,
                    "unit": metric_title,
                    "chart_id": chart_id,
                }
            )
        sections.append(
            {
                "anchor": anchor,
                "label": label,
                "range_text": range_text,
                "pr_total": pr_total,
                "cards": cards,
            }
        )

    title = "Dev rankings for " + scope_text
    made_text = now.strftime("%Y-%m-%d %H:%M UTC")
    stamp = now.strftime("%Y%m%d-%H%M%S")
    sorted_repos = sorted(all_repos, key=lambda repo: (repo.lower(), repo))
    filter_labels = {}
    for label_weeks in (1, 4, 12, 52):
        week_labels = []
        for index in range(FETCH_WEEKS - label_weeks, FETCH_WEEKS):
            week_labels.append(week_starts[index].date().isoformat())
        filter_labels[str(label_weeks)] = week_labels
    filter_metrics = {}
    for key in ("merged", "authored", "reviewed", "loc"):
        filter_metrics[key] = sparse_detail(detail[key])
    org_pairs = {}
    for repo, week_counts in org_repo_detail.items():
        pairs = []
        for week in sorted(week_counts):
            if week_counts[week]:
                pairs.append([week, week_counts[week]])
        if pairs:
            org_pairs[repo] = pairs
    filter_json = json.dumps(
        {
            "meta": {
                "slug": slug,
                "stamp": stamp,
                "orgMode": repository is None,
            },
            "repos": sorted_repos,
            "labels": filter_labels,
            "metrics": filter_metrics,
            "org": org_pairs,
        }
    )
    if repository is None:
        notes = list(METHOD_NOTES)
        notes.append("Select a handle to see the per-repository breakdown.")

        def link_for(handle):
            return "./" + handle_file_name(slug, handle, stamp)
    else:
        notes = list(METHOD_NOTES)

        def link_for(handle):
            return "https://github.com/" + handle
    page = render_html(
        title,
        scope_text,
        made_text,
        sections,
        link_for,
        notes,
        (),
        sorted_repos,
        filter_json,
    )
    file_name = "dev-rankings-" + slug + "-" + stamp + ".html"
    html_path = os.path.join(state_root, file_name)
    os.makedirs(state_root, exist_ok=True)
    with open(html_path, "w", encoding="utf-8") as handle:
        handle.write(page)
    if repository is None:
        for handle in sorted(handles_with_pages, key=str.lower):
            handle_sections = build_handle_sections(
                handle, detail, week_starts
            )
            handle_title = "Dev rankings for " + handle
            handle_title += " in " + scope_text
            profile = "https://github.com/" + handle
            back_link = '<a href="./' + file_name + '">'
            back_link += "Back to org rankings</a>"
            profile_link = '<a href="' + profile + '">' + handle + "</a>"
            handle_metrics = {}
            for key in ("merged", "authored", "reviewed", "loc"):
                handle_metrics[key] = sparse_detail(detail[key], handle)
            handle_json = json.dumps(
                {
                    "meta": {
                        "slug": slug,
                        "stamp": stamp,
                        "orgMode": True,
                    },
                    "repos": sorted_repos,
                    "labels": filter_labels,
                    "metrics": handle_metrics,
                    "handle": handle,
                }
            )
            handle_page = render_html(
                handle_title,
                scope_text,
                made_text,
                handle_sections,
                link_for,
                list(METHOD_NOTES),
                (back_link, "GitHub profile: " + profile_link),
                sorted_repos,
                handle_json,
            )
            handle_path = os.path.join(
                state_root, handle_file_name(slug, handle, stamp)
            )
            with open(handle_path, "w", encoding="utf-8") as handle_file:
                handle_file.write(handle_page)
    print("open " + html_path)


if __name__ == "__main__":
    try:
        main()
    except RuntimeError as error:
        print("dev_rankings: " + str(error), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        # Ctrl-C at a prompt or during a command. The shell convention
        # for a death by SIGINT is 128 + 2.
        sys.exit(130)
    except BrokenPipeError:
        null_descriptor = os.open(os.devnull, os.O_WRONLY)
        os.dup2(null_descriptor, sys.stdout.fileno())
        sys.exit(141)
