#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["click>=8.1,<9"]
# ///

# vim: ft=python

"""Rank contributors from merged pull requests.

Collect merged pull requests for one organization, with an
optional repository limit. Rank authors, mergers, reviewers,
and lines changed over recent full weeks. Weeks run Sunday
to Saturday in UTC. Render tables and charts as one page.

Usage: dev_rankings ORGANIZATION [REPOSITORY]
"""

import concurrent.futures
import datetime
import html
import json
import os
import random
import re
import shutil
import subprocess
import sys
import threading
import time

import click

FETCH_WEEKS = 52
DAYS_PER_WEEK = 7
SECONDS_PER_WEEK = 604800
TABLE_LIMIT = 20
CHART_LIMIT = 10
PAGE_SIZE = 100
MAX_WORKERS = 10
MAX_ATTEMPTS = 6
RATE_LIMIT_RETRIES = 8
NAME_PATTERN = r"[A-Za-z0-9_.\-]+"

PERIODS = (
    ("Last full week", 1),
    ("Last 4 full weeks", 4),
    ("Last 12 full weeks", 12),
    ("Last 52 full weeks", 52),
)

METRICS = (
    ("merged", "PRs merged"),
    ("authored", "PRs authored"),
    ("reviewed", "PRs reviewed"),
    ("loc", "LOCs changed"),
)

CHART_COLORS = (
    "#4e79a7",
    "#f28e2b",
    "#e15759",
    "#76b7b2",
    "#59a14f",
    "#edc948",
    "#b07aa1",
    "#ff9da7",
    "#9c755f",
    "#bab0ac",
)

CHART_JS_URL = (
    "https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"
)


def fail(message):
    """Print an error and exit with status 1."""
    print("dev_rankings: " + message, file=sys.stderr)
    sys.exit(1)


def run_github_api(arguments):
    """Run gh api and return parsed JSON output."""
    command = ["gh", "api"] + arguments
    attempt = 0
    while True:
        attempt += 1
        finished = subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=False,
        )
        if finished.returncode == 0:
            return json.loads(finished.stdout)
        lowered = finished.stderr.lower()
        limited = "rate limit" in lowered or "abuse" in lowered
        if limited and attempt <= RATE_LIMIT_RETRIES:
            time.sleep(60)
            continue
        detail = finished.stderr.strip()
        raise RuntimeError("GitHub request failed: " + detail)


def check_github_cli():
    """Exit unless gh exists and has valid credentials."""
    if shutil.which("gh") is None:
        fail("the gh command was not found in PATH.")
    finished = subprocess.run(
        ["gh", "auth", "status"],
        capture_output=True,
        text=True,
        check=False,
    )
    if finished.returncode != 0:
        fail("gh lacks credentials. Run gh auth login first.")


def parse_github_time(value):
    """Parse a GitHub timestamp into an aware datetime."""
    text = value.replace("Z", "+00:00")
    moment = datetime.datetime.fromisoformat(text)
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=datetime.UTC)
    return moment


def sunday_start_utc(moment):
    """Return Sunday 00:00 UTC at or before the moment."""
    days_back = (moment.weekday() + 1) % DAYS_PER_WEEK
    day = moment - datetime.timedelta(days=days_back)
    return day.replace(hour=0, minute=0, second=0, microsecond=0)


def slug_for_scope(organization, repository):
    """Build a safe directory slug for the scope."""
    if repository:
        raw = organization + "__" + repository
    else:
        raw = organization
    lowered = raw.lower()
    return re.sub(r"[^a-z0-9\-_]", "_", lowered)


def handle_file_name(slug, handle, stamp):
    """Build the report file name for one handle."""
    safe = re.sub(r"[^a-z0-9\-]", "-", handle.lower())
    return "dev-rankings-" + slug + "-handle-" + safe + "-" + stamp + ".html"


def valid_name(value):
    """Check that a name fits GitHub naming rules."""
    return re.fullmatch(NAME_PATTERN, value) is not None


def load_database(path):
    """Load cached data, or return an empty database."""
    try:
        with open(path, encoding="utf-8") as handle:
            payload = json.load(handle)
    except (OSError, ValueError):
        payload = {}
    pulls = payload.get("pull_requests")
    days = payload.get("days_fetched")
    if not isinstance(pulls, dict):
        pulls = {}
    if not isinstance(days, dict):
        days = {}
    return {"pull_requests": pulls, "days_fetched": days}


def save_database(path, database):
    """Write the database atomically."""
    parent = os.path.dirname(path)
    os.makedirs(parent, exist_ok=True)
    tmp_path = path + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as handle:
        json.dump(database, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(tmp_path, path)


class RateGuard:
    """Coordinate API pauses across worker threads."""

    def __init__(self):
        self.lock = threading.Lock()
        self.blocked_until = 0.0

    def wait_turn(self):
        """Sleep while another worker reported a limit."""
        while True:
            with self.lock:
                wait = self.blocked_until - time.monotonic()
            if wait <= 0:
                return
            time.sleep(min(wait, 1.0))

    def report_limited(self, wait_seconds):
        """Block all workers for at least wait_seconds."""
        resume = time.monotonic() + wait_seconds
        with self.lock:
            if resume > self.blocked_until:
                self.blocked_until = resume


def classify_error(text):
    """Label failed output as limited, transient, or fatal."""
    lowered = text.lower()
    if "rate limit" in lowered or "429" in lowered:
        return "limited"
    if "secondary" in lowered or "abuse" in lowered:
        return "limited"
    if "timeout" in lowered or "timed out" in lowered:
        return "transient"
    if "502" in lowered or "504" in lowered:
        return "transient"
    if "unexpected end of json input" in lowered:
        return "transient"
    if "unexpected eof" in lowered:
        return "transient"
    if "connection reset" in lowered:
        return "transient"
    if "connection refused" in lowered:
        return "transient"
    if "no such host" in lowered:
        return "transient"
    return "fatal"


def backoff_wait(attempt, base, cap):
    """Return an exponential wait with jitter."""
    return min(base * (2 ** (attempt - 1)), cap) + random.uniform(0, 2)


def graphql_term(scope_query, day_text):
    """Build the search term for merged PRs on one day."""
    return (
        scope_query + " is:pr is:merged merged:" + day_text + ".." + day_text
    )


def count_query_text(scope_query, day_text):
    """Build a GraphQL count of merged PRs on one day."""
    return (
        "query { search(query: "
        + json.dumps(graphql_term(scope_query, day_text))
        + ", type: ISSUE, first: 1) { issueCount } "
        + "rateLimit { remaining resetAt } }"
    )


def search_query_text(scope_query, day_text, after):
    """Build a GraphQL search for merged PRs on one day."""
    paging = ""
    if after is not None:
        paging = ", after: " + json.dumps(after)
    return (
        "query { search(query: "
        + json.dumps(graphql_term(scope_query, day_text))
        + ", type: ISSUE, first: "
        + str(PAGE_SIZE)
        + paging
        + ") { issueCount pageInfo { hasNextPage endCursor } nodes { "
        + "__typename ... on PullRequest { number mergedAt additions "
        + "deletions author { login } mergedBy { login } "
        + "baseRepository { nameWithOwner } reviews(first: "
        + str(PAGE_SIZE)
        + ") { nodes { author { login } } "
        + "pageInfo { hasNextPage } } } } } "
        + "rateLimit { remaining resetAt } }"
    )


def update_guard_from_payload(payload, guard):
    """Block workers when the point budget runs empty."""
    data = payload.get("data") or {}
    limit = data.get("rateLimit") or {}
    if limit.get("remaining") != 0:
        return
    reset_text = limit.get("resetAt") or ""
    try:
        reset_moment = parse_github_time(reset_text)
    except ValueError:
        guard.report_limited(60)
        return
    now = datetime.datetime.now(datetime.UTC)
    wait = (reset_moment - now).total_seconds() + 5
    guard.report_limited(max(wait, 1))


def run_graphql(query_text, guard):
    """Run one GraphQL query with retries across workers."""
    attempt = 0
    while True:
        attempt += 1
        guard.wait_turn()
        finished = subprocess.run(
            ["gh", "api", "graphql", "-f", "query=" + query_text],
            capture_output=True,
            text=True,
            check=False,
        )
        if finished.returncode == 0:
            try:
                payload = json.loads(finished.stdout)
            except ValueError:
                raise RuntimeError("gh returned invalid JSON.")
            errors = payload.get("errors") or []
            limited = False
            for error in errors:
                if error.get("type") == "RATE_LIMITED":
                    limited = True
                    break
                kind = classify_error(error.get("message") or "")
                if kind == "limited":
                    limited = True
                    break
            if limited:
                wait = backoff_wait(attempt, 60, 600)
                guard.report_limited(wait)
                time.sleep(wait)
                if attempt >= MAX_ATTEMPTS:
                    raise RuntimeError("GitHub rate limit persists.")
                continue
            if errors:
                raise RuntimeError(
                    "GitHub error: " + str(errors[0].get("message"))
                )
            update_guard_from_payload(payload, guard)
            return payload.get("data") or {}
        kind = classify_error(finished.stderr)
        if kind == "fatal" or attempt >= MAX_ATTEMPTS:
            detail = finished.stderr.strip()
            raise RuntimeError("GitHub request failed: " + detail)
        if kind == "limited":
            wait = backoff_wait(attempt, 60, 600)
            guard.report_limited(wait)
        else:
            wait = backoff_wait(attempt, 5, 60)
        time.sleep(wait)


def record_key(record):
    """Build the database key for one pull request."""
    return (
        record["organization"]
        + "/"
        + record["repository"]
        + "#"
        + str(record["number"])
    ).lower()


def record_from_node(node):
    """Build a database record from one GraphQL node."""
    repo_full = (node.get("baseRepository") or {}).get("nameWithOwner")
    repo_full = repo_full or ""
    org_name, _, repo_name = repo_full.partition("/")
    author = (node.get("author") or {}).get("login") or ""
    merger = (node.get("mergedBy") or {}).get("login") or ""
    reviewers = set()
    reviews = node.get("reviews") or {}
    for review in reviews.get("nodes") or []:
        login = (review.get("author") or {}).get("login") or ""
        if not login:
            continue
        if author and login.lower() == author.lower():
            continue
        reviewers.add(login)
    truncated = bool((reviews.get("pageInfo") or {}).get("hasNextPage"))
    additions = node.get("additions") or 0
    deletions = node.get("deletions") or 0
    return {
        "organization": org_name,
        "repository": repo_name,
        "number": node.get("number"),
        "author": author,
        "merged_by": merger,
        "merged_at": node.get("mergedAt") or "",
        "additions": additions,
        "deletions": deletions,
        "loc": additions + deletions,
        "reviewers": sorted(reviewers),
    }, truncated


def count_day_prs(day_text, scope_query, guard):
    """Return the merged PR count for one day."""
    data = run_graphql(count_query_text(scope_query, day_text), guard)
    search = data.get("search") or {}
    total = search.get("issueCount") or 0
    if total > 1000:
        print(
            "Warning: more than 1000 results for "
            + day_text
            + "; counts may be partial.",
            file=sys.stderr,
        )
    return total


def advance_capped(bar, count, lock):
    """Advance the bar without passing its length."""
    with lock:
        room = bar.length - bar.pos
        if room > 0:
            bar.update(min(count, room))


def fetch_reviewer_list(organization, repository, number, author):
    """Return sorted reviewer logins, without the author."""
    path = (
        "repos/"
        + organization
        + "/"
        + repository
        + "/pulls/"
        + str(number)
        + "/reviews"
    )
    payload = run_github_api(["--paginate", path])
    seen = set()
    if isinstance(payload, list):
        for review in payload:
            user = review.get("user") or {}
            login = user.get("login") or ""
            if not login:
                continue
            if author and login.lower() == author.lower():
                continue
            seen.add(login)
    return sorted(seen)


def fetch_day(
    day_text, scope_query, guard, database, path, lock, pr_bar
):
    """Fetch one day; raise on any failure."""
    after = None
    while True:
        query = search_query_text(scope_query, day_text, after)
        data = run_graphql(query, guard)
        search = data.get("search") or {}
        nodes = search.get("nodes") or []
        advance_capped(pr_bar, len(nodes), lock)
        records = []
        for node in nodes:
            if node.get("__typename") != "PullRequest":
                continue
            record, truncated = record_from_node(node)
            if truncated:
                record["reviewers"] = fetch_reviewer_list(
                    record["organization"],
                    record["repository"],
                    record["number"],
                    record["author"],
                )
            records.append(record)
        with lock:
            for record in records:
                database["pull_requests"][record_key(record)] = record
            save_database(path, database)
        page = search.get("pageInfo") or {}
        if not page.get("hasNextPage"):
            break
        after = page.get("endCursor")
        if not after:
            break
    with lock:
        database["days_fetched"][day_text] = True
        save_database(path, database)


def count_missing_days(missing_days, scope_query, guard):
    """Count merged PRs per day; raise on any failure."""
    counts = {}
    with click.progressbar(
        length=len(missing_days),
        label="Counting pull requests",
        show_pos=True,
        show_percent=True,
        file=sys.stderr,
    ) as count_bar:
        pool = concurrent.futures.ThreadPoolExecutor(
            max_workers=MAX_WORKERS
        )
        try:
            future_map = {}
            for day_text in missing_days:
                future = pool.submit(
                    count_day_prs, day_text, scope_query, guard
                )
                future_map[future] = day_text
            for future in concurrent.futures.as_completed(future_map):
                counts[future_map[future]] = future.result()
                count_bar.update(1)
        finally:
            pool.shutdown(wait=False, cancel_futures=True)
    return counts


def download_missing_days(
    missing_days, scope_query, guard, database, path, total
):
    """Fetch all missing days; raise on any failure."""
    lock = threading.Lock()
    with click.progressbar(
        length=max(total, 1),
        label="Downloading pull requests",
        show_pos=True,
        show_percent=True,
        file=sys.stderr,
    ) as pr_bar:
        pool = concurrent.futures.ThreadPoolExecutor(
            max_workers=MAX_WORKERS
        )
        try:
            jobs = []
            for day_text in missing_days:
                jobs.append(
                    pool.submit(
                        fetch_day,
                        day_text,
                        scope_query,
                        guard,
                        database,
                        path,
                        lock,
                        pr_bar,
                    )
                )
            for job in concurrent.futures.as_completed(jobs):
                job.result()
        finally:
            pool.shutdown(wait=False, cancel_futures=True)


def bump(counter, handle, amount=1):
    """Add the amount to the handle count in the counter."""
    if not handle:
        return
    counter[handle] = counter.get(handle, 0) + amount


def bump_nested(weekly, index, handle, repo, amount=1):
    """Add the amount to the handle and repo count."""
    if not handle or not repo:
        return
    repos = weekly[index].get(handle)
    if repos is None:
        repos = {}
        weekly[index][handle] = repos
    repos[repo] = repos.get(repo, 0) + amount


def summarize_period(weekly, week_count):
    """Sum the last week_count weeks into ranked totals."""
    totals = {}
    start = FETCH_WEEKS - week_count
    for index in range(start, FETCH_WEEKS):
        for handle, value in weekly[index].items():
            totals[handle] = totals.get(handle, 0) + value
    ranked = sorted(
        totals.items(),
        key=lambda item: (-item[1], item[0].lower()),
    )
    return totals, ranked


def weekly_values(weekly, handles, week_count):
    """Return week values for each handle in order."""
    start = FETCH_WEEKS - week_count
    series = {}
    for handle in handles:
        values = []
        for index in range(start, FETCH_WEEKS):
            values.append(weekly[index].get(handle, 0))
        series[handle] = values
    return series


def table_lines(ranked, limit, link_for):
    """Build table markup for the top handles."""
    rows = []
    rows.append("<table>")
    rows.append("<thead>")
    rows.append("<tr><th>Rank</th><th>Handle</th>")
    rows.append("<th>Count</th></tr>")
    rows.append("</thead>")
    rows.append("<tbody>")
    if not ranked:
        rows.append("<tr><td>-</td><td>None</td>")
        rows.append("<td>0</td></tr>")
    shown = ranked[:limit]
    for position, pair in enumerate(shown, 1):
        handle, value = pair
        safe_handle = html.escape(handle)
        target = link_for(handle)
        link = '<a href="' + target + '">' + safe_handle + "</a>"
        count = f"{value:,}"
        rows.append(
            "<tr><td>"
            + str(position)
            + "</td><td>"
            + link
            + "</td><td>"
            + count
            + "</td></tr>"
        )
    rows.append("</tbody>")
    rows.append("</table>")
    return rows


def table_repo_lines(ranked, limit):
    """Build table markup for the top repositories."""
    rows = []
    rows.append("<table>")
    rows.append("<thead>")
    rows.append("<tr><th>Rank</th><th>Repository</th>")
    rows.append("<th>Count</th></tr>")
    rows.append("</thead>")
    rows.append("<tbody>")
    if not ranked:
        rows.append("<tr><td>-</td><td>None</td>")
        rows.append("<td>0</td></tr>")
    shown = ranked[:limit]
    for position, pair in enumerate(shown, 1):
        repo, value = pair
        safe_repo = html.escape(repo)
        target = "https://github.com/" + repo
        link = '<a href="' + target + '">' + safe_repo + "</a>"
        count = f"{value:,}"
        rows.append(
            "<tr><td>"
            + str(position)
            + "</td><td>"
            + link
            + "</td><td>"
            + count
            + "</td></tr>"
        )
    rows.append("</tbody>")
    rows.append("</table>")
    return rows


def chart_block(chart_id, labels, series, unit):
    """Build a canvas plus Chart.js script for one metric."""
    sets = []
    for order, handle in enumerate(series):
        color = CHART_COLORS[order % len(CHART_COLORS)]
        sets.append(
            {
                "label": handle,
                "data": series[handle],
                "borderColor": color,
                "backgroundColor": color,
                "borderWidth": 2,
                "pointRadius": 2,
                "tension": 0.3,
                "fill": False,
            }
        )
    config = {
        "type": "line",
        "data": {"labels": labels, "datasets": sets},
        "options": {
            "responsive": True,
            "interaction": {
                "mode": "nearest",
                "axis": "x",
                "intersect": False,
            },
            "plugins": {
                "legend": {
                    "position": "bottom",
                    "labels": {"boxWidth": 12},
                }
            },
            "scales": {
                "y": {
                    "beginAtZero": True,
                    "title": {
                        "display": True,
                        "text": unit,
                    },
                },
                "x": {
                    "title": {
                        "display": True,
                        "text": "Week starting",
                    },
                },
            },
        },
    }
    block = []
    block.append('<canvas id="' + chart_id + '"></canvas>')
    get_element = "document.getElementById('" + chart_id + "')"
    create = "window.__drCharts = window.__drCharts || {};"
    create += "window.__drCharts['" + chart_id + "'] = new Chart("
    create += get_element + ", " + json.dumps(config) + ");"
    block.append("<script>")
    block.append(create)
    block.append("</script>")
    return block


